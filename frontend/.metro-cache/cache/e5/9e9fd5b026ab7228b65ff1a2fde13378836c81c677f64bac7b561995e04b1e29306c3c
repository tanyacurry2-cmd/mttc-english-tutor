rophe\",\r\n      \"address\"\r\n    ],\r\n    \"mode\": \"Learn\",\r\n    \"type\": \"flashcard\",\r\n    \"options\": []\r\n  },\r\n  {\r\n    \"id\": \"F320\",\r\n    \"subarea\": \"Genre & Craft\",\r\n    \"subareaId\": \"SA-3\",\r\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\r\n    \"question\": \"What is Synecdoche?\",\r\n    \"answer\": \"Using a part to represent the whole\",\r\n    \"explanation\": \"Synecdoche uses a part to represent the whole or vice versa. Example: 'All hands on deck' (hands = sailors). Creates compact, vivid language.\",\r\n    \"difficulty\": 2,\r\n    \"tags\": [\r\n      \"figurative\",\r\n      \"synecdoche\",\r\n      \"substitution\"\r\n    ],\r\n    \"mode\": \"Learn\",\r\n    \"type\": \"flashcard\",\r\n    \"options\": []\r\n  },\r\n  {\r\n    \"id\": \"F321\",\r\n    \"subarea\": \"Genre & Craft\",\r\n    \"subareaId\": \"SA-3\",\r\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\r\n    \"question\": \"What is Metonymy?\",\r\n    \"answer\": \"Substituting an associated word for the thing itself\",\r\n    \"explanation\": \"Metonymy replaces something with a word closely associated with it. Example: 'The crown' for monarchy, 'The White House' for the President. Creates efficient reference.\",\r\n    \"difficulty\": 2,\r\n    \"tags\": [\r\n      \"figurative\",\r\n      \"metonymy\",\r\n      \"substitution\"\r\n    ],\r\n    \"mode\": \"Learn\",\r\n    \"type\": \"flashcard\",\r\n    \"options\": []\r\n  },\r\n  {\r\n    \"id\": \"F322\",\r\n    \"subarea\": \"Genre & Craft\",\r\n    \"subareaId\": \"SA-3\",\r\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\r\n    \"question\": \"What is Irony?\",\r\n    \"answer\": \"Contrast between expectation and reality\",\r\n    \"explanation\": \"Irony occurs when there's a discrepancy between appearance and reality, expectation and outcome. Types include verbal, situational, and dramatic irony. Creates layers of meaning.\",\r\n    