swer\": \"Colonial contact introduced loanwords from Hindi, Arabic, Swahili, and other languages\",\r\n    \"explanation\": \"Global expansion gave English words like 'bungalow' (Hindi), 'algebra' (Arabic), and 'safari' (Swahili), demonstrating English's ability to absorb vocabulary from worldwide contact.\",\r\n    \"difficulty\": 2,\r\n    \"tags\": [\r\n      \"colonialism\",\r\n      \"loanwords\",\r\n      \"global English\"\r\n    ],\r\n    \"mode\": \"Learn\",\r\n    \"type\": \"flashcard\",\r\n    \"options\": []\r\n  },\r\n  {\r\n    \"id\": \"F633\",\r\n    \"subarea\": \"Meaning & Communication\",\r\n    \"subareaId\": \"SA-1\",\r\n    \"objective\": \"History and development of the English language\",\r\n    \"question\": \"What caused the divergence of British and American English spelling?\",\r\n    \"answer\": \"Noah Webster's dictionary reforms\",\r\n    \"explanation\": \"Webster intentionally simplified spellings—'color' vs. 'colour,' 'center' vs. 'centre'—to promote linguistic independence in the new American nation.\",\r\n    \"difficulty\": 2,\r\n    \"tags\": [\r\n      \"American English\",\r\n      \"Webster\",\r\n      \"spelling reform\"\r\n    ],\r\n    \"mode\": \"Learn\",\r\n    \"type\": \"flashcard\",\r\n    \"options\": []\r\n  },\r\n  {\r\n    \"id\": \"F634\",\r\n    \"subarea\": \"Meaning & Communication\",\r\n    \"subareaId\": \"SA-1\",\r\n    \"objective\": \"History and development of the English language\",\r\n    \"question\": \"What caused rapid vocabulary expansion in the 20th century?\",\r\n    \"answer\": \"Technological and scientific innovation\",\r\n    \"explanation\": \"Modern inventions created terms like 'television,' 'internet,' 'genetic code,' and 'smartphone.' Science and technology drive the most rapid vocabulary growth in contemporary English.\",\r\n    \"difficulty\": 2,\r\n    \"tags\": [\r\n      \"20th century\",\r\n      \"technology\",\r\n      \"vocabulary\"\r\n    ],\r\n    \"mode\": \"Learn\",\r\n    