ficulty\": 2\r\n  },\r\n  {\r\n    \"id\": \"Q622\",\r\n    \"subarea\": \"Skills & Processes\",\r\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\r\n    \"stem\": \"Analyzing how a chart supports textual information demonstrates:\",\r\n    \"options\": [\"Visual interpretation\", \"Metaphorical reading\", \"Syntax comprehension\", \"Summative reasoning\"],\r\n    \"correctIndex\": 0,\r\n    \"rationales\": [\r\n      \"Correct! Visual interpretation extracts meaning from visual data representations like charts.\",\r\n      \"Metaphorical reading interprets figurative language, not charts.\",\r\n      \"Syntax comprehension analyzes sentence structure, not visual data.\",\r\n      \"Summative reasoning synthesizes ideas but isn't specific to visual data.\"\r\n    ],\r\n    \"difficulty\": 2\r\n  },\r\n  {\r\n    \"id\": \"Q623\",\r\n    \"subarea\": \"Skills & Processes\",\r\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\r\n    \"stem\": \"When evaluating a website, which criterion is LEAST useful?\",\r\n    \"options\": [\"Design aesthetics\", \"Author's credentials\", \"Date of publication\", \"Evidence citations\"],\r\n    \"correctIndex\": 0,\r\n    \"rationales\": [\r\n      \"Correct! While design matters for usability, aesthetics don't determine credibility or accuracy.\",\r\n      \"Author credentials indicate expertise and credibility—essential.\",\r\n      \"Publication date shows currency—important for time-sensitive topics.\",\r\n      \"Evidence citations demonstrate research quality—essential.\"\r\n    ],\r\n    \"difficulty\": 2\r\n  },\r\n  {\r\n    \"id\": \"Q624\",\r\n    \"subarea\": \"Skills & Processes\",\r\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\r\n    \"stem\": \"The purpose of a public service announcement is primarily to:\",\r\n    \"options\": [\"Entertain\", \"Inform or persuade\", \"Amuse\", \"Narrate\"],\r\n    \"correctIndex\": 1,\r\n    \"rationales\": [\r\n      \"PSAs can engage but entertainment isn't the primary purpose.\",\r\n      \"Correct! PSAs inform audiences about issues and/or persuade them toward action or behavior change.\",\r\n      \"Amusement may be a technique but not the goal.\",\r\n      \"Narration is a method, not a purpose.\"\r\n    ],\r\n    \"difficulty\": 1\r\n  },\r\n  {\r\n    \"id\": \"Q625\",\r\n    \"subarea\": \"Skills & Processes\",\r\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\r\n    \"stem\": \"A speaker using celebrity endorsements to influence an audience uses which propaganda technique?\",\r\n    \"options\": [\"Transfer\", \"Testimonial\", \"Plain folks\", \"Fear appeal\"],\r\n    \"correctIndex\": 1,\r\n    \"rationales\": [\r\n      \"Transfer associates with symbols/concepts, not specific endorsers.\",\r\n      \"Correct! Testimonial uses endorsements from individuals (especially celebrities) to build credibility.\",\r\n      \"Plain folks presents speaker as ordinary person, opposite of celebrity.\",\r\n      \"Fear appeal uses threats or warnings, not endorsements.\"\r\n    ],\r\n    \"difficulty\": 2\r\n  },\r\n  {\r\n    \"id\": \"Q626\",\r\n    \"subarea\": \"Skills & Processes\",\r\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\r\n    \"stem\": \"Recognizing that film uses close-up shots to create empathy demonstrates:\",\r\n    \"options\": [\"Critical media analysis\", \"Visual confusion\", \"Phonemic awareness\", \"Literal comprehension\"],\r\n    \"correctIndex\": 0,\r\n    \"rationales\": [\r\n      \"Correct! Critical media analysis examines how technical choices (like shot selection) shape meaning and emotion.\",\r\n      \"This shows understanding, not confusion.\",\r\n      \"Phonemic awareness involves sound manipulation, not film analysis.\",\r\n      \"Literal comprehension understands surface meaning, not analyzes technique.\"\r\n    ],\r\n    \"difficulty\": 2\r\n  },\r\n  {\r\n    \"id\": \"Q627\",\r\n    \"subarea\": \"Skills & Processes\",\r\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\r\n    \"stem\": \"Identifying how background music intensifies a news segment's emotional tone analyzes:\",\r\n    \"options\": [\"Nonverbal cues in media\", \"Logical appeals\", \"Morphological structure\", \"Syntax\"],\r\n    \"correctIndex\": 0,\r\n    \"rationales\": [\r\n      \"Correct! Nonverbal cues in media include music, sound effects, and visuals that shape emotional response.\",\r\n      \"Logical appeals use reasoning, not music.\",\r\n      \"Morphological structure relates to word formation, not media.\",\r\n      \"Syntax is sentence structure, not media production.\"\r\n    ],\r\n    \"difficulty\": 2\r\n  },\r\n  {\r\n    \"id\": \"Q628\",\r\n    \"subarea\": \"Meaning & Communication\",\r\n    \"objective\": \"Understand the integrated nature of the English language arts\",\r\n    \"stem\": \"A middle school teacher has students read excerpts from a famous speech before writing their own persuasive paragraphs on a modern topic. To strengthen the connection between reading and writing, the teacher asks students to analyze the rhetorical techniques used in the speech before they draft their own work. The primary benefit of this activity is that it helps students:\",\r\n    \"options\": [\r\n      \"memorize formal patterns of written and spoken argument.\",\r\n      \"transfer comprehension strategies from reading into composition.\",\r\n      \"imitate the stylistic conventions of historical texts.\",\r\n      \"focus on correct spelling and punctuation while writing.\"\r\n    ],\r\n    \"correctIndex\": 1,\r\n    \"rationales\": [\r\n      \"Memorization is not the focus; understanding and application of rhetorical techniques is the goal.\",\r\n      \"Correct! Students are connecting analytical reading (how rhetoric works) with their own writing decisions—an integrated literacy practice.\",\r\n      \"Imitation is not the main goal; transferring analytical skills to composition is the focus.\",\r\n      \"Spelling and punctuation are not the primary focus of analyzing rhetorical techniques.\"\r\n    ],\r\n    \"difficulty\": 2\r\n  },\r\n  {\r\n    \"id\": \"Q629\",\r\n    \"subarea\": \"Meaning & Communication\",\r\n    \"objective\": \"Understand the integrated nature of the English language arts\",\r\n    \"stem\": \"After studying short stories with strong character development, students are asked to perform short dramatic readings of key scenes before writing a reflective essay about character motivation. The main advantage of this sequence is that it enables students to:\",\r\n    \"options\": [\r\n      \"compare film and literature as forms of storytelling.\",\r\n      \"understand narrative pacing through silent reading.\",\r\n      \"internalize literary characterization through expressive performance.\",\r\n      \"demonstrate memorization skills for key literary passages.\"\r\n    ],\r\n    \"correctIndex\": 2,\r\n    \"rationales\": [\r\n      \"Film comparison is not part of this activity; the focus is on dramatic reading and writing.\",\r\n      \"Silent reading is not the method used here; students are performing aloud.\",\r\n      \"Correct! Oral interpretation deepens comprehension and helps students feel how language shapes character and tone.\",\r\n      \"Memorization is not the goal; understanding character motivation through performance is the focus.\"\r\n    ],\r\n    \"difficulty\": 2\r\n  },\r\n  {\r\n    \"id\": \"Q630\",\r\n    \"subarea\": \"Meaning & Communication\",\r\n    \"objective\": \"Understand the integrated nature of the English language 