   \"id\": \"F013\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"question\": \"What's the difference between decoding and comprehension?\",\n    \"answer\": \"Decoding = print to sound; comprehension = making meaning\",\n    \"explanation\": \"Decoding translates printed text to sound, while comprehension involves creating meaning from that text through understanding and interpretation.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literacy\", \"decoding\", \"comprehension\"]\n  },\n  {\n    \"id\": \"F014\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"question\": \"Why is morphology important?\",\n    \"answer\": \"Helps infer word meaning through roots/prefixes/suffixes\",\n    \"explanation\": \"Understanding roots, prefixes, and suffixes supports vocabulary growth and allows readers to infer the meaning of unfamiliar words.\",\n    \"difficulty\": 3,\n    \"tags\": [\"literacy\", \"morphology\", \"vocabulary\"]\n  },\n  {\n    \"id\": \"F015\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"question\": \"How does syntax contribute to meaning?\",\n    \"answer\": \"Structure determines emphasis and clarity\",\n    \"explanation\": \"Sentence structure affects emphasis, tone, and clarity of information, influencing how readers interpret the text.\",\n    \"difficulty\": 3,\n    \"tags\": [\"literacy\", \"syntax\", \"grammar\"]\n  },\n  {\n    \"id\": \"F016\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"question\": \"What strategies help struggling readers?\",\n    \"answer\": \"Explicit phonics, guided reading, fluency modeling, vocabulary support\",\n    \"explanation\": \"Use explicit phonics instruction, guided reading sessions, modeled fluent reading, and vocabulary scaffolds to support struggling readers.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literacy\", \"intervention\", \"teaching-strategies\"]\n  },\n  {\n    \"id\": \"F017\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"question\": \"What is metacognition?\",\n    \"answer\": \"Awareness and regulation of one's own thinking\",\n    \"explanation\": \"Thinking about one's own thinking—monitoring and adjusting comprehension strategies while reading.\",\n    \"difficulty\": 3,\n    \"tags\": [\"literacy\", \"metacognition\", \"comprehension\"]\n  },\n  {\n    \"id\": \"F018\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"question\": \"Why is background knowledge essential?\",\n    \"answer\": \"Enables connection and deeper understanding\",\n    \"explanation\": \"Prior knowledge connects new information to existing understanding, providing context and aiding comprehension.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literacy\", \"schema\", \"comprehension\"]\n  },\n  {\n    \"id\": \"F019\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"question\": \"What's the role of assessment?\",\n    \"answer\": \"Diagnose needs, guide instruction, measure growth\",\n    \"explanation\": \"Assessment identifies student strengths and needs, guiding targeted interventions and measuring progress over time.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literacy\", \"assessment\", \"evaluation\"]\n  },\n  {\n    \"id\": \"F020\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Functions in Context\",\n    \"question\": \"What does 'language register' mean?\",\n    \"answer\": \"The level of formality or style used depending on context, audience, and purpose\",\n    \"explanation\": \"Language register refers to how speakers and writers adjust their language formality based on the social situation, audience, and communicative purpose.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communication\", \"register\", \"context\"]\n  },\n  {\n    \"id\": \"F021\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Functions in Context\",\n    \"question\": \"What is 'code-switching'?\",\n    \"answer\": \"Shifting between language varieties or dialects based on audience or situation\",\n    \"explanation\": \"Code-switching demonstrates linguistic flexibility, allowing speakers to adapt their language to different social contexts and audiences.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communication\", \"code-switching\", \"sociolinguistics\"]\n  },\n  {\n    \"id\": \"F022\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Functions in Context\",\n    \"question\": \"What are pragmatics?\",\n    \"answer\": \"The study of how context influences meaning in communication\",\n    \"explanation\": \"Pragmatics examines how situational context, speaker intent, and social relationships affect the interpretation of language.\",\n    \"difficulty\": 3,\n    \"tags\": [\"communication\", \"pragmatics\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F023\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Functions in Context\",\n    \"question\": \"What is connotation?\",\n    \"answer\": \"The emotional or cultural associations attached to a word beyond its literal meaning\",\n    \"explanation\": \"Connotation adds layers of meaning to words, reflecting cultural values, emotions, and social attitudes beyond dictionary definitions.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communication\", \"connotation\", \"semantics\"]\n  },\n  {\n    \"id\": \"F024\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Functions in Context\",\n    \"question\": \"What's the difference between denotation and connotation?\",\n    \"answer\": \"Denotation is literal meaning; connotation adds emotional or cultural nuance\",\n    \"explanation\": \"Denotation provides the dictionary definition, while connotation includes the feelings, associations, and cultural meanings attached to words.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communication\", \"denotation\", \"connotation\"]\n  },\n  {\n    \"id\": \"F025\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Effective Communication\",\n    \"question\": \"What are the main components of communication?\",\n    \"answer\": \"Sender, message, medium, receiver, feedback, and context\",\n    \"explanation\": \"Effective communication requires all six components working together: someone sending a message through a medium to a receiver, with feedback occurring within a specific context.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communication\", \"components\", \"process\"]\n  },\n  {\n    \"id\": \"F026\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Effective Communication\",\n    \"question\": \"What makes communication effective?\",\n    \"answer\": \"Clarity, conciseness, coherence, and audience awareness\",\n    \"explanation\": \"Effective communication requires clear expression, brevity without sacrificing meaning, logical organization, and adaptation to the audience's needs and knowledge.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communication\", \"effectiveness\", \"principles\"]\n  },\n  {\n    \"id\": \"F027\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Effective Communication\",\n    \"question\": \"What is tone in communication?\",\n    \"answer\": \"The speaker's attitude toward the subject or audience\",\n    \"explanation\": \"Tone conveys the speaker's feelings, perspective, and relationship to both the topic and the audience through word choice, syntax, and delivery.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communication\", \"tone\", \"attitude\"]\n  },\n  {\n    \"id\": \"F028\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Effective Communication\",\n    \"question\": \"What does active listening involve?\",\n    \"answer\": \"Engaging with, reflecting, and responding thoughtfully to a speaker\",\n    \"explanation\": \"Active listening requires full attention, understanding the speaker's message, providing feedback, and responding in ways that demonstrate comprehension.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communication\", \"listening\", \"engagement\"]\n  },\n  {\n    \"id\": \"F029\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Effective Communication\",\n    \"question\": \"Why is nonverbal communication important?\",\n    \"answer\": \"It reinforces or contradicts spoken messages, adding depth to meaning\",\n    \"explanation\": \"Nonverbal cues like body language, facial expressions, and tone of voice can support, emphasize, or even contradict verbal communication, providing additional context.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communication\", \"nonverbal\", \"body-language\"]\n  },\n  {\n    \"id\": \"F030\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Elements and Devices\",\n    \"question\": \"What are common elements of fiction?\",\n    \"answer\": \"Plot, character, setting, theme, and conflict\",\n    \"explanation\": \"These five essential elements work together to create a complete fictional narrative, each contributing to the story's meaning and impact.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"fiction\", \"elements\"]\n  },\n  {\n    \"id\": \"F031\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Elements and Devices\",\n    \"question\": \"What is symbolism?\",\n    \"answer\": \"The use of objects or actions to represent deeper meanings\",\n    \"explanation\": \"Symbolism allows authors to convey complex ideas and themes through concrete images, adding layers of meaning to their work.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"symbolism\", \"devices\"]\n  },\n  {\n    \"id\": \"F032\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Elements and Devices\",\n    \"question\": \"What is irony?\",\n    \"answer\": \"A contrast between appearance and reality, expectation and outcome\",\n    \"explanation\": \"Irony creates meaning through contradiction, whether between what's said and meant (verbal), expected and actual (situational), or known by the audience versus characters (dramatic).\",\n    \"difficulty\": 3,\n    \"tags\": [\"literature\", \"irony\", \"devices\"]\n  },\n  {\n    \"id\": \"F033\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Elements and Devices\",\n    \"question\": \"What is point of view?\",\n    \"answer\": \"The perspective from which a story is told (first, second, third person)\",\n    \"explanation\": \"Point of view determines whose eyes the reader sees through, affecting what information is revealed and how the story is interpreted.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"point-of-view\", \"perspective\"]\n  },\n  {\n    \"id\": \"F034\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Elements and Devices\",\n    \"question\": \"What is theme?\",\n    \"answer\": \"The central idea or message underlying a literary work\",\n    \"explanation\": \"Theme represents the universal truth or insight about life that the author explores through characters, plot, and other literary elements.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"theme\", \"meaning\"]\n  },\n  {\n    \"id\": \"F035\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Writing Techniques\",\n    \"question\": \"What is diction?\",\n    \"answer\": \"The author's choice of words to create tone and meaning\",\n    \"explanation\": \"Diction encompasses vocabulary selection, including formal versus informal language, concrete versus abstract words, and the level of complexity chosen 