ty\": 2,\n    \"tags\": [\"writing\", \"tone\", \"attitude\"]\n  },\n  {\n    \"id\": \"F040\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is theme in literature?\",\n    \"answer\": \"The central idea or universal truth in a literary work\",\n    \"explanation\": \"Theme is the underlying message or insight about life that the author explores through all elements of the story.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"theme\", \"meaning\"]\n  },\n  {\n    \"id\": \"F041\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What's the difference between plot and theme?\",\n    \"answer\": \"Plot is what happens; theme is what it means\",\n    \"explanation\": \"Plot provides the sequence of events, while theme reveals the deeper significance or message behind those events.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"plot\", \"theme\"]\n  },\n  {\n    \"id\": \"F042\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is characterization?\",\n    \"answer\": \"How an author develops a character through actions, dialogue, and description\",\n    \"explanation\": \"Characterization can be direct (telling) or indirect (showing through behavior, speech, thoughts, and interactions).\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"characterization\", \"character\"]\n  },\n  {\n    \"id\": \"F043\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is point of view in literature?\",\n    \"answer\": \"The perspective from which a story is told (first, second, or third person)\",\n    \"explanation\": \"Point of view determines what information readers access and how they experience the story's events.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"point-of-view\", \"narration\"]\n  },\n  {\n    \"id\": \"F044\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is a motif?\",\n    \"answer\": \"A recurring symbol, image, or idea that reinforces theme\",\n    \"explanation\": \"Motifs appear repeatedly throughout a work, creating patterns of meaning that support and develop the central theme.\",\n    \"difficulty\": 3,\n    \"tags\": [\"literature\", \"motif\", \"symbolism\"]\n  },\n  {\n    \"id\": \"F045\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is tone in literature?\",\n    \"answer\": \"The author's attitude toward the subject or audience\",\n    \"explanation\": \"Tone is conveyed through word choice, sentence structure, and stylistic decisions that reveal the author's perspective.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"tone\", \"attitude\"]\n  },\n  {\n    \"id\": \"F046\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is mood in literature?\",\n    \"answer\": \"The emotional atmosphere experienced by the reader\",\n    \"explanation\": \"Mood is the feeling created in the reader through setting, imagery, and language choices.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"mood\", \"atmosphere\"]\n  },\n  {\n    \"id\": \"F047\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is imagery?\",\n    \"answer\": \"Descriptive language appealing to the five senses\",\n    \"explanation\": \"Imagery creates vivid mental pictures and sensory experiences through language that engages sight, sound, touch, taste, and smell.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"imagery\", \"sensory\"]\n  },\n  {\n    \"id\": \"F048\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is an allegory?\",\n    \"answer\": \"A story with both literal and symbolic meaning\",\n    \"explanation\": \"In allegory, characters, events, and settings represent abstract ideas or moral qualities, creating dual levels of meaning.\",\n    \"difficulty\": 3,\n    \"tags\": [\"literature\", \"allegory\", \"symbolism\"]\n  },\n  {\n    \"id\": \"F049\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is foreshadowing?\",\n    \"answer\": \"Clues or hints about what will happen later in the story\",\n    \"explanation\": \"Foreshadowing creates anticipation and suspense while preparing readers for future plot developments.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"foreshadowing\", \"technique\"]\n  },\n  {\n    \"id\": \"F050\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is conflict in literature?\",\n    \"answer\": \"The struggle between opposing forces that drives the plot and reveals character growth\",\n    \"explanation\": \"Conflict can be internal (within a character) or external (between characters, or character vs. nature/society), and provides the story's central tension.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"conflict\", \"plot\"]\n  },\n  {\n    \"id\": \"F051\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is diction in literature?\",\n    \"answer\": \"Word choice used to create tone and meaning\",\n    \"explanation\": \"Diction includes the level of formality, connotation, and precision of words selected to achieve specific effects.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"diction\", \"word-choice\"]\n  },\n  {\n    \"id\": \"F052\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is irony in literature?\",\n    \"answer\": \"A contrast between appearance and reality, or expectation and outcome\",\n    \"explanation\": \"Irony includes verbal (saying the opposite of what's meant), situational (unexpected outcomes), and dramatic (audience knows more than characters).\",\n    \"difficulty\": 3,\n    \"tags\": [\"literature\", \"irony\", \"technique\"]\n  },\n  {\n    \"id\": \"F053\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is symbolism in literature?\",\n    \"answer\": \"Using objects or events to represent abstract ideas\",\n    \"explanation\": \"Symbols carry meaning beyond their literal significance, adding depth and layers of interpretation to the text.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"symbolism\", \"meaning\"]\n  },\n  {\n    \"id\": \"F054\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is phonological awareness?\",\n    \"answer\": \"Recognizing and manipulating sounds in spoken language, including rhyme and syllables\",\n    \"explanation\": \"Phonological awareness is a foundational literacy skill that includes identifying and working with sounds at the word, syllable, and phoneme levels.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literacy\", \"phonological-awareness\", \"reading\"]\n  },\n  {\n    \"id\": \"F055\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What's the difference between formative and summative assessment?\",\n    \"answer\": \"Formative happens during learning to guide instruction; summative measures learning at the end\",\n    \"explanation\": \"Formative assessments inform ongoing teaching decisions, while summative assessments evaluate overall achievement after instruction concludes.\",\n    \"difficulty\": 2,\n    \"tags\": [\"assessment\", \"formative\", \"summative\"]\n  },\n  {\n    \"id\": \"F056\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What are rubrics used for?\",\n    \"answer\": \"Define expectations and scoring criteria for consistent grading\",\n    \"explanation\": \"Rubrics provide clear standards and descriptions of performance levels, ensuring fair and transparent evaluation.\",\n    \"difficulty\": 2,\n    \"tags\": [\"assessment\", \"rubrics\", \"evaluation\"]\n  },\n  {\n    \"id\": \"F057\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is scaffolding in education?\",\n    \"answer\": \"Providing temporary support to help students master new skills independently\",\n    \"explanation\": \"Scaffolding gradually releases responsibility to students as they develop competence, like training wheels on a bicycle.\",\n    \"difficulty\": 2,\n    \"tags\": [\"instruction\", \"scaffolding\", \"support\"]\n  },\n  {\n    \"id\": \"F058\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What are reading conferences?\",\n    \"answer\": \"Discussing a student's progress, reading habits, and comprehension strategies\",\n    \"explanation\": \"Reading conferences provide individualized opportunities to assess understanding, set goals, and provide targeted support.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literacy\", \"conferences\", \"assessment\"]\n  },\n  {\n    \"id\": \"F059\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is fluency in reading?\",\n    \"answer\": \"Reading with accuracy, rate, and expression\",\n    \"explanation\": \"Fluency bridges decoding and comprehension, allowing readers to focus on meaning rather than word-by-word processing.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literacy\", \"fluency\", \"reading\"]\n  },\n  {\n    \"id\": \"F060\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is metacognition in learning?\",\n    \"answer\": \"Thinking about one's own thinking—planning, monitoring, and evaluating understanding\",\n    \"explanation\": \"Metacognition enables students to become self-aware, strategic learners who can adjust their approaches when needed.\",\n    \"difficulty\": 3,\n    \"tags\": [\"learning\", \"metacognition\", \"thinking\"]\n  },\n  {\n    \"id\": \"F061\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is peer review?\",\n    \"answer\": \"Students giving constructive feedback on each other's writing\",\n    \"explanation\": \"Peer review develops critical reading skills and helps writers see their work from a reader's perspective.\",\n    \"difficulty\": 2,\n    \"tags\": [\"writing\", \"peer-review\", \"feedback\"]\n  },\n  {\n    \"id\": \"F062\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What are the stages of the writing process?\",\n    \"answer\": \"Prewriting, drafting, revising, editing, and publishing\",\n    \"explanation\": \"The writing process is recursive, with writers moving between stages as they develop and refine their work.\",\n    \"difficulty\": 2,\n    \"tags\": [\"writing\", \"process\", \"stages\"]\n  },\n  {\n    \"id\": \"F063\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is differentiated instruction?\",\n    \"answer\": \"Adjusting teaching methods to meet diverse student needs\",\n    \"explanation\": \"Differentiation involves varying content, process, product, or learning environment based on student readiness, interests, and learning profiles.\",\n    \"difficulty\": 2,\n    \"tags\": [\"instruction\", \"differentiation\", \"teaching\"]\n  }\n  ,\n  {\n    \"id\": \"F301\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Alliteration?\",\n    \"answer\": \"Repetition of initial consonant sounds\",\n    \"explanation\": \"Alliteration is the repetition of initial consonant sounds in neighboring words. Example: 'Peter Piper picked a peck of pickled peppers.' It creates rhythm and emphasizes certain words.\",\n    \"difficulty\": 1,\n    \"tags\": [\"rhetoric\", \"sound\", \"alliteration\"]\n  },\n  {\n    \"id\": \"F302\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Assonance?\",\n    \"answer\": \"Repetition of vowel sounds within words\",\n    \"explanation\": \"Assonance is the repetition of vowel sounds within words. Example: 'The rain in Spain falls mainly on the plain.' It creates internal rhyme and musicality.\",\n    \"difficulty\": 1,\n    \"tags\": [\"rhetoric\", \"sound\", \"assonance\"]\n  },\n  {\n    \"id\": \"F303\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Consonance?\",\n    \"answer\": \"Repetition of consonant sounds at the end or middle of words\",\n    \"explanation\": \"Consonance is the repetition of consonant sounds at the end or middle of words, creating a pleasing auditory effect. Example: 'blank and think.'\",\n    \"difficulty\": 1,\n    \"tags\": [\"rhetoric\", \"sound\", \"consonance\"]\n  },\n  {\n    \"id\": \"F304\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Anaphora?\",\n    \"answer\": \"Repetition of a word or phrase at the beginning of successive clauses\",\n    \"explanation\": \"Anaphora is a rhetorical device where words are repeated at the beginning of successive clauses for emphasis. Example: MLK's 'I have a dream' speech repeatedly uses this phrase.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"repetition\", \"anaphora\"]\n  },\n  {\n    \"id\": \"F305\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Epistrophe?\",\n    \"answer\": \"Repetition of words at the end of successive clauses\",\n    \"explanation\": \"Epistrophe repeats words at the end of successive clauses or sentences for rhetorical effect. Example: 'government of the people, by the people, for the people.'\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"repetition\", \"epistrophe\"]\n  },\n  {\n    \"id\": \"F306\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Parallelism?\",\n    \"answer\": \"Using similar grammatical structures in a series for rhythm and balance\",\n    \"explanation\": \"Parallelism uses similar grammatical structures to create balance, rhythm, and emphasis. Example: 'I came, I saw, I conquered.' It makes writing more memorable and persuasive.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"structure\", \"parallelism\"]\n  },\n  {\n    \"id\": \"F307\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Antithesis?\",\n    \"answer\": \"Juxtaposition of contrasting ideas in balanced phrases\",\n    \"explanation\": \"Antithesis places contrasting ideas in parallel structures to emphasize opposition. Example: 'It was the best of times, it was the worst of times.' Creates dramatic contrast.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"contrast\", \"antithesis\"]\n  },\n  {\n    \"id\": \"F308\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Chiasmus?\",\n    \"answer\": \"Inverted parallelism\",\n    \"explanation\": \"Chiasmus reverses the structure of parallel phrases for memorable effect. Example: JFK's 'Ask not what your country can do for you—ask what you can do for your country.'\",\n    \"difficulty\": 3,\n    \"tags\": [\"rhetoric\", \"structure\", \"chiasmus\"]\n  },\n  {\n    \"id\": \"F309\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is a Metaphor?\",\n    \"answer\": \"Direct comparison between two unlike things without 'like' or 'as'\",\n    \"explanation\": \"A metaphor makes a direct comparison between two unlike things to create vivid imagery. Example: 'Time is a thief.' It implies shared qualities without explicit comparison words.\",\n    \"difficulty\": 1,\n    \"tags\": [\"figurative\", \"metaphor\", \"comparison\"]\n  },\n  {\n    \"id\": \"F310\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is a Simile?\",\n    \"answer\": \"Comparison using 'like' or 'as'\",\n    \"explanation\": \"A simile explicitly compares two unlike things using 'like' or 'as.' Example: 'Her eyes sparkled like diamonds.' Creates vivid imagery through direct comparison.\",\n    \"difficulty\": 1,\n    \"tags\": [\"figurative\", \"simile\", \"comparison\"]\n  },\n  {\n    \"id\": \"F311\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Personification?\",\n    \"answer\": \"Giving human qualities to non-human things\",\n    \"explanation\": \"Personification attributes human characteristics to animals, objects, or abstract concepts. Example: 'The wind whispered through the trees.' Makes writing more relatable and vivid.\",\n    \"difficulty\": 1,\n    \"tags\": [\"figurative\", \"personification\"]\n  },\n  {\n    \"id\": \"F312\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Hyperbole?\",\n    \"answer\": \"Deliberate exaggeration for emphasis or humor\",\n    \"explanation\": \"Hyperbole uses extreme exaggeration to emphasize a point or create humor. Example: 'I've told you a million times!' Not meant to be taken literally.\",\n    \"difficulty\": 1,\n    \"tags\": [\"figurative\", \"hyperbole\", \"exaggeration\"]\n  },\n  {\n    \"id\": \"F313\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Understatement?\",\n    \"answer\": \"Deliberately downplaying significance for irony\",\n    \"explanation\": \"Understatement minimizes the importance of something, often for ironic or humorous effect. Example: Calling a hurricane 'a bit of bad weather.' Creates subtle emphasis through minimization.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"understatement\", \"irony\"]\n  },\n  {\n    \"id\": \"F314\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is an Oxymoron?\",\n    \"answer\": \"Two contradictory words combined\",\n    \"explanation\": \"An oxymoron combines contradictory terms for rhetorical effect. Examples: 'bittersweet,' 'jumbo shrimp,' 'deafening silence.' Creates tension and emphasizes complexity.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"oxymoron\", \"contradiction\"]\n  },\n  {\n    \"id\": \"F315\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is a Paradox?\",\n    \"answer\": \"A statement that seems contradictory yet reveals truth\",\n    \"explanation\": \"A paradox presents an apparent contradiction that reveals deeper truth upon reflection. Example: 'The more you learn, the less you know.' Encourages critical thinking.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"paradox\", \"logic\"]\n  },\n  {\n    \"id\": \"F316\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is a Euphemism?\",\n    \"answer\": \"Mild term replacing a harsh one\",\n    \"explanation\": \"A euphemism substitutes a mild or indirect expression for something unpleasant or embarrassing. Example: 'passed away' instead of 'died.' Softens harsh realities.\",\n    \"difficulty\": 1,\n    \"tags\": [\"rhetoric\", \"euphemism\", \"diction\"]\n  },\n  {\n    \"id\": \"F317\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Litotes?\",\n    \"answer\": \"Affirmation through negation\",\n    \"explanation\": \"Litotes affirms something by denying its opposite. Example: 'not bad' means 'good.' Creates emphasis through understatement and irony.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"litotes\", \"irony\"]\n  },\n  {\n    \"id\": \"F318\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is a Rhetorical Question?\",\n    \"answer\": \"Question asked for effect, not an answer\",\n    \"explanation\": \"A rhetorical question is posed for persuasive effect rather than to elicit an answer. Example: 'Is the Pope Catholic?' Engages audience and emphasizes a point.\",\n    \"difficulty\": 1,\n    \"tags\": [\"rhetoric\", \"question\", \"persuasion\"]\n  },\n  {\n    \"id\": \"F319\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Apostrophe?\",\n    \"answer\": \"Addressing an absent person or abstract idea directly\",\n    \"explanation\": \"Apostrophe directly addresses someone absent or something non-human as if present. Example: 'O Death, where is thy sting?' Creates dramatic intensity.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"apostrophe\", \"address\"]\n  },\n  {\n    \"id\": \"F320\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Synecdoche?\",\n    \"answer\": \"Using a part to represent the whole\",\n    \"explanation\": \"Synecdoche uses a part to represent the whole or vice versa. Example: 'All hands on deck' (hands = sailors). Creates compact, vivid language.\",\n    \"difficulty\": 2,\n    \"tags\": [\"figurative\", \"synecdoche\", \"substitution\"]\n  },\n  {\n    \"id\": \"F321\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Metonymy?\",\n    \"answer\": \"Substituting an associated word for the thing itself\",\n    \"explanation\": \"Metonymy replaces something with a word closely associated with it. Example: 'The crown' for monarchy, 'The White House' for the President. Creates efficient reference.\",\n    \"difficulty\": 2,\n    \"tags\": [\"figurative\", \"metonymy\", \"substitution\"]\n  },\n  {\n    \"id\": \"F322\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Irony?\",\n    \"answer\": \"Contrast between expectation and reality\",\n    \"explanation\": \"Irony occurs when there's a discrepancy between appearance and reality, expectation and outcome. Types include verbal, situational, and dramatic irony. Creates layers of meaning.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"irony\", \"contrast\"]\n  },\n  {\n    \"id\": \"F323\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Juxtaposition?\",\n    \"answer\": \"Placing two elements side by side to emphasize contrast\",\n    \"explanation\": \"Juxtaposition places contrasting elements near each other to highlight differences. Example: placing love and hate scenes adjacent. Emphasizes through contrast.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"juxtaposition\", \"contrast\"]\n  },\n  {\n    \"id\": \"F324\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Tone?\",\n    \"answer\": \"Author's attitude toward the subject or audience\",\n    \"explanation\": \"Tone reflects the author's attitude, revealed through word choice, sentence structure, and details. Examples: formal, informal, ironic, optimistic. Shapes reader's response.\",\n    \"difficulty\": 1,\n    \"tags\": [\"craft\", \"tone\", \"style\"]\n  },\n  {\n    \"id\": \"F325\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Diction?\",\n    \"answer\": \"Writer's choice of words to create tone and meaning\",\n    \"explanation\": \"Diction refers to word choice and vocabulary level. It can be formal, informal, colloquial, or technical. Diction directly shapes tone, mood, and clarity.\",\n    \"difficulty\": 1,\n    \"tags\": [\"craft\", \"diction\", \"style\"]\n  }\n  ,\n  {\n    \"id\": \"F101\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Second Language Acquisition (SLA)?\",\n    \"answer\": \"The process by which individuals learn a language other than their native one\",\n    \"explanation\": \"Second Language Acquisition (SLA) refers to the systematic process through which people learn a language beyond their first/native language. It involves cognitive, social, and educational factors.\",\n    \"difficulty\": 2,\n    \"tags\": [\"SLA\", \"language\", \"acquisition\"]\n  },\n  {\n    \"id\": \"F102\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is the Input Hypothesis?\",\n    \"answer\": \"Krashen's idea that learners acquire language best when exposed to comprehensible input slightly above their current level (i+1)\",\n    \"explanation\": \"Stephen Krashen's Input Hypothesis suggests learners progress by receiving 'comprehensible input' that is just beyond their current competence level (i+1). This challenges them without overwhelming them.\",\n    \"difficulty\": 3,\n    \"tags\": [\"Krashen\", \"input\", \"hypothesis\", \"SLA\"]\n  },\n  {\n    \"id\": \"F103\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is the Affective Filter?\",\n    \"answer\": \"Krashen's concept that anxiety or low motivation can block language input from being acquired\",\n    \"explanation\": \"The Affective Filter is a metaphorical barrier: when learners are anxious, unmotivated, or lack confidence, they cannot process language input effectively. Lowering this filter enhances acquisition.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Krashen\", \"affective filter\", \"motivation\", \"anxiety\"]\n  },\n  {\n    \"id\": \"F104\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is the Natural Order Hypothesis?\",\n    \"answer\": \"Language structures are learned in a predictable sequence, not necessarily through formal instruction\",\n    \"explanation\": \"This hypothesis states that grammatical structures are acquired in a natural, predictable order regardless of explicit teaching. Learners follow similar developmental sequences.\",\n    \"difficulty\": 2,\n    \"tags\": [\"natural order\", \"grammar\", \"acquisition\", \"Krashen\"]\n  },\n  {\n    \"id\": \"F105\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Communicative Competence?\",\n    \"answer\": \"The ability to use language appropriately in social contexts, not just knowing grammar\",\n    \"explanation\": \"Communicative Competence goes beyond grammatical knowledge to include sociolinguistic, discourse, and strategic competence—knowing when, how, and why to use language in real situations.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communicative competence\", \"pragmatics\", \"social language\"]\n  },\n  {\n    \"id\": \"F106\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Scaffolding in language learning?\",\n    \"answer\": \"Temporary instructional support helping students reach higher levels of understanding\",\n    \"explanation\": \"Scaffolding provides structured support (e.g., sentence frames, graphic organizers, modeling) that helps learners perform tasks they couldn't do independently, gradually removing support as competence grows.\",\n    \"difficulty\": 1,\n    \"tags\": [\"scaffolding\", \"support\", \"instruction\", \"Vygotsky\"]\n  },\n  {\n    \"id\": \"F107\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Modeling in language instruction?\",\n    \"answer\": \"Demonstrating correct language use before expecting students to use it independently\",\n    \"explanation\": \"Modeling involves the teacher showing students how to perform a language task (e.g., pronouncing words, structuring sentences) so students have a clear example to follow.\",\n    \"difficulty\": 1,\n    \"tags\": [\"modeling\", \"demonstration\", \"instruction\"]\n  },\n  {\n    \"id\": \"F108\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Total Physical Response (TPR)?\",\n    \"answer\": \"Teaching method pairing language input with physical movement to aid comprehension\",\n    \"explanation\": \"TPR, developed by James Asher, uses physical actions to reinforce language meaning. For example, students perform actions (stand, sit, jump) as the teacher gives commands, enhancing comprehension through kinesthetic learning.\",\n    \"difficulty\": 2,\n    \"tags\": [\"TPR\", \"movement\", \"comprehension\", \"teaching method\"]\n  },\n  {\n    \"id\": \"F109\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Wait Time in language teaching?\",\n    \"answer\": \"Pausing after asking a question so language learners can process and formulate a response\",\n    \"explanation\": \"Wait Time (typically 3-5 seconds) gives ELLs and all students time to think, translate internally if needed, and construct responses, leading to more thoughtful and accurate answers.\",\n    \"difficulty\": 1,\n    \"tags\": [\"wait time\", \"questioning\", \"ELL\", \"strategy\"]\n  },\n  {\n    \"id\": \"F110\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What are BICS and CALP?\",\n    \"answer\": \"Basic Interpersonal Communication Skills (social) vs. Cognitive Academic Language Proficiency (academic)\",\n    \"explanation\": \"BICS refers to everyday conversational language (1-2 years to develop), while CALP is the academic language needed for school success (5-7 years). Teachers must support both.\",\n    \"difficulty\": 2,\n    \"tags\": [\"BICS\", \"CALP\", \"Cummins\", \"academic language\"]\n  },\n  {\n    \"id\": \"F111\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Code-Switching?\",\n    \"answer\": \"Alternating between languages or dialects depending on context or audience\",\n    \"explanation\": \"Code-Switching is a natural linguistic practice where bilingual speakers shift between languages within conversations, often to express identity, clarify meaning, or match social contexts.\",\n    \"difficulty\": 2,\n    \"tags\": [\"code-switching\", \"bilingualism\", \"sociolinguistics\"]\n  },\n  {\n    \"id\": \"F112\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Language Transfer?\",\n    \"answer\": \"Influence of a learner's first language on learning a second language\",\n    \"explanation\": \"Language Transfer occurs when features of a learner's native language (phonology, syntax, vocabulary) affect how they produce or understand the target language. It can be positive or negative.\",\n    \"difficulty\": 2,\n    \"tags\": [\"transfer\", \"L1\", \"L2\", \"interference\"]\n  },\n  {\n    \"id\": \"F113\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What are Cognates?\",\n    \"answer\": \"Words in two languages with similar meaning and form\",\n    \"explanation\": \"Cognates are words that share common etymological roots across languages, like 'information' (English) and 'información' (Spanish). They help ELLs make connections and build vocabulary.\",\n    \"difficulty\": 1,\n    \"tags\": [\"cognates\", \"vocabulary\", \"Spanish\", \"transfer\"]\n  },\n  {\n    \"id\": \"F114\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What are False Cognates?\",\n    \"answer\": \"Words that look similar across languages but differ in meaning\",\n    \"explanation\": \"False Cognates (or 'false friends') can mislead learners. Example: 'actual' means 'real' in English but 'actualmente' means 'currently' in Spanish. Teachers should explicitly address these.\",\n    \"difficulty\": 2,\n    \"tags\": [\"false cognates\", \"vocabulary\", \"confusion\"]\n  },\n  {\n    \"id\": \"F115\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is an Affix?\",\n    \"answer\": \"A morpheme attached to a word stem to change meaning or function\",\n    \"explanation\": \"Affixes include prefixes (added before the root) and suffixes (added after). They modify word meaning (happy → unhappy) or grammatical function (teach → teacher).\",\n    \"difficulty\": 1,\n    \"tags\": [\"affix\", \"morphology\", \"prefix\", \"suffix\"]\n  },\n  {\n    \"id\": \"F116\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is a Suffix?\",\n    \"answer\": \"An affix added at the end of a root word to change its form or function\",\n    \"explanation\": \"Suffixes modify word class or meaning: '-ness' creates nouns (happiness), '-ed' indicates past tense (walked). Understanding suffixes aids decoding and vocabulary growth.\",\n    \"difficulty\": 1,\n    \"tags\": [\"suffix\", \"morphology\", \"word formation\"]\n  },\n  {\n    \"id\": \"F117\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is a Noun Suffix?\",\n    \"answer\": \"Turns verbs or adjectives into nouns\",\n    \"explanation\": \"Common noun suffixes include -ness (kindness), -tion (action), -ment (development). They allow students to derive meanings and expand vocabulary from known roots.\",\n    \"difficulty\": 1,\n    \"tags\": [\"noun suffix\", \"morphology\", \"word class\"]\n  },\n  {\n    \"id\": \"F118\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is a Verb Suffix?\",\n    \"answer\": \"Turns nouns or adjectives into verbs\",\n    \"explanation\": \"Verb suffixes like -ize (modernize), -en (strengthen), -ify (clarify) create verbs from other parts of speech, helping students understand word relationships.\",\n    \"difficulty\": 1,\n    \"tags\": [\"verb suffix\", \"morphology\", \"word formation\"]\n  },\n  {\n    \"id\": \"F119\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is an Adjectival Suffix?\",\n    \"answer\": \"Creates adjectives from nouns or verbs\",\n    \"explanation\": \"Adjectival suffixes include -ful (beautiful), -ous (dangerous), -able (readable). They enable students to describe and modify nouns, enriching expression.\",\n    \"difficulty\": 1,\n    \"tags\": [\"adjectival suffix\", \"adjective\", \"morphology\"]\n  },\n  {\n    \"id\": \"F120\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is a Derivational Morpheme?\",\n    \"answer\": \"Morpheme that changes a word's part of speech or meaning\",\n    \"explanation\": \"Derivational morphemes create new words: 'happy' (adjective) + '-ness' = 'happiness' (noun). They alter core meaning or grammatical category.\",\n    \"difficulty\": 2,\n    \"tags\": [\"derivational\", \"morpheme\", \"word class\", \"morphology\"]\n  },\n  {\n    \"id\": \"F121\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is an Inflectional Morpheme?\",\n    \"answer\": \"Morpheme that indicates grammatical change without altering meaning\",\n    \"explanation\": \"Inflectional morphemes signal tense (-ed), number (-s), or comparison (-er, -est) without changing word class: 'walk' vs. 'walked' are both verbs.\",\n    \"difficulty\": 2,\n    \"tags\": [\"inflectional\", \"morpheme\", \"grammar\", \"morphology\"]\n  },\n  {\n    \"id\": \"F122\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Language Immersion?\",\n    \"answer\": \"An approach where learners are surrounded by and use the target language for all communication\",\n    \"explanation\": \"Immersion programs teach content subjects in the target language, creating authentic contexts for acquisition. Students learn language through meaningful use rather than isolated drills.\",\n    \"difficulty\": 2,\n    \"tags\": [\"immersion\", \"bilingual\", \"acquisition\", \"pedagogy\"]\n  },\n  {\n    \"id\": \"F123\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Translanguaging?\",\n    \"answer\": \"Using multiple languages fluidly to make meaning and communicate effectively\",\n    \"explanation\": \"Translanguaging views bilingualism as a dynamic resource: students draw on all their linguistic repertoires to learn, think, and express themselves, rather than keeping languages separate.\",\n    \"difficulty\": 2,\n    \"tags\": [\"translanguaging\", \"bilingualism\", \"multilingualism\"]\n  },\n  {\n    \"id\": \"F124\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Metalinguistic Awareness?\",\n    \"answer\": \"The ability to think about and manipulate language structures consciously\",\n    \"explanation\": \"Metalinguistic Awareness allows learners to analyze language as an object—recognizing rhyme, syllables, word parts, and grammatical patterns. It's crucial for reading and writing development.\",\n    \"difficulty\": 3,\n    \"tags\": [\"metalinguistic\", \"awareness\", \"language analysis\"]\n  },\n  {\n    \"id\": \"F125\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What are Language Development Strategies?\",\n    \"answer\": \"Teacher techniques such as modeling, sentence frames, visuals, and collaborative talk to strengthen student language skills\",\n    \"explanation\": \"Effective strategies include modeling, wait time, scaffolding, visual aids, collaborative discussions, and explicit vocabulary instruction. These support both BICS and CALP development.\",\n    \"difficulty\": 2,\n    \"tags\": [\"strategies\", \"instruction\", \"ELL\", \"pedagogy\"]\n  }\n  ,\n  {\n    \"id\": \"F126\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Old English (450–1100 CE)?\",\n    \"answer\": \"The earliest form of English, heavily influenced by Germanic tribes\",\n    \"explanation\": \"Old English was spoken by the Angles, Saxons, and Jutes who settled in Britain. It's very different from Modern English, with complex inflections and Germanic vocabulary. Example text: Beowulf.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Old English\", \"history\", \"Germanic\"]\n  },\n  {\n    \"id\": \"F127\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Middle English (1100–1500 CE)?\",\n    \"answer\": \"English after the Norman Conquest with French and Latin influences\",\n    \"explanation\": \"The Norman Conquest (1066) brought French-speaking rulers to England. Thousands of French words entered English, especially in law, government, and cuisine. Example: Chaucer's Canterbury Tales.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Middle English\", \"Norman Conquest\", \"French influence\"]\n  },\n  {\n    \"id\": \"F128\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Early Modern English (1500–1800 CE)?\",\n    \"answer\": \"English during the Renaissance and Shakespeare era with emerging standardization\",\n    \"explanation\": \"This period saw the printing press, increased literacy, and Shakespeare's contributions. Grammar and spelling began to standardize. The King James Bible (1611) also influenced the language significantly.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Early Modern English\", \"Shakespeare\", \"Renaissance\"]\n  },\n  {\n    \"id\": \"F129\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is The Great Vowel Shift?\",\n    \"answer\": \"A major phonological change between 1400–1600 that altered vowel pronunciation\",\n    \"explanation\": \"The Great Vowel Shift changed how long vowels were pronounced, creating differences between spelling and pronunciation. This explains why English spelling often doesn't match pronunciation (e.g., 'meat' vs. 'great').\",\n    \"difficulty\": 3,\n    \"tags\": [\"Great Vowel Shift\", \"phonology\", \"pronunciation\"]\n  },\n  {\n    \"id\": \"F130\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Loanword?\",\n    \"answer\": \"A word adopted from another language without translation\",\n    \"explanation\": \"English has borrowed extensively from other languages. Examples: 'piano' (Italian), 'café' (French), 'kindergarten' (German), 'safari' (Swahili). Loanwords enrich vocabulary.\",\n    \"difficulty\": 1,\n    \"tags\": [\"loanword\", \"borrowing\", \"vocabulary\"]\n  },\n  {\n    \"id\": \"F131\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Calque?\",\n    \"answer\": \"A word or phrase borrowed by literal translation\",\n    \"explanation\": \"Calques translate elements from another language. Examples: 'skyscraper' (from French 'gratte-ciel'), 'flea market' (from French 'marché aux puces'). The structure is borrowed, not the words themselves.\",\n    \"difficulty\": 2,\n    \"tags\": [\"calque\", \"translation\", \"borrowing\"]\n  },\n  {\n    \"id\": \"F132\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Etymology?\",\n    \"answer\": \"The study of word origins and how meanings have changed over time\",\n    \"explanation\": \"Etymology traces words back to their roots, revealing historical connections and semantic shifts. For example, 'nice' originally meant 'foolish' (from Latin 'nescius' = ignorant), but meanings evolved over centuries.\",\n    \"difficulty\": 1,\n    \"tags\": [\"etymology\", \"word origins\", \"history\"]\n  },\n  {\n    \"id\": \"F133\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Pidgin?\",\n    \"answer\": \"A simplified blend of languages used for communication between groups\",\n    \"explanation\": \"Pidgins develop when groups need to communicate but don't share a language. They have simplified grammar and limited vocabulary. Example: Tok Pisin in Papua New Guinea. No native speakers—it's learned as a second language.\",\n    \"difficulty\": 2,\n    \"tags\": [\"pidgin\", \"contact language\", \"sociolinguistics\"]\n  },\n  {\n    \"id\": \"F134\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Creole?\",\n    \"answer\": \"A stable, fully developed language that evolves from a pidgin\",\n    \"explanation\": \"When a pidgin gains native speakers (usually children), it expands in complexity and becomes a creole. Example: Haitian Creole, Gullah. Creoles have full grammatical systems and can express any meaning.\",\n    \"difficulty\": 2,\n    \"tags\": [\"creole\", \"language development\", \"sociolinguistics\"]\n  },\n  {\n    \"id\": \"F135\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Dialect?\",\n    \"answer\": \"A regional or social variety of a language with distinct features\",\n    \"explanation\": \"Dialects vary in pronunciation, grammar, and vocabulary. Examples: Southern American English, British Received Pronunciation, African American Vernacular English (AAVE). All dialects are linguistically valid and rule-governed.\",\n    \"difficulty\": 1,\n    \"tags\": [\"dialect\", \"variation\", \"regional language\"]\n  },\n  {\n    \"id\": \"F136\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is an Idiolect?\",\n    \"answer\": \"An individual's unique pattern of speech and language use\",\n    \"explanation\": \"Everyone has an idiolect shaped by region, social group, age, experiences, and personal preferences. Your idiolect includes your vocabulary choices, pronunciation patterns, and favorite expressions.\",\n    \"difficulty\": 2,\n    \"tags\": [\"idiolect\", \"individual speech\", \"variation\"]\n  },\n  {\n    \"id\": \"F137\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Sociolect?\",\n    \"answer\": \"A language variety associated with a particular social group or class\",\n    \"explanation\": \"Sociolects reflect social identity, class, education, or profession. Examples include academic language, legal jargon, or working-class speech patterns. Like dialects, sociolects are systematic and meaningful.\",\n    \"difficulty\": 2,\n    \"tags\": [\"sociolect\", \"social variation\", \"class\"]\n  },\n  {\n    \"id\": \"F138\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Slang?\",\n    \"answer\": \"Informal language used to establish identity or express novelty\",\n    \"explanation\": \"Slang is often generational, regional, or group-specific. It evolves rapidly and may not be understood outside the group. Examples: 'cool' (good), 'ghosting' (ignoring someone). Slang reflects cultural trends.\",\n    \"difficulty\": 1,\n    \"tags\": [\"slang\", \"informal language\", \"identity\"]\n  },\n  {\n    \"id\": \"F139\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Standard American English (SAE)?\",\n    \"answer\": \"The form of English considered most acceptable in formal contexts\",\n    \"explanation\": \"SAE is the variety taught in schools and used in formal writing, news media, and professional settings. It's not inherently 'better' than other dialects, but it carries social prestige and institutional power.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Standard English\", \"formal language\", \"prestige\"]\n  }\n]\n;\n});","lineCount":1278,"map":[[1278,3]],"functionMap":null},"type":"js/module"}]}