ty\": 2,\n    \"tags\": [\"writing\", \"tone\", \"attitude\"]\n  },\n  {\n    \"id\": \"F040\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is theme in literature?\",\n    \"answer\": \"The central idea or universal truth in a literary work\",\n    \"explanation\": \"Theme is the underlying message or insight about life that the author explores through all elements of the story.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"theme\", \"meaning\"]\n  },\n  {\n    \"id\": \"F041\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What's the difference between plot and theme?\",\n    \"answer\": \"Plot is what happens; theme is what it means\",\n    \"explanation\": \"Plot provides the sequence of events, while theme reveals the deeper significance or message behind those events.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"plot\", \"theme\"]\n  },\n  {\n    \"id\": \"F042\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is characterization?\",\n    \"answer\": \"How an author develops a character through actions, dialogue, and description\",\n    \"explanation\": \"Characterization can be direct (telling) or indirect (showing through behavior, speech, thoughts, and interactions).\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"characterization\", \"character\"]\n  },\n  {\n    \"id\": \"F043\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is point of view in literature?\",\n    \"answer\": \"The perspective from which a story is told (first, second, or third person)\",\n    \"explanation\": \"Point of view determines what information readers access and how they experience the story's events.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"point-of-view\", \"narration\"]\n  },\n  {\n    \"id\": \"F044\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is a motif?\",\n    \"answer\": \"A recurring symbol, image, or idea that reinforces theme\",\n    \"explanation\": \"Motifs appear repeatedly throughout a work, creating patterns of meaning that support and develop the central theme.\",\n    \"difficulty\": 3,\n    \"tags\": [\"literature\", \"motif\", \"symbolism\"]\n  },\n  {\n    \"id\": \"F045\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is tone in literature?\",\n    \"answer\": \"The author's attitude toward the subject or audience\",\n    \"explanation\": \"Tone is conveyed through word choice, sentence structure, and stylistic decisions that reveal the author's perspective.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"tone\", \"attitude\"]\n  },\n  {\n    \"id\": \"F046\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is mood in literature?\",\n    \"answer\": \"The emotional atmosphere experienced by the reader\",\n    \"explanation\": \"Mood is the feeling created in the reader through setting, imagery, and language choices.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"mood\", \"atmosphere\"]\n  },\n  {\n    \"id\": \"F047\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is imagery?\",\n    \"answer\": \"Descriptive language appealing to the five senses\",\n    \"explanation\": \"Imagery creates vivid mental pictures and sensory experiences through language that engages sight, sound, touch, taste, and smell.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"imagery\", \"sensory\"]\n  },\n  {\n    \"id\": \"F048\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is an allegory?\",\n    \"answer\": \"A story with both literal and symbolic meaning\",\n    \"explanation\": \"In allegory, characters, events, and settings represent abstract ideas or moral qualities, creating dual levels of meaning.\",\n    \"difficulty\": 3,\n    \"tags\": [\"literature\", \"allegory\", \"symbolism\"]\n  },\n  {\n    \"id\": \"F049\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is foreshadowing?\",\n    \"answer\": \"Clues or hints about what will happen later in the story\",\n    \"explanation\": \"Foreshadowing creates anticipation and suspense while preparing readers for future plot developments.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"foreshadowing\", \"technique\"]\n  },\n  {\n    \"id\": \"F050\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is conflict in literature?\",\n    \"answer\": \"The struggle between opposing forces that drives the plot and reveals character growth\",\n    \"explanation\": \"Conflict can be internal (within a character) or external (between characters, or character vs. nature/society), and provides the story's central tension.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"conflict\", \"plot\"]\n  },\n  {\n    \"id\": \"F051\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is diction in literature?\",\n    \"answer\": \"Word choice used to create tone and meaning\",\n    \"explanation\": \"Diction includes the level of formality, connotation, and precision of words selected to achieve specific effects.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"diction\", \"word-choice\"]\n  },\n  {\n    \"id\": \"F052\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is irony in literature?\",\n    \"answer\": \"A contrast between appearance and reality, or expectation and outcome\",\n    \"explanation\": \"Irony includes verbal (saying the opposite of what's meant), situational (unexpected outcomes), and dramatic (audience knows more than characters).\",\n    \"difficulty\": 3,\n    \"tags\": [\"literature\", \"irony\", \"technique\"]\n  },\n  {\n    \"id\": \"F053\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"question\": \"What is symbolism in literature?\",\n    \"answer\": \"Using objects or events to represent abstract ideas\",\n    \"explanation\": \"Symbols carry meaning beyond their literal significance, adding depth and layers of interpretation to the text.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literature\", \"symbolism\", \"meaning\"]\n  },\n  {\n    \"id\": \"F054\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is phonological awareness?\",\n    \"answer\": \"Recognizing and manipulating sounds in spoken language, including rhyme and syllables\",\n    \"explanation\": \"Phonological awareness is a foundational literacy skill that includes identifying and working with sounds at the word, syllable, and phoneme levels.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literacy\", \"phonological-awareness\", \"reading\"]\n  },\n  {\n    \"id\": \"F055\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What's the difference between formative and summative assessment?\",\n    \"answer\": \"Formative happens during learning to guide instruction; summative measures learning at the end\",\n    \"explanation\": \"Formative assessments inform ongoing teaching decisions, while summative assessments evaluate overall achievement after instruction concludes.\",\n    \"difficulty\": 2,\n    \"tags\": [\"assessment\", \"formative\", \"summative\"]\n  },\n  {\n    \"id\": \"F056\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What are rubrics used for?\",\n    \"answer\": \"Define expectations and scoring criteria for consistent grading\",\n    \"explanation\": \"Rubrics provide clear standards and descriptions of performance levels, ensuring fair and transparent evaluation.\",\n    \"difficulty\": 2,\n    \"tags\": [\"assessment\", \"rubrics\", \"evaluation\"]\n  },\n  {\n    \"id\": \"F057\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is scaffolding in education?\",\n    \"answer\": \"Providing temporary support to help students master new skills independently\",\n    \"explanation\": \"Scaffolding gradually releases responsibility to students as they develop competence, like training wheels on a bicycle.\",\n    \"difficulty\": 2,\n    \"tags\": [\"instruction\", \"scaffolding\", \"support\"]\n  },\n  {\n    \"id\": \"F058\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What are reading conferences?\",\n    \"answer\": \"Discussing a student's progress, reading habits, and comprehension strategies\",\n    \"explanation\": \"Reading conferences provide individualized opportunities to assess understanding, set goals, and provide targeted support.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literacy\", \"conferences\", \"assessment\"]\n  },\n  {\n    \"id\": \"F059\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is fluency in reading?\",\n    \"answer\": \"Reading with accuracy, rate, and expression\",\n    \"explanation\": \"Fluency bridges decoding and comprehension, allowing readers to focus on meaning rather than word-by-word processing.\",\n    \"difficulty\": 2,\n    \"tags\": [\"literacy\", \"fluency\", \"reading\"]\n  },\n  {\n    \"id\": \"F060\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is metacognition in learning?\",\n    \"answer\": \"Thinking about one's own thinking—planning, monitoring, and evaluating understanding\",\n    \"explanation\": \"Metacognition enables students to become self-aware, strategic learners who can adjust their approaches when needed.\",\n    \"difficulty\": 3,\n    \"tags\": [\"learning\", \"metacognition\", \"thinking\"]\n  },\n  {\n    \"id\": \"F061\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is peer review?\",\n    \"answer\": \"Students giving constructive feedback on each other's writing\",\n    \"explanation\": \"Peer review develops critical reading skills and helps writers see their work from a reader's perspective.\",\n    \"difficulty\": 2,\n    \"tags\": [\"writing\", \"peer-review\", \"feedback\"]\n  },\n  {\n    \"id\": \"F062\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What are the stages of the writing process?\",\n    \"answer\": \"Prewriting, drafting, revising, editing, and publishing\",\n    \"explanation\": \"The writing process is recursive, with writers moving between stages as they develop and refine their work.\",\n    \"difficulty\": 2,\n    \"tags\": [\"writing\", \"process\", \"stages\"]\n  },\n  {\n    \"id\": \"F063\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"question\": \"What is differentiated instruction?\",\n    \"answer\": \"Adjusting teaching methods to meet diverse student needs\",\n    \"explanation\": \"Differentiation involves varying content, process, product, or learning environment based on student readiness, interests, and learning profiles.\",\n    \"difficulty\": 2,\n    \"tags\": [\"instruction\", \"differentiation\", \"teaching\"]\n  }\n  ,\n  {\n    \"id\": \"F301\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Alliteration?\",\n    \"answer\": \"Repetition of initial consonant sounds\",\n    \"explanation\": \"Alliteration is the repetition of initial consonant sounds in neighboring words. Example: 'Peter Piper picked a peck of pickled peppers.' It creates rhythm and emphasizes certain words.\",\n    \"difficulty\": 1,\n    \"tags\": [\"rhetoric\", \"sound\", \"alliteration\"]\n  },\n  {\n    \"id\": \"F302\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Assonance?\",\n    \"answer\": \"Repetition of vowel sounds within words\",\n    \"explanation\": \"Assonance is the repetition of vowel sounds within words. Example: 'The rain in Spain falls mainly on the plain.' It creates internal rhyme and musicality.\",\n    \"difficulty\": 1,\n    \"tags\": [\"rhetoric\", \"sound\", \"assonance\"]\n  },\n  {\n    \"id\": \"F303\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Consonance?\",\n    \"answer\": \"Repetition of consonant sounds at the end or middle of words\",\n    \"explanation\": \"Consonance is the repetition of consonant sounds at the end or middle of words, creating a pleasing auditory effect. Example: 'blank and think.'\",\n    \"difficulty\": 1,\n    \"tags\": [\"rhetoric\", \"sound\", \"consonance\"]\n  },\n  {\n    \"id\": \"F304\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Anaphora?\",\n    \"answer\": \"Repetition of a word or phrase at the beginning of successive clauses\",\n    \"explanation\": \"Anaphora is a rhetorical device where words are repeated at the beginning of successive clauses for emphasis. Example: MLK's 'I have a dream' speech repeatedly uses this phrase.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"repetition\", \"anaphora\"]\n  },\n  {\n    \"id\": \"F305\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Epistrophe?\",\n    \"answer\": \"Repetition of words at the end of successive clauses\",\n    \"explanation\": \"Epistrophe repeats words at the end of successive clauses or sentences for rhetorical effect. Example: 'government of the people, by the people, for the people.'\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"repetition\", \"epistrophe\"]\n  },\n  {\n    \"id\": \"F306\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Parallelism?\",\n    \"answer\": \"Using similar grammatical structures in a series for rhythm and balance\",\n    \"explanation\": \"Parallelism uses similar grammatical structures to create balance, rhythm, and emphasis. Example: 'I came, I saw, I conquered.' It makes writing more memorable and persuasive.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"structure\", \"parallelism\"]\n  },\n  {\n    \"id\": \"F307\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Antithesis?\",\n    \"answer\": \"Juxtaposition of contrasting ideas in balanced phrases\",\n    \"explanation\": \"Antithesis places contrasting ideas in parallel structures to emphasize opposition. Example: 'It was the best of times, it was the worst of times.' Creates dramatic contrast.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"contrast\", \"antithesis\"]\n  },\n  {\n    \"id\": \"F308\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Chiasmus?\",\n    \"answer\": \"Inverted parallelism\",\n    \"explanation\": \"Chiasmus reverses the structure of parallel phrases for memorable effect. Example: JFK's 'Ask not what your country can do for you—ask what you can do for your country.'\",\n    \"difficulty\": 3,\n    \"tags\": [\"rhetoric\", \"structure\", \"chiasmus\"]\n  },\n  {\n    \"id\": \"F309\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is a Metaphor?\",\n    \"answer\": \"Direct comparison between two unlike things without 'like' or 'as'\",\n    \"explanation\": \"A metaphor makes a direct comparison between two unlike things to create vivid imagery. Example: 'Time is a thief.' It implies shared qualities without explicit comparison words.\",\n    \"difficulty\": 1,\n    \"tags\": [\"figurative\", \"metaphor\", \"comparison\"]\n  },\n  {\n    \"id\": \"F310\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is a Simile?\",\n    \"answer\": \"Comparison using 'like' or 'as'\",\n    \"explanation\": \"A simile explicitly compares two unlike things using 'like' or 'as.' Example: 'Her eyes sparkled like diamonds.' Creates vivid imagery through direct comparison.\",\n    \"difficulty\": 1,\n    \"tags\": [\"figurative\", \"simile\", \"comparison\"]\n  },\n  {\n    \"id\": \"F311\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Personification?\",\n    \"answer\": \"Giving human qualities to non-human things\",\n    \"explanation\": \"Personification attributes human characteristics to animals, objects, or abstract concepts. Example: 'The wind whispered through the trees.' Makes writing more relatable and vivid.\",\n    \"difficulty\": 1,\n    \"tags\": [\"figurative\", \"personification\"]\n  },\n  {\n    \"id\": \"F312\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Hyperbole?\",\n    \"answer\": \"Deliberate exaggeration for emphasis or humor\",\n    \"explanation\": \"Hyperbole uses extreme exaggeration to emphasize a point or create humor. Example: 'I've told you a million times!' Not meant to be taken literally.\",\n    \"difficulty\": 1,\n    \"tags\": [\"figurative\", \"hyperbole\", \"exaggeration\"]\n  },\n  {\n    \"id\": \"F313\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Understatement?\",\n    \"answer\": \"Deliberately downplaying significance for irony\",\n    \"explanation\": \"Understatement minimizes the importance of something, often for ironic or humorous effect. Example: Calling a hurricane 'a bit of bad weather.' Creates subtle emphasis through minimization.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"understatement\", \"irony\"]\n  },\n  {\n    \"id\": \"F314\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is an Oxymoron?\",\n    \"answer\": \"Two contradictory words combined\",\n    \"explanation\": \"An oxymoron combines contradictory terms for rhetorical effect. Examples: 'bittersweet,' 'jumbo shrimp,' 'deafening silence.' Creates tension and emphasizes complexity.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"oxymoron\", \"contradiction\"]\n  },\n  {\n    \"id\": \"F315\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is a Paradox?\",\n    \"answer\": \"A statement that seems contradictory yet reveals truth\",\n    \"explanation\": \"A paradox presents an apparent contradiction that reveals deeper truth upon reflection. Example: 'The more you learn, the less you know.' Encourages critical thinking.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"paradox\", \"logic\"]\n  },\n  {\n    \"id\": \"F316\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is a Euphemism?\",\n    \"answer\": \"Mild term replacing a harsh one\",\n    \"explanation\": \"A euphemism substitutes a mild or indirect expression for something unpleasant or embarrassing. Example: 'passed away' instead of 'died.' Softens harsh realities.\",\n    \"difficulty\": 1,\n    \"tags\": [\"rhetoric\", \"euphemism\", \"diction\"]\n  },\n  {\n    \"id\": \"F317\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Litotes?\",\n    \"answer\": \"Affirmation through negation\",\n    \"explanation\": \"Litotes affirms something by denying its opposite. Example: 'not bad' means 'good.' Creates emphasis through understatement and irony.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"litotes\", \"irony\"]\n  },\n  {\n    \"id\": \"F318\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is a Rhetorical Question?\",\n    \"answer\": \"Question asked for effect, not an answer\",\n    \"explanation\": \"A rhetorical question is posed for persuasive effect rather than to elicit an answer. Example: 'Is the Pope Catholic?' Engages audience and emphasizes a point.\",\n    \"difficulty\": 1,\n    \"tags\": [\"rhetoric\", \"question\", \"persuasion\"]\n  },\n  {\n    \"id\": \"F319\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Apostrophe?\",\n    \"answer\": \"Addressing an absent person or abstract idea directly\",\n    \"explanation\": \"Apostrophe directly addresses someone absent or something non-human as if present. Example: 'O Death, where is thy sting?' Creates dramatic intensity.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"apostrophe\", \"address\"]\n  },\n  {\n    \"id\": \"F320\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Synecdoche?\",\n    \"answer\": \"Using a part to represent the whole\",\n    \"explanation\": \"Synecdoche uses a part to represent the whole or vice versa. Example: 'All hands on deck' (hands = sailors). Creates compact, vivid language.\",\n    \"difficulty\": 2,\n    \"tags\": [\"figurative\", \"synecdoche\", \"substitution\"]\n  },\n  {\n    \"id\": \"F321\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Metonymy?\",\n    \"answer\": \"Substituting an associated word for the thing itself\",\n    \"explanation\": \"Metonymy replaces something with a word closely associated with it. Example: 'The crown' for monarchy, 'The White House' for the President. Creates efficient reference.\",\n    \"difficulty\": 2,\n    \"tags\": [\"figurative\", \"metonymy\", \"substitution\"]\n  },\n  {\n    \"id\": \"F322\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Irony?\",\n    \"answer\": \"Contrast between expectation and reality\",\n    \"explanation\": \"Irony occurs when there's a discrepancy between appearance and reality, expectation and outcome. Types include verbal, situational, and dramatic irony. Creates layers of meaning.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"irony\", \"contrast\"]\n  },\n  {\n    \"id\": \"F323\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Juxtaposition?\",\n    \"answer\": \"Placing two elements side by side to emphasize contrast\",\n    \"explanation\": \"Juxtaposition places contrasting elements near each other to highlight differences. Example: placing love and hate scenes adjacent. Emphasizes through contrast.\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhetoric\", \"juxtaposition\", \"contrast\"]\n  },\n  {\n    \"id\": \"F324\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Tone?\",\n    \"answer\": \"Author's attitude toward the subject or audience\",\n    \"explanation\": \"Tone reflects the author's attitude, revealed through word choice, sentence structure, and details. Examples: formal, informal, ironic, optimistic. Shapes reader's response.\",\n    \"difficulty\": 1,\n    \"tags\": [\"craft\", \"tone\", \"style\"]\n  },\n  {\n    \"id\": \"F325\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"question\": \"What is Diction?\",\n    \"answer\": \"Writer's choice of words to create tone and meaning\",\n    \"explanation\": \"Diction refers to word choice and vocabulary level. It can be formal, informal, colloquial, or technical. Diction directly shapes tone, mood, and clarity.\",\n    \"difficulty\": 1,\n    \"tags\": [\"craft\", \"diction\", \"style\"]\n  }\n  ,\n  {\n    \"id\": \"F101\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Second Language Acquisition (SLA)?\",\n    \"answer\": \"The process by which individuals learn a language other than their native one\",\n    \"explanation\": \"Second Language Acquisition (SLA) refers to the systematic process through which people learn a language beyond their first/native language. It involves cognitive, social, and educational factors.\",\n    \"difficulty\": 2,\n    \"tags\": [\"SLA\", \"language\", \"acquisition\"]\n  },\n  {\n    \"id\": \"F102\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is the Input Hypothesis?\",\n    \"answer\": \"Krashen's idea that learners acquire language best when exposed to comprehensible input slightly above their current level (i+1)\",\n    \"explanation\": \"Stephen Krashen's Input Hypothesis suggests learners progress by receiving 'comprehensible input' that is just beyond their current competence level (i+1). This challenges them without overwhelming them.\",\n    \"difficulty\": 3,\n    \"tags\": [\"Krashen\", \"input\", \"hypothesis\", \"SLA\"]\n  },\n  {\n    \"id\": \"F103\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is the Affective Filter?\",\n    \"answer\": \"Krashen's concept that anxiety or low motivation can block language input from being acquired\",\n    \"explanation\": \"The Affective Filter is a metaphorical barrier: when learners are anxious, unmotivated, or lack confidence, they cannot process language input effectively. Lowering this filter enhances acquisition.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Krashen\", \"affective filter\", \"motivation\", \"anxiety\"]\n  },\n  {\n    \"id\": \"F104\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is the Natural Order Hypothesis?\",\n    \"answer\": \"Language structures are learned in a predictable sequence, not necessarily through formal instruction\",\n    \"explanation\": \"This hypothesis states that grammatical structures are acquired in a natural, predictable order regardless of explicit teaching. Learners follow similar developmental sequences.\",\n    \"difficulty\": 2,\n    \"tags\": [\"natural order\", \"grammar\", \"acquisition\", \"Krashen\"]\n  },\n  {\n    \"id\": \"F105\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Communicative Competence?\",\n    \"answer\": \"The ability to use language appropriately in social contexts, not just knowing grammar\",\n    \"explanation\": \"Communicative Competence goes beyond grammatical knowledge to include sociolinguistic, discourse, and strategic competence—knowing when, how, and why to use language in real situations.\",\n    \"difficulty\": 2,\n    \"tags\": [\"communicative competence\", \"pragmatics\", \"social language\"]\n  },\n  {\n    \"id\": \"F106\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Scaffolding in language learning?\",\n    \"answer\": \"Temporary instructional support helping students reach higher levels of understanding\",\n    \"explanation\": \"Scaffolding provides structured support (e.g., sentence frames, graphic organizers, modeling) that helps learners perform tasks they couldn't do independently, gradually removing support as competence grows.\",\n    \"difficulty\": 1,\n    \"tags\": [\"scaffolding\", \"support\", \"instruction\", \"Vygotsky\"]\n  },\n  {\n    \"id\": \"F107\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Modeling in language instruction?\",\n    \"answer\": \"Demonstrating correct language use before expecting students to use it independently\",\n    \"explanation\": \"Modeling involves the teacher showing students how to perform a language task (e.g., pronouncing words, structuring sentences) so students have a clear example to follow.\",\n    \"difficulty\": 1,\n    \"tags\": [\"modeling\", \"demonstration\", \"instruction\"]\n  },\n  {\n    \"id\": \"F108\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Total Physical Response (TPR)?\",\n    \"answer\": \"Teaching method pairing language input with physical movement to aid comprehension\",\n    \"explanation\": \"TPR, developed by James Asher, uses physical actions to reinforce language meaning. For example, students perform actions (stand, sit, jump) as the teacher gives commands, enhancing comprehension through kinesthetic learning.\",\n    \"difficulty\": 2,\n    \"tags\": [\"TPR\", \"movement\", \"comprehension\", \"teaching method\"]\n  },\n  {\n    \"id\": \"F109\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Wait Time in language teaching?\",\n    \"answer\": \"Pausing after asking a question so language learners can process and formulate a response\",\n    \"explanation\": \"Wait Time (typically 3-5 seconds) gives ELLs and all students time to think, translate internally if needed, and construct responses, leading to more thoughtful and accurate answers.\",\n    \"difficulty\": 1,\n    \"tags\": [\"wait time\", \"questioning\", \"ELL\", \"strategy\"]\n  },\n  {\n    \"id\": \"F110\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What are BICS and CALP?\",\n    \"answer\": \"Basic Interpersonal Communication Skills (social) vs. Cognitive Academic Language Proficiency (academic)\",\n    \"explanation\": \"BICS refers to everyday conversational language (1-2 years to develop), while CALP is the academic language needed for school success (5-7 years). Teachers must support both.\",\n    \"difficulty\": 2,\n    \"tags\": [\"BICS\", \"CALP\", \"Cummins\", \"academic language\"]\n  },\n  {\n    \"id\": \"F111\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Code-Switching?\",\n    \"answer\": \"Alternating between languages or dialects depending on context or audience\",\n    \"explanation\": \"Code-Switching is a natural linguistic practice where bilingual speakers shift between languages within conversations, often to express identity, clarify meaning, or match social contexts.\",\n    \"difficulty\": 2,\n    \"tags\": [\"code-switching\", \"bilingualism\", \"sociolinguistics\"]\n  },\n  {\n    \"id\": \"F112\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Language Transfer?\",\n    \"answer\": \"Influence of a learner's first language on learning a second language\",\n    \"explanation\": \"Language Transfer occurs when features of a learner's native language (phonology, syntax, vocabulary) affect how they produce or understand the target language. It can be positive or negative.\",\n    \"difficulty\": 2,\n    \"tags\": [\"transfer\", \"L1\", \"L2\", \"interference\"]\n  },\n  {\n    \"id\": \"F113\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What are Cognates?\",\n    \"answer\": \"Words in two languages with similar meaning and form\",\n    \"explanation\": \"Cognates are words that share common etymological roots across languages, like 'information' (English) and 'información' (Spanish). They help ELLs make connections and build vocabulary.\",\n    \"difficulty\": 1,\n    \"tags\": [\"cognates\", \"vocabulary\", \"Spanish\", \"transfer\"]\n  },\n  {\n    \"id\": \"F114\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What are False Cognates?\",\n    \"answer\": \"Words that look similar across languages but differ in meaning\",\n    \"explanation\": \"False Cognates (or 'false friends') can mislead learners. Example: 'actual' means 'real' in English but 'actualmente' means 'currently' in Spanish. Teachers should explicitly address these.\",\n    \"difficulty\": 2,\n    \"tags\": [\"false cognates\", \"vocabulary\", \"confusion\"]\n  },\n  {\n    \"id\": \"F115\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is an Affix?\",\n    \"answer\": \"A morpheme attached to a word stem to change meaning or function\",\n    \"explanation\": \"Affixes include prefixes (added before the root) and suffixes (added after). They modify word meaning (happy → unhappy) or grammatical function (teach → teacher).\",\n    \"difficulty\": 1,\n    \"tags\": [\"affix\", \"morphology\", \"prefix\", \"suffix\"]\n  },\n  {\n    \"id\": \"F116\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is a Suffix?\",\n    \"answer\": \"An affix added at the end of a root word to change its form or function\",\n    \"explanation\": \"Suffixes modify word class or meaning: '-ness' creates nouns (happiness), '-ed' indicates past tense (walked). Understanding suffixes aids decoding and vocabulary growth.\",\n    \"difficulty\": 1,\n    \"tags\": [\"suffix\", \"morphology\", \"word formation\"]\n  },\n  {\n    \"id\": \"F117\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is a Noun Suffix?\",\n    \"answer\": \"Turns verbs or adjectives into nouns\",\n    \"explanation\": \"Common noun suffixes include -ness (kindness), -tion (action), -ment (development). They allow students to derive meanings and expand vocabulary from known roots.\",\n    \"difficulty\": 1,\n    \"tags\": [\"noun suffix\", \"morphology\", \"word class\"]\n  },\n  {\n    \"id\": \"F118\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is a Verb Suffix?\",\n    \"answer\": \"Turns nouns or adjectives into verbs\",\n    \"explanation\": \"Verb suffixes like -ize (modernize), -en (strengthen), -ify (clarify) create verbs from other parts of speech, helping students understand word relationships.\",\n    \"difficulty\": 1,\n    \"tags\": [\"verb suffix\", \"morphology\", \"word formation\"]\n  },\n  {\n    \"id\": \"F119\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is an Adjectival Suffix?\",\n    \"answer\": \"Creates adjectives from nouns or verbs\",\n    \"explanation\": \"Adjectival suffixes include -ful (beautiful), -ous (dangerous), -able (readable). They enable students to describe and modify nouns, enriching expression.\",\n    \"difficulty\": 1,\n    \"tags\": [\"adjectival suffix\", \"adjective\", \"morphology\"]\n  },\n  {\n    \"id\": \"F120\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is a Derivational Morpheme?\",\n    \"answer\": \"Morpheme that changes a word's part of speech or meaning\",\n    \"explanation\": \"Derivational morphemes create new words: 'happy' (adjective) + '-ness' = 'happiness' (noun). They alter core meaning or grammatical category.\",\n    \"difficulty\": 2,\n    \"tags\": [\"derivational\", \"morpheme\", \"word class\", \"morphology\"]\n  },\n  {\n    \"id\": \"F121\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is an Inflectional Morpheme?\",\n    \"answer\": \"Morpheme that indicates grammatical change without altering meaning\",\n    \"explanation\": \"Inflectional morphemes signal tense (-ed), number (-s), or comparison (-er, -est) without changing word class: 'walk' vs. 'walked' are both verbs.\",\n    \"difficulty\": 2,\n    \"tags\": [\"inflectional\", \"morpheme\", \"grammar\", \"morphology\"]\n  },\n  {\n    \"id\": \"F122\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Language Immersion?\",\n    \"answer\": \"An approach where learners are surrounded by and use the target language for all communication\",\n    \"explanation\": \"Immersion programs teach content subjects in the target language, creating authentic contexts for acquisition. Students learn language through meaningful use rather than isolated drills.\",\n    \"difficulty\": 2,\n    \"tags\": [\"immersion\", \"bilingual\", \"acquisition\", \"pedagogy\"]\n  },\n  {\n    \"id\": \"F123\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Translanguaging?\",\n    \"answer\": \"Using multiple languages fluidly to make meaning and communicate effectively\",\n    \"explanation\": \"Translanguaging views bilingualism as a dynamic resource: students draw on all their linguistic repertoires to learn, think, and express themselves, rather than keeping languages separate.\",\n    \"difficulty\": 2,\n    \"tags\": [\"translanguaging\", \"bilingualism\", \"multilingualism\"]\n  },\n  {\n    \"id\": \"F124\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What is Metalinguistic Awareness?\",\n    \"answer\": \"The ability to think about and manipulate language structures consciously\",\n    \"explanation\": \"Metalinguistic Awareness allows learners to analyze language as an object—recognizing rhyme, syllables, word parts, and grammatical patterns. It's crucial for reading and writing development.\",\n    \"difficulty\": 3,\n    \"tags\": [\"metalinguistic\", \"awareness\", \"language analysis\"]\n  },\n  {\n    \"id\": \"F125\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"question\": \"What are Language Development Strategies?\",\n    \"answer\": \"Teacher techniques such as modeling, sentence frames, visuals, and collaborative talk to strengthen student language skills\",\n    \"explanation\": \"Effective strategies include modeling, wait time, scaffolding, visual aids, collaborative discussions, and explicit vocabulary instruction. These support both BICS and CALP development.\",\n    \"difficulty\": 2,\n    \"tags\": [\"strategies\", \"instruction\", \"ELL\", \"pedagogy\"]\n  }\n  ,\n  {\n    \"id\": \"F126\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Old English (450–1100 CE)?\",\n    \"answer\": \"The earliest form of English, heavily influenced by Germanic tribes\",\n    \"explanation\": \"Old English was spoken by the Angles, Saxons, and Jutes who settled in Britain. It's very different from Modern English, with complex inflections and Germanic vocabulary. Example text: Beowulf.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Old English\", \"history\", \"Germanic\"]\n  },\n  {\n    \"id\": \"F127\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Middle English (1100–1500 CE)?\",\n    \"answer\": \"English after the Norman Conquest with French and Latin influences\",\n    \"explanation\": \"The Norman Conquest (1066) brought French-speaking rulers to England. Thousands of French words entered English, especially in law, government, and cuisine. Example: Chaucer's Canterbury Tales.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Middle English\", \"Norman Conquest\", \"French influence\"]\n  },\n  {\n    \"id\": \"F128\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Early Modern English (1500–1800 CE)?\",\n    \"answer\": \"English during the Renaissance and Shakespeare era with emerging standardization\",\n    \"explanation\": \"This period saw the printing press, increased literacy, and Shakespeare's contributions. Grammar and spelling began to standardize. The King James Bible (1611) also influenced the language significantly.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Early Modern English\", \"Shakespeare\", \"Renaissance\"]\n  },\n  {\n    \"id\": \"F129\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is The Great Vowel Shift?\",\n    \"answer\": \"A major phonological change between 1400–1600 that altered vowel pronunciation\",\n    \"explanation\": \"The Great Vowel Shift changed how long vowels were pronounced, creating differences between spelling and pronunciation. This explains why English spelling often doesn't match pronunciation (e.g., 'meat' vs. 'great').\",\n    \"difficulty\": 3,\n    \"tags\": [\"Great Vowel Shift\", \"phonology\", \"pronunciation\"]\n  },\n  {\n    \"id\": \"F130\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Loanword?\",\n    \"answer\": \"A word adopted from another language without translation\",\n    \"explanation\": \"English has borrowed extensively from other languages. Examples: 'piano' (Italian), 'café' (French), 'kindergarten' (German), 'safari' (Swahili). Loanwords enrich vocabulary.\",\n    \"difficulty\": 1,\n    \"tags\": [\"loanword\", \"borrowing\", \"vocabulary\"]\n  },\n  {\n    \"id\": \"F131\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Calque?\",\n    \"answer\": \"A word or phrase borrowed by literal translation\",\n    \"explanation\": \"Calques translate elements from another language. Examples: 'skyscraper' (from French 'gratte-ciel'), 'flea market' (from French 'marché aux puces'). The structure is borrowed, not the words themselves.\",\n    \"difficulty\": 2,\n    \"tags\": [\"calque\", \"translation\", \"borrowing\"]\n  },\n  {\n    \"id\": \"F132\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Etymology?\",\n    \"answer\": \"The study of word origins and how meanings have changed over time\",\n    \"explanation\": \"Etymology traces words back to their roots, revealing historical connections and semantic shifts. For example, 'nice' originally meant 'foolish' (from Latin 'nescius' = ignorant), but meanings evolved over centuries.\",\n    \"difficulty\": 1,\n    \"tags\": [\"etymology\", \"word origins\", \"history\"]\n  },\n  {\n    \"id\": \"F133\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Pidgin?\",\n    \"answer\": \"A simplified blend of languages used for communication between groups\",\n    \"explanation\": \"Pidgins develop when groups need to communicate but don't share a language. They have simplified grammar and limited vocabulary. Example: Tok Pisin in Papua New Guinea. No native speakers—it's learned as a second language.\",\n    \"difficulty\": 2,\n    \"tags\": [\"pidgin\", \"contact language\", \"sociolinguistics\"]\n  },\n  {\n    \"id\": \"F134\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Creole?\",\n    \"answer\": \"A stable, fully developed language that evolves from a pidgin\",\n    \"explanation\": \"When a pidgin gains native speakers (usually children), it expands in complexity and becomes a creole. Example: Haitian Creole, Gullah. Creoles have full grammatical systems and can express any meaning.\",\n    \"difficulty\": 2,\n    \"tags\": [\"creole\", \"language development\", \"sociolinguistics\"]\n  },\n  {\n    \"id\": \"F135\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Dialect?\",\n    \"answer\": \"A regional or social variety of a language with distinct features\",\n    \"explanation\": \"Dialects vary in pronunciation, grammar, and vocabulary. Examples: Southern American English, British Received Pronunciation, African American Vernacular English (AAVE). All dialects are linguistically valid and rule-governed.\",\n    \"difficulty\": 1,\n    \"tags\": [\"dialect\", \"variation\", \"regional language\"]\n  },\n  {\n    \"id\": \"F136\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is an Idiolect?\",\n    \"answer\": \"An individual's unique pattern of speech and language use\",\n    \"explanation\": \"Everyone has an idiolect shaped by region, social group, age, experiences, and personal preferences. Your idiolect includes your vocabulary choices, pronunciation patterns, and favorite expressions.\",\n    \"difficulty\": 2,\n    \"tags\": [\"idiolect\", \"individual speech\", \"variation\"]\n  },\n  {\n    \"id\": \"F137\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is a Sociolect?\",\n    \"answer\": \"A language variety associated with a particular social group or class\",\n    \"explanation\": \"Sociolects reflect social identity, class, education, or profession. Examples include academic language, legal jargon, or working-class speech patterns. Like dialects, sociolects are systematic and meaningful.\",\n    \"difficulty\": 2,\n    \"tags\": [\"sociolect\", \"social variation\", \"class\"]\n  },\n  {\n    \"id\": \"F138\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Slang?\",\n    \"answer\": \"Informal language used to establish identity or express novelty\",\n    \"explanation\": \"Slang is often generational, regional, or group-specific. It evolves rapidly and may not be understood outside the group. Examples: 'cool' (good), 'ghosting' (ignoring someone). Slang reflects cultural trends.\",\n    \"difficulty\": 1,\n    \"tags\": [\"slang\", \"informal language\", \"identity\"]\n  },\n  {\n    \"id\": \"F139\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"question\": \"What is Standard American English (SAE)?\",\n    \"answer\": \"The form of English considered most acceptable in formal contexts\",\n    \"explanation\": \"SAE is the variety taught in schools and used in formal writing, news media, and professional settings. It's not inherently 'better' than other dialects, but it carries social prestige and institutional power.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Standard English\", \"formal language\", \"prestige\"]\n  }\n  ,\n  {\n    \"id\": \"F201\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Language Acquisition?\",\n    \"answer\": \"The unconscious process by which humans naturally acquire language through interaction and exposure\",\n    \"explanation\": \"Language Acquisition happens naturally as children interact with caregivers and their environment. Unlike learning (conscious study), acquisition is implicit and automatic. Example: Babies acquiring their first language without formal instruction.\",\n    \"difficulty\": 1,\n    \"tags\": [\"language acquisition\", \"natural learning\", \"development\"]\n  },\n  {\n    \"id\": \"F202\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Language Learning?\",\n    \"answer\": \"The conscious study of language rules and structure, often in formal classroom settings\",\n    \"explanation\": \"Language Learning involves explicit instruction, memorization, and conscious attention to rules. Example: Studying grammar or vocabulary lists. Krashen distinguishes this from natural acquisition.\",\n    \"difficulty\": 1,\n    \"tags\": [\"language learning\", \"formal instruction\", \"conscious study\"]\n  },\n  {\n    \"id\": \"F203\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is the Critical Period Hypothesis?\",\n    \"answer\": \"Proposes that language acquisition is most efficient during early childhood before neural plasticity declines\",\n    \"explanation\": \"This hypothesis suggests there's a biological window (roughly birth to puberty) when language acquisition is easiest. After this period, learning new languages becomes more difficult due to decreased brain plasticity.\",\n    \"difficulty\": 2,\n    \"tags\": [\"critical period\", \"brain development\", \"age factors\"]\n  },\n  {\n    \"id\": \"F204\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Overgeneralization?\",\n    \"answer\": \"A developmental stage when children apply a learned rule too broadly\",\n    \"explanation\": \"Overgeneralization shows children are learning language rules, not just memorizing. Example: 'goed' instead of 'went' applies the regular past tense rule (-ed) to an irregular verb. This is a normal, productive stage of acquisition.\",\n    \"difficulty\": 2,\n    \"tags\": [\"overgeneralization\", \"child development\", \"grammar rules\"]\n  },\n  {\n    \"id\": \"F205\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Telegraphic Speech?\",\n    \"answer\": \"Early child speech using essential words only\",\n    \"explanation\": \"Telegraphic Speech omits function words (articles, prepositions) and uses content words: 'Want cookie,' 'Daddy go.' Named after telegrams which charged per word. Typical around 18-24 months.\",\n    \"difficulty\": 1,\n    \"tags\": [\"telegraphic speech\", \"early language\", \"child development\"]\n  },\n  {\n    \"id\": \"F206\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Interactionist Theory?\",\n    \"answer\": \"Emphasizes that language develops through social interaction and communication with caregivers\",\n    \"explanation\": \"Interactionist Theory combines biological readiness with social necessity. Language emerges through meaningful interaction, not just exposure. Caregivers' responsive communication supports language growth.\",\n    \"difficulty\": 2,\n    \"tags\": [\"interactionist\", \"social learning\", \"interaction\"]\n  },\n  {\n    \"id\": \"F207\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Behaviorist Theory?\",\n    \"answer\": \"Proposes that language is learned through imitation, reinforcement, and conditioning\",\n    \"explanation\": \"Behaviorist Theory (Skinner) views language as learned behavior shaped by rewards and punishments. Children imitate adults and are reinforced for correct forms. However, this doesn't fully explain creative language use.\",\n    \"difficulty\": 2,\n    \"tags\": [\"behaviorism\", \"Skinner\", \"imitation\"]\n  },\n  {\n    \"id\": \"F208\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Nativist Theory?\",\n    \"answer\": \"Chomsky's view that humans are born with an innate capacity for language (Language Acquisition Device)\",\n    \"explanation\": \"Nativist Theory (Chomsky) proposes a universal grammar hardwired in the brain. The Language Acquisition Device (LAD) allows children to acquire any language with minimal input. Explains rapid, universal language development.\",\n    \"difficulty\": 2,\n    \"tags\": [\"nativist\", \"Chomsky\", \"LAD\", \"innate\"]\n  },\n  {\n    \"id\": \"F209\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Cognitive Theory (Piaget)?\",\n    \"answer\": \"Suggests that language development is linked to overall cognitive growth and concept formation\",\n    \"explanation\": \"Piaget argued language depends on cognitive development. Children can't use words for concepts they haven't mentally grasped. Language reflects thinking, not vice versa. Symbolic thought enables language.\",\n    \"difficulty\": 2,\n    \"tags\": [\"cognitive theory\", \"Piaget\", \"thinking\"]\n  },\n  {\n    \"id\": \"F210\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Zone of Proximal Development (ZPD)?\",\n    \"answer\": \"Vygotsky's concept: learners progress when supported slightly beyond their current ability\",\n    \"explanation\": \"ZPD is the gap between what learners can do independently and what they can do with guidance. Effective teaching targets this zone, providing scaffolding to reach new levels. Social interaction is key to learning.\",\n    \"difficulty\": 2,\n    \"tags\": [\"ZPD\", \"Vygotsky\", \"scaffolding\", \"development\"]\n  },\n  {\n    \"id\": \"F211\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Interlanguage?\",\n    \"answer\": \"A temporary linguistic system formed by second language learners blending features of both languages\",\n    \"explanation\": \"Interlanguage is the learner's evolving language system between L1 and L2. It's systematic but contains errors from L1 influence, overgeneralization, and incomplete L2 knowledge. Example: 'She no like' (Spanish influence on English).\",\n    \"difficulty\": 2,\n    \"tags\": [\"interlanguage\", \"L2 learning\", \"developmental\"]\n  },\n  {\n    \"id\": \"F212\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Language Transfer?\",\n    \"answer\": \"The influence of a learner's first language on the acquisition of a second\",\n    \"explanation\": \"Language Transfer occurs when L1 patterns affect L2 production. Can be positive (helpful similarities) or negative (interference from differences). Example: Spanish speakers omitting 'it' in 'It's raining' (not required in Spanish).\",\n    \"difficulty\": 2,\n    \"tags\": [\"transfer\", \"L1 influence\", \"L2 acquisition\"]\n  },\n  {\n    \"id\": \"F213\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Positive Transfer?\",\n    \"answer\": \"When L1 and L2 share similar structures, facilitating learning\",\n    \"explanation\": \"Positive Transfer helps learners by applying L1 knowledge to L2. Examples: cognates (information/información), similar grammar patterns, shared phonemes. Bilingual students can leverage these similarities.\",\n    \"difficulty\": 1,\n    \"tags\": [\"positive transfer\", \"cognates\", \"facilitation\"]\n  },\n  {\n    \"id\": \"F214\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Negative Transfer (Interference)?\",\n    \"answer\": \"When differences between L1 and L2 cause learning difficulties or errors\",\n    \"explanation\": \"Negative Transfer creates errors when L1 patterns conflict with L2. Examples: Spanish speakers saying 'is raining' (omitting subject), Japanese speakers confusing 'r' and 'l'. Teachers should address these predictable errors.\",\n    \"difficulty\": 2,\n    \"tags\": [\"negative transfer\", \"interference\", \"errors\"]\n  },\n  {\n    \"id\": \"F215\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Code-Mixing?\",\n    \"answer\": \"The blending of words or phrases from two languages within a single discourse\",\n    \"explanation\": \"Code-Mixing combines languages within sentences or conversations. Different from code-switching (alternating between languages). Example: 'Vamos al store' (Spanish + English). Common among bilinguals, reflects linguistic flexibility.\",\n    \"difficulty\": 2,\n    \"tags\": [\"code-mixing\", \"bilingualism\", \"language contact\"]\n  },\n  {\n    \"id\": \"F216\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Academic Language?\",\n    \"answer\": \"Language used in formal education settings; includes specialized vocabulary, syntax, and discourse structures\",\n    \"explanation\": \"Academic Language is more abstract, complex, and context-reduced than social language. Requires explicit instruction. Examples: technical vocabulary, passive voice, complex sentences. Essential for school success.\",\n    \"difficulty\": 2,\n    \"tags\": [\"academic language\", \"CALP\", \"formal language\"]\n  },\n  {\n    \"id\": \"F217\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Disciplinary Literacy?\",\n    \"answer\": \"Understanding how language and communication differ across academic subjects\",\n    \"explanation\": \"Disciplinary Literacy recognizes that reading/writing in history differs from science or math. Each discipline has unique texts, vocabulary, arguments, and ways of constructing knowledge. Students need subject-specific literacy strategies.\",\n    \"difficulty\": 2,\n    \"tags\": [\"disciplinary literacy\", \"content areas\", \"subject-specific\"]\n  },\n  {\n    \"id\": \"F218\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Language Across the Curriculum?\",\n    \"answer\": \"Teaching approach that integrates reading, writing, and speaking skills into all subject areas\",\n    \"explanation\": \"Language Across the Curriculum makes all teachers language teachers. Students read, write, and discuss in math, science, social studies—not just English class. Reinforces literacy while deepening content understanding.\",\n    \"difficulty\": 2,\n    \"tags\": [\"language across curriculum\", \"integration\", \"content literacy\"]\n  },\n  {\n    \"id\": \"F219\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Collaborative Dialogue?\",\n    \"answer\": \"Conversation among learners that promotes language acquisition through peer interaction\",\n    \"explanation\": \"Collaborative Dialogue involves students negotiating meaning, clarifying ideas, and co-constructing knowledge through talk. Promotes active language use, critical thinking, and social learning. Example: partner discussions, group projects.\",\n    \"difficulty\": 1,\n    \"tags\": [\"collaborative dialogue\", \"peer interaction\", \"discussion\"]\n  },\n  {\n    \"id\": \"F220\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Cultural Schema?\",\n    \"answer\": \"Background knowledge from one's culture that influences language comprehension and use\",\n    \"explanation\": \"Cultural Schema includes shared experiences, values, and knowledge that aid comprehension. Example: American students understanding baseball metaphors in text. ELLs may lack cultural schema, hindering comprehension despite language proficiency.\",\n    \"difficulty\": 2,\n    \"tags\": [\"cultural schema\", \"background knowledge\", \"comprehension\"]\n  },\n  {\n    \"id\": \"F221\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Academic Vocabulary Tier 2?\",\n    \"answer\": \"High-utility words used across disciplines\",\n    \"explanation\": \"Tier 2 vocabulary appears across subjects: analyze, infer, evaluate, synthesize. More sophisticated than everyday words (Tier 1: happy, run) but less specialized than technical terms (Tier 3: photosynthesis). Priority for explicit instruction.\",\n    \"difficulty\": 1,\n    \"tags\": [\"Tier 2 vocabulary\", \"academic words\", \"cross-disciplinary\"]\n  },\n  {\n    \"id\": \"F222\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Metacognition in Reading?\",\n    \"answer\": \"Students' awareness and control of their comprehension processes\",\n    \"explanation\": \"Metacognition means thinking about thinking. In reading, students monitor comprehension, notice confusion, and apply fix-up strategies. Example: re-reading, asking questions, visualizing. Explicit instruction improves metacognitive skills.\",\n    \"difficulty\": 2,\n    \"tags\": [\"metacognition\", \"comprehension monitoring\", \"self-awareness\"]\n  },\n  {\n    \"id\": \"F223\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Scaffolded Reading Instruction?\",\n    \"answer\": \"Teacher gradually releases responsibility by modeling strategies, guiding practice, then independent work\",\n    \"explanation\": \"Scaffolded Instruction follows the gradual release model: I do (modeling), We do (guided practice), You do (independent practice). Supports learners in ZPD, building autonomy. Example: teacher thinks aloud, then students practice with support.\",\n    \"difficulty\": 1,\n    \"tags\": [\"scaffolding\", \"gradual release\", \"instruction\"]\n  },\n  {\n    \"id\": \"F224\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What are Cross-Linguistic Connections?\",\n    \"answer\": \"Recognizing relationships between languages to strengthen vocabulary and comprehension\",\n    \"explanation\": \"Cross-Linguistic Connections leverage bilingual students' L1 knowledge. Examples: comparing cognates, discussing idioms, analyzing grammar differences. Validates home language while building English proficiency.\",\n    \"difficulty\": 2,\n    \"tags\": [\"cross-linguistic\", \"bilingual education\", \"transfer\"]\n  },\n  {\n    \"id\": \"F225\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"question\": \"What is Integrative Language Teaching?\",\n    \"answer\": \"Combining listening, speaking, reading, and writing in content-rich lessons to promote holistic competence\",\n    \"explanation\": \"Integrative Language Teaching connects all four skills in meaningful contexts rather than isolating them. Example: students read about ecosystems, discuss findings, write reports, present orally. Reflects authentic language use.\",\n    \"difficulty\": 2,\n    \"tags\": [\"integrative teaching\", \"four skills\", \"holistic\"]\n  }\n  ,\n  {\n    \"id\": \"F401\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Phonology?\",\n    \"answer\": \"The sound system of a language, including phonemes, stress, and intonation patterns\",\n    \"explanation\": \"Phonology studies how sounds function in a language. It includes phonemes (smallest sound units), stress patterns (syllable emphasis), and intonation (pitch changes). Example: English distinguishes /p/ and /b/ as separate phonemes (pin vs. bin).\",\n    \"difficulty\": 2,\n    \"tags\": [\"phonology\", \"linguistics\", \"sound system\"]\n  },\n  {\n    \"id\": \"F402\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Morphology?\",\n    \"answer\": \"The structure of words and the formation of words from morphemes\",\n    \"explanation\": \"Morphology analyzes how words are built from morphemes (roots, prefixes, suffixes). Example: 'unhappiness' = un- (prefix) + happy (root) + -ness (suffix). Understanding morphology aids vocabulary development and spelling.\",\n    \"difficulty\": 2,\n    \"tags\": [\"morphology\", \"word structure\", \"morphemes\"]\n  },\n  {\n    \"id\": \"F403\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Syntax?\",\n    \"answer\": \"Rules governing phrase and sentence structure; how words combine into clauses\",\n    \"explanation\": \"Syntax determines word order and grammatical relationships. Example: 'The cat chased the mouse' vs. 'The mouse chased the cat' show how syntax creates different meanings. English uses subject-verb-object order.\",\n    \"difficulty\": 2,\n    \"tags\": [\"syntax\", \"sentence structure\", \"grammar\"]\n  },\n  {\n    \"id\": \"F404\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Semantics?\",\n    \"answer\": \"Meaning in language; relationships among words, phrases, and sentences\",\n    \"explanation\": \"Semantics studies how meaning is constructed and interpreted. Includes word meanings, sentence meanings, and how context affects interpretation. Example: 'bank' can mean financial institution or river edge—context determines meaning.\",\n    \"difficulty\": 2,\n    \"tags\": [\"semantics\", \"meaning\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F405\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Pragmatics?\",\n    \"answer\": \"Language use in context; implied meaning, speaker intent, and social norms\",\n    \"explanation\": \"Pragmatics examines how context shapes meaning beyond literal words. Includes indirect speech acts, implicature, and social conventions. Example: 'Can you pass the salt?' is a request, not a question about ability.\",\n    \"difficulty\": 3,\n    \"tags\": [\"pragmatics\", \"context\", \"implied meaning\"]\n  },\n  {\n    \"id\": \"F406\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Descriptive vs. Prescriptive grammar?\",\n    \"answer\": \"Descriptive grammar explains how people actually use language; prescriptive grammar dictates how they should use it\",\n    \"explanation\": \"Descriptive grammar observes and documents real language use without judgment (linguists' approach). Prescriptive grammar enforces rules about 'correct' usage (traditional school approach). Example: Descriptive accepts 'they' as singular pronoun; prescriptive may reject it.\",\n    \"difficulty\": 1,\n    \"tags\": [\"grammar\", \"descriptive\", \"prescriptive\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F407\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Ambiguity?\",\n    \"answer\": \"A word, phrase, or passage with multiple possible meanings; can be intentional for effect\",\n    \"explanation\": \"Ambiguity allows multiple interpretations. Can be lexical (word level), syntactic (sentence structure), or semantic (meaning). Authors may use it deliberately for complexity. Example: 'Flying planes can be dangerous' (piloting vs. airborne planes).\",\n    \"difficulty\": 3,\n    \"tags\": [\"ambiguity\", \"multiple meanings\", \"interpretation\"]\n  },\n  {\n    \"id\": \"F408\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Connotation?\",\n    \"answer\": \"Associated or suggested meaning of a word beyond its denotation\",\n    \"explanation\": \"Connotation is the emotional or cultural associations a word carries. Example: 'home' (denotation: residence) has positive connotations of warmth and belonging. Word choice affects tone through connotation.\",\n    \"difficulty\": 1,\n    \"tags\": [\"connotation\", \"word meaning\", \"associations\"]\n  },\n  {\n    \"id\": \"F409\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Figurative Language?\",\n    \"answer\": \"Nonliteral language (metaphor, simile, personification, hyperbole) to create effects\",\n    \"explanation\": \"Figurative Language uses words beyond their literal meanings to create imagery, emphasis, or emotional impact. Includes metaphor, simile, personification, hyperbole, and more. Example: 'Time is a thief' (metaphor).\",\n    \"difficulty\": 1,\n    \"tags\": [\"figurative language\", \"literary devices\", \"metaphor\"]\n  },\n  {\n    \"id\": \"F410\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Irony?\",\n    \"answer\": \"Discrepancy between expectation and reality\",\n    \"explanation\": \"Irony creates contrast between what's expected and what occurs. Types: verbal (saying opposite of meaning), situational (outcome opposite of expected), dramatic (audience knows more than characters). Example: Fire station burns down (situational irony).\",\n    \"difficulty\": 2,\n    \"tags\": [\"irony\", \"verbal\", \"situational\", \"dramatic\"]\n  },\n  {\n    \"id\": \"F411\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Imagery?\",\n    \"answer\": \"Language appealing to the senses to evoke responses in readers\",\n    \"explanation\": \"Imagery uses sensory details (sight, sound, smell, taste, touch) to create vivid mental pictures. Helps readers experience the text emotionally and physically. Example: 'The crisp, golden leaves crunched beneath her feet.'\",\n    \"difficulty\": 1,\n    \"tags\": [\"imagery\", \"sensory details\", \"description\"]\n  },\n  {\n    \"id\": \"F412\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Rhythm & Meter?\",\n    \"answer\": \"Pattern of stressed/unstressed syllables in verse; meter types like iambic pentameter\",\n    \"explanation\": \"Rhythm is the pattern of beats in poetry. Meter is systematic rhythm measured in feet. Example: Iambic pentameter (Shakespeare's favorite) has 5 iambs per line (unstressed-STRESSED). Creates musicality and emphasis.\",\n    \"difficulty\": 3,\n    \"tags\": [\"rhythm\", \"meter\", \"poetry\", \"iambic pentameter\"]\n  },\n  {\n    \"id\": \"F413\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Rhyme?\",\n    \"answer\": \"Repetition of similar sounds, especially at line ends; includes slant rhyme and internal rhyme\",\n    \"explanation\": \"Rhyme repeats similar sounds for musicality and emphasis. Types: end rhyme (line ends), internal rhyme (within lines), slant/near rhyme (similar but not exact sounds). Example: 'cat/hat' (perfect rhyme), 'cat/cot' (slant rhyme).\",\n    \"difficulty\": 2,\n    \"tags\": [\"rhyme\", \"sound patterns\", \"poetry\"]\n  },\n  {\n    \"id\": \"F414\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Characterization?\",\n    \"answer\": \"Methods an author uses to portray character\",\n    \"explanation\": \"Characterization reveals characters through direct description, actions, dialogue, thoughts, and others' reactions. Can be direct (author tells) or indirect (reader infers). Example: Actions revealing bravery show character without stating it directly.\",\n    \"difficulty\": 2,\n    \"tags\": [\"characterization\", \"character development\", \"literary analysis\"]\n  },\n  {\n    \"id\": \"F415\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Plot & Setting?\",\n    \"answer\": \"Plot: sequence of events; Setting: time/place/context framing events and mood\",\n    \"explanation\": \"Plot is the story structure (exposition, rising action, climax, falling action, resolution). Setting establishes when and where events occur, influencing mood and conflict. Example: A story set during war creates tension and limits character choices.\",\n    \"difficulty\": 1,\n    \"tags\": [\"plot\", \"setting\", \"story structure\"]\n  },\n  {\n    \"id\": \"F416\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Tone & Mood?\",\n    \"answer\": \"Tone: author's attitude; Mood: emotional atmosphere experienced by readers\",\n    \"explanation\": \"Tone reflects the author's perspective (humorous, serious, sarcastic). Mood is the feeling evoked in readers (tense, peaceful, melancholy). Word choice, imagery, and syntax create both. Example: Dark imagery creates ominous mood.\",\n    \"difficulty\": 1,\n    \"tags\": [\"tone\", \"mood\", \"atmosphere\", \"style\"]\n  },\n  {\n    \"id\": \"F417\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is a Universal Theme?\",\n    \"answer\": \"Idea of broad human significance recurring across cultures and eras\",\n    \"explanation\": \"Universal Themes address fundamental human experiences: identity, justice, love, mortality, power. They transcend specific contexts and resonate across time and cultures. Example: The hero's journey appears in myths worldwide.\",\n    \"difficulty\": 2,\n    \"tags\": [\"theme\", \"universal\", \"literary analysis\"]\n  },\n  {\n    \"id\": \"F418\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What is Thesis & Support?\",\n    \"answer\": \"A clear, arguable central claim with logically organized, relevant evidence and reasoning\",\n    \"explanation\": \"A thesis states the essay's main argument. Support includes evidence (facts, examples, quotations) and reasoning connecting evidence to the claim. Strong essays have unified paragraphs, transitions, and logical progression.\",\n    \"difficulty\": 2,\n    \"tags\": [\"thesis\", \"argumentation\", \"essay structure\"]\n  },\n  {\n    \"id\": \"F419\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Language Structure, Literary Response, and Expository Writing Techniques\",\n    \"question\": \"What are Expository Structures?\",\n    \"answer\": \"Common patterns: definition, classification, cause–effect, compare–contrast, problem–solution; formats like business letter, news article, formal essay\",\n    \"explanation\": \"Expository writing informs or explains using organizational patterns suited to purpose. Definition explains terms; compare-contrast shows similarities/differences; cause-effect shows relationships. Format matches audience and purpose (business letter for professional communication).\",\n    \"difficulty\": 2,\n    \"tags\": [\"expository writing\", \"organization\", \"text structures\"]\n  }\n  ,\n  {\n    \"id\": \"F601\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What are Context Clues?\",\n    \"answer\": \"Hints within a text that help determine the meaning of unfamiliar words\",\n    \"explanation\": \"Context Clues are surrounding words, phrases, or sentences that help readers infer unknown word meanings. Types include definition, example, synonym, antonym, and inference clues. Essential for vocabulary development.\",\n    \"difficulty\": 1,\n    \"tags\": [\"context clues\", \"vocabulary\", \"reading strategies\"]\n  },\n  {\n    \"id\": \"F602\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Word Structure analysis?\",\n    \"answer\": \"Analysis of prefixes, roots, and suffixes to determine word meaning\",\n    \"explanation\": \"Word Structure analysis breaks words into morphemes (meaningful parts) to understand meanings. Example: 'unhappiness' = un- (not) + happy + -ness (state). Supports vocabulary growth and spelling.\",\n    \"difficulty\": 1,\n    \"tags\": [\"word structure\", \"morphology\", \"vocabulary\"]\n  },\n  {\n    \"id\": \"F603\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Skimming?\",\n    \"answer\": \"A reading technique used to quickly identify main ideas or general meaning\",\n    \"explanation\": \"Skimming involves reading headings, first sentences, and key words to grasp the gist without reading every word. Used for previewing, reviewing, or determining relevance. Improves reading efficiency.\",\n    \"difficulty\": 1,\n    \"tags\": [\"skimming\", \"reading strategies\", \"efficiency\"]\n  },\n  {\n    \"id\": \"F604\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Scanning?\",\n    \"answer\": \"A reading strategy used to locate specific facts or details quickly\",\n    \"explanation\": \"Scanning involves moving eyes rapidly over text to find particular information (names, dates, statistics). Like using Find/Search. Different from skimming (which seeks main ideas). Essential research skill.\",\n    \"difficulty\": 1,\n    \"tags\": [\"scanning\", \"reading strategies\", \"research\"]\n  },\n  {\n    \"id\": \"F605\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Inference?\",\n    \"answer\": \"A logical conclusion drawn from evidence and reasoning rather than explicit statements\",\n    \"explanation\": \"Inference combines textual evidence with prior knowledge to understand implied meanings. Example: 'Her hands trembled' infers nervousness. Critical for comprehension beyond literal level.\",\n    \"difficulty\": 2,\n    \"tags\": [\"inference\", \"critical thinking\", \"comprehension\"]\n  },\n  {\n    \"id\": \"F606\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Summarizing?\",\n    \"answer\": \"Condensing a text to its essential ideas while maintaining its meaning\",\n    \"explanation\": \"Summarizing identifies main ideas and key supporting details, omitting examples and redundancy. Requires distinguishing important from unimportant information. Tests and builds comprehension.\",\n    \"difficulty\": 2,\n    \"tags\": [\"summarizing\", \"main idea\", \"comprehension\"]\n  },\n  {\n    \"id\": \"F607\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What are General vs. Specific Statements?\",\n    \"answer\": \"General statements express broad ideas; specific statements provide supporting details\",\n    \"explanation\": \"General statements make broad claims (topic sentences); specific statements offer examples, facts, or details supporting them. Recognizing this hierarchy aids comprehension and summarization.\",\n    \"difficulty\": 1,\n    \"tags\": [\"text structure\", \"main idea\", \"details\"]\n  },\n  {\n    \"id\": \"F608\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Metacognition?\",\n    \"answer\": \"Thinking about one's own thinking; awareness of comprehension strategies and monitoring understanding\",\n    \"explanation\": \"Metacognition includes planning (setting purpose), monitoring (noticing confusion), and evaluating (checking understanding). Effective readers use metacognitive strategies to regulate comprehension.\",\n    \"difficulty\": 2,\n    \"tags\": [\"metacognition\", \"self-monitoring\", \"strategies\"]\n  },\n  {\n    \"id\": \"F609\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Denotative Meaning?\",\n    \"answer\": \"The literal, dictionary definition of a word\",\n    \"explanation\": \"Denotative Meaning is objective and universal—what a word literally means. Example: 'home' denotes a dwelling place. Contrasts with connotation (emotional associations).\",\n    \"difficulty\": 1,\n    \"tags\": [\"denotation\", \"meaning\", \"vocabulary\"]\n  },\n  {\n    \"id\": \"F610\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Connotative Meaning?\",\n    \"answer\": \"The emotional or associative meaning attached to a word beyond its definition\",\n    \"explanation\": \"Connotative Meaning includes feelings and associations. Example: 'home' connotes warmth, safety, belonging. Understanding connotation is critical for interpreting tone and author's purpose.\",\n    \"difficulty\": 1,\n    \"tags\": [\"connotation\", \"meaning\", \"tone\"]\n  },\n  {\n    \"id\": \"F611\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Prior Knowledge Activation?\",\n    \"answer\": \"Connecting what a reader already knows to new text information to improve comprehension\",\n    \"explanation\": \"Prior Knowledge Activation uses existing knowledge to make sense of new information. Example: KWL charts (Know, Want to know, Learned). Essential for building schema and deepening understanding.\",\n    \"difficulty\": 2,\n    \"tags\": [\"prior knowledge\", \"schema\", \"comprehension\"]\n  },\n  {\n    \"id\": \"F612\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Prediction Strategy?\",\n    \"answer\": \"Anticipating what will happen next in a text to maintain engagement and comprehension\",\n    \"explanation\": \"Prediction Strategy uses textual clues and prior knowledge to forecast outcomes. Keeps readers engaged, aids comprehension monitoring. Predictions should be confirmed or revised as reading continues.\",\n    \"difficulty\": 2,\n    \"tags\": [\"prediction\", \"engagement\", \"comprehension\"]\n  },\n  {\n    \"id\": \"F613\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Audience and Purpose?\",\n    \"answer\": \"Understanding whom a text targets and why it was written, key to critical reading\",\n    \"explanation\": \"Audience (intended readers) and Purpose (inform, persuade, entertain) shape every writing choice. Identifying these helps readers evaluate effectiveness and detect bias.\",\n    \"difficulty\": 2,\n    \"tags\": [\"audience\", \"purpose\", \"critical reading\"]\n  },\n  {\n    \"id\": \"F614\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Persuasive Strategy?\",\n    \"answer\": \"A rhetorical method used to influence audience beliefs or actions\",\n    \"explanation\": \"Persuasive Strategies include ethos (credibility), pathos (emotion), and logos (logic). Also includes rhetorical questions, repetition, and appeals to values. Critical for analyzing arguments.\",\n    \"difficulty\": 2,\n    \"tags\": [\"persuasion\", \"rhetoric\", \"argumentation\"]\n  },\n  {\n    \"id\": \"F615\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Fact vs. Opinion?\",\n    \"answer\": \"Facts are verifiable; opinions reflect beliefs or interpretations\",\n    \"explanation\": \"Facts can be proven true or false (Earth orbits Sun). Opinions express judgments (Summer is the best season). Critical readers distinguish between them to evaluate claims.\",\n    \"difficulty\": 1,\n    \"tags\": [\"fact\", \"opinion\", \"critical thinking\"]\n  },\n  {\n    \"id\": \"F616\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Source Credibility?\",\n    \"answer\": \"Evaluation of an author's expertise, evidence quality, and objectivity\",\n    \"explanation\": \"Source Credibility considers author qualifications, evidence (research, data), objectivity, and publisher reputation. Essential for evaluating information reliability, especially online.\",\n    \"difficulty\": 2,\n    \"tags\": [\"credibility\", \"evaluation\", \"sources\"]\n  },\n  {\n    \"id\": \"F617\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Bias?\",\n    \"answer\": \"A predisposition or prejudice that influences perspective or presentation of information\",\n    \"explanation\": \"Bias is favoritism toward one side, often unconscious. Detected through word choice, omitted information, and source selection. All texts have some bias—critical readers recognize and account for it.\",\n    \"difficulty\": 2,\n    \"tags\": [\"bias\", \"critical reading\", \"perspective\"]\n  },\n  {\n    \"id\": \"F618\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Tone and Style?\",\n    \"answer\": \"Tone reflects the author's attitude; style refers to the author's language choices and structure\",\n    \"explanation\": \"Tone (formal, humorous, sarcastic) reveals author's attitude. Style includes diction, syntax, imagery, and structure. Both shape meaning and reader response.\",\n    \"difficulty\": 2,\n    \"tags\": [\"tone\", \"style\", \"author's craft\"]\n  },\n  {\n    \"id\": \"F619\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Reader Response Theory?\",\n    \"answer\": \"Meaning arises from the reader's interpretation and personal engagement with a text\",\n    \"explanation\": \"Reader Response Theory emphasizes readers' active role in creating meaning. Personal experiences, beliefs, and contexts shape interpretation. Validates diverse readings and encourages reflection.\",\n    \"difficulty\": 2,\n    \"tags\": [\"reader response\", \"interpretation\", \"theory\"]\n  },\n  {\n    \"id\": \"F620\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is a Reading Journal?\",\n    \"answer\": \"A tool for recording personal responses, reflections, and interpretations of texts\",\n    \"explanation\": \"Reading Journals capture thoughts, questions, connections, and reactions during/after reading. Supports metacognition, deepens comprehension, and documents intellectual growth.\",\n    \"difficulty\": 1,\n    \"tags\": [\"reading journal\", \"reflection\", \"response\"]\n  },\n  {\n    \"id\": \"F621\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Writing to Learn?\",\n    \"answer\": \"Using writing (journals, logs, essays) to clarify thinking and connect ideas across disciplines\",\n    \"explanation\": \"Writing to Learn uses informal writing to process information, not just demonstrate knowledge. Includes quick writes, reflective journals, concept maps. Deepens understanding in all subjects.\",\n    \"difficulty\": 2,\n    \"tags\": [\"writing to learn\", \"reflection\", \"cross-curricular\"]\n  },\n  {\n    \"id\": \"F622\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Inquiry Writing?\",\n    \"answer\": \"Writing that generates authentic questions, explores problems, and reflects on learning\",\n    \"explanation\": \"Inquiry Writing begins with genuine curiosity, not prescribed topics. Students pose questions, research, analyze findings, and reflect. Promotes critical thinking and authentic engagement.\",\n    \"difficulty\": 2,\n    \"tags\": [\"inquiry\", \"research\", \"critical thinking\"]\n  },\n  {\n    \"id\": \"F623\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Visual Communication?\",\n    \"answer\": \"Conveying information through images, charts, graphs, videos, or performance\",\n    \"explanation\": \"Visual Communication uses non-textual modes to convey meaning. Includes infographics, diagrams, photos, videos. Often more immediate and accessible than text alone. Essential 21st century literacy.\",\n    \"difficulty\": 2,\n    \"tags\": [\"visual communication\", \"multimodal\", \"media\"]\n  },\n  {\n    \"id\": \"F624\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Media Literacy?\",\n    \"answer\": \"The ability to analyze, evaluate, and create media messages in various forms\",\n    \"explanation\": \"Media Literacy includes understanding how media is constructed, purposes, techniques, and effects. Enables critical consumption and ethical production of media. Essential for navigating information age.\",\n    \"difficulty\": 2,\n    \"tags\": [\"media literacy\", \"critical thinking\", \"evaluation\"]\n  },\n  {\n    \"id\": \"F625\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What are Propaganda Techniques?\",\n    \"answer\": \"Methods used to manipulate opinion—bandwagon, testimonial, glittering generalities, fear appeal\",\n    \"explanation\": \"Propaganda Techniques influence without full information or critical thought. Bandwagon (everyone's doing it), testimonial (celebrity endorsement), fear appeal (threats). Recognizing these protects against manipulation.\",\n    \"difficulty\": 2,\n    \"tags\": [\"propaganda\", \"manipulation\", \"critical thinking\"]\n  },\n  {\n    \"id\": \"F626\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Multimodal Communication?\",\n    \"answer\": \"Using combinations of text, sound, and visuals to communicate meaning\",\n    \"explanation\": \"Multimodal Communication integrates multiple modes (linguistic, visual, audio, gestural, spatial) simultaneously. Example: Video combines narration, images, music. Richer than single-mode communication.\",\n    \"difficulty\": 2,\n    \"tags\": [\"multimodal\", \"communication\", \"integration\"]\n  },\n  {\n    \"id\": \"F627\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Critical Evaluation of Media?\",\n    \"answer\": \"Assessing media messages for accuracy, bias, purpose, and effect on public perception\",\n    \"explanation\": \"Critical Evaluation of Media questions who created it, why, what techniques are used, what's included/omitted, and whose interests are served. Essential for informed citizenship in media-saturated world.\",\n    \"difficulty\": 2,\n    \"tags\": [\"critical evaluation\", \"media\", \"analysis\"]\n  },\n  {\n    \"id\": \"F628\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Charts and Graphs Interpretation?\",\n    \"answer\": \"Extracting and analyzing meaning from visual data representations\",\n    \"explanation\": \"Charts and Graphs Interpretation requires understanding axes, scales, labels, and data relationships. Skills include identifying trends, comparing values, and drawing conclusions. Critical for informational literacy.\",\n    \"difficulty\": 2,\n    \"tags\": [\"data interpretation\", \"graphs\", \"visual literacy\"]\n  },\n  {\n    \"id\": \"F629\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Reading Strategies, Critical Analysis, Reader Response, Cross-Curricular Writing, and Media Literacy\",\n    \"question\": \"What is Synergy in Media?\",\n    \"answer\": \"Combined media elements (image + text + sound) that reinforce one another's message\",\n    \"explanation\": \"Synergy in Media occurs when multiple modes work together to create meaning greater than the sum of parts. Example: Documentary using interview (audio), archival photos (visual), captions (text) together for powerful effect.\",\n    \"difficulty\": 3,\n    \"tags\": [\"synergy\", \"media\", \"integration\"]\n  },\n  {\n    \"id\": \"F630\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"History and development of the English language\",\n    \"question\": \"What was the primary influence on Old English vocabulary?\",\n    \"answer\": \"Norse vocabulary introduced through Viking contact\",\n    \"explanation\": \"The Viking invasions infused Old English with Norse loanwords like 'sky,' 'egg,' and 'window,' shaping northern dialects. These words became permanent features of English.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Old English\", \"Norse\", \"Viking\", \"language history\"]\n  },\n  {\n    \"id\": \"F631\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"History and development of the English language\",\n    \"question\": \"What event most contributed to standardizing English spelling and grammar?\",\n    \"answer\": \"The introduction of the printing press by William Caxton in 1476\",\n    \"explanation\": \"The printing press made written English more uniform and spread London's dialect as a standard. Mass production of texts required consistent spelling conventions.\",\n    \"difficulty\": 2,\n    \"tags\": [\"printing press\", \"standardization\", \"Caxton\"]\n  },\n  {\n    \"id\": \"F632\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"History and development of the English language\",\n    \"question\": \"How did global expansion influence English vocabulary?\",\n    \"answer\": \"Colonial contact introduced loanwords from Hindi, Arabic, Swahili, and other languages\",\n    \"explanation\": \"Global expansion gave English words like 'bungalow' (Hindi), 'algebra' (Arabic), and 'safari' (Swahili), demonstrating English's ability to absorb vocabulary from worldwide contact.\",\n    \"difficulty\": 2,\n    \"tags\": [\"colonialism\", \"loanwords\", \"global English\"]\n  },\n  {\n    \"id\": \"F633\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"History and development of the English language\",\n    \"question\": \"What caused the divergence of British and American English spelling?\",\n    \"answer\": \"Noah Webster's dictionary reforms\",\n    \"explanation\": \"Webster intentionally simplified spellings—'color' vs. 'colour,' 'center' vs. 'centre'—to promote linguistic independence in the new American nation.\",\n    \"difficulty\": 2,\n    \"tags\": [\"American English\", \"Webster\", \"spelling reform\"]\n  },\n  {\n    \"id\": \"F634\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"History and development of the English language\",\n    \"question\": \"What caused rapid vocabulary expansion in the 20th century?\",\n    \"answer\": \"Technological and scientific innovation\",\n    \"explanation\": \"Modern inventions created terms like 'television,' 'internet,' 'genetic code,' and 'smartphone.' Science and technology drive the most rapid vocabulary growth in contemporary English.\",\n    \"difficulty\": 2,\n    \"tags\": [\"20th century\", \"technology\", \"vocabulary\"]\n  },\n  {\n    \"id\": \"F635\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"History and development of the English language\",\n    \"question\": \"How do social movements shape language?\",\n    \"answer\": \"They influence evolving norms like gender-inclusive pronouns (singular 'they')\",\n    \"explanation\": \"Contemporary social awareness drives language change. The acceptance of singular 'they' for non-binary individuals shows how identity and expression movements reshape usage norms.\",\n    \"difficulty\": 2,\n    \"tags\": [\"social movements\", \"pronouns\", \"language change\"]\n  },\n  {\n    \"id\": \"F636\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"History and development of the English language\",\n    \"question\": \"What demonstrates English as a living, evolving language?\",\n    \"answer\": \"The emergence of internet slang and new verb forms like 'to google'\",\n    \"explanation\": \"Digital communication continuously produces new vocabulary and usage patterns. Words like 'google,' 'tweet,' and 'selfie' show language adapting to technological change.\",\n    \"difficulty\": 2,\n    \"tags\": [\"living language\", \"internet\", \"neologisms\"]\n  },\n  {\n    \"id\": \"F637\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"History and development of the English language\",\n    \"question\": \"How do regional dialects develop?\",\n    \"answer\": \"Through isolation and distinct cultural contact patterns\",\n    \"explanation\": \"Geography, migration, and community interaction create region-specific pronunciations and idioms. Dialects reflect local history, settlement patterns, and cultural influences.\",\n    \"difficulty\": 2,\n    \"tags\": [\"dialects\", \"regional variation\", \"language geography\"]\n  },\n  {\n    \"id\": \"F638\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"History and development of the English language\",\n    \"question\": \"What does Harlem Renaissance writing demonstrate about language?\",\n    \"answer\": \"Creative adaptation of vernacular speech to convey cultural identity\",\n    \"explanation\": \"Writers like Langston Hughes and Zora Neale Hurston blended African American vernacular with literary English to express cultural voice and authenticity, showing language as identity.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Harlem Renaissance\", \"vernacular\", \"cultural identity\"]\n  },\n  {\n    \"id\": \"F639\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"History and development of the English language\",\n    \"question\": \"What are 'World Englishes'?\",\n    \"answer\": \"Localized varieties of English shaped by regional and cultural factors\",\n    \"explanation\": \"'World Englishes' recognizes that British, Indian, Nigerian, and Singaporean English are all legitimate, evolving varieties. Each reflects local linguistic and cultural influences.\",\n    \"difficulty\": 2,\n    \"tags\": [\"World Englishes\", \"linguistic diversity\", \"varieties\"]\n  },\n  {\n    \"id\": \"F640\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Understanding the purposes and values of teaching literature\",\n    \"question\": \"What is the primary educational purpose of pairing multicultural novels like The Joy Luck Club, Bless Me, Ultima, and The Namesake?\",\n    \"answer\": \"To explore the experiences of cultural identity and assimilation in the United States\",\n    \"explanation\": \"Each novel portrays generational and cultural negotiation, making them ideal for discussing themes of identity and assimilation. This pairing helps students understand diverse cultural perspectives and experiences.\",\n    \"difficulty\": 2,\n    \"tags\": [\"multicultural literature\", \"cultural identity\", \"assimilation\", \"teaching literature\"]\n  },\n  {\n    \"id\": \"F641\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Understanding the purposes and values of teaching literature\",\n    \"question\": \"Why would a teacher pair The Diary of Anne Frank with Night by Elie Wiesel?\",\n    \"answer\": \"To examine personal and historical perspectives on human rights and moral courage\",\n    \"explanation\": \"Pairing survivor accounts helps students connect literature to ethical and historical understanding. These texts provide different viewpoints on the Holocaust, fostering empathy and critical thinking about human rights.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Holocaust literature\", \"human rights\", \"moral courage\", \"teaching literature\"]\n  },\n  {\n    \"id\": \"F642\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Understanding the purposes and values of teaching literature\",\n    \"question\": \"What is the main instructional benefit of comparing Their Eyes Were Watching God with modern spoken-word poetry?\",\n    \"answer\": \"To identify social commentary on gender and voice across time periods\",\n    \"explanation\": \"This comparison links historical and contemporary expressions of autonomy and voice, illustrating literature's social purpose. Students can see how themes of empowerment and self-expression evolve across different forms and eras.\",\n    \"difficulty\": 2,\n    \"tags\": [\"thematic comparison\", \"gender\", \"voice\", \"literary purpose\"]\n  },\n  {\n    \"id\": \"F643\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Understanding the purposes and values of teaching literature\",\n    \"question\": \"What is the main purpose of a 'Literature of Place' unit featuring environmental writers like Mary Oliver and Wendell Berry?\",\n    \"answer\": \"To connect students' reading to ecological awareness and personal reflection\",\n    \"explanation\": \"This thematic unit integrates literature with environmental ethics and reflective thinking. It helps students develop awareness of humanity's relationship with nature while encouraging personal connections to place.\",\n    \"difficulty\": 2,\n    \"tags\": [\"environmental literature\", \"place-based learning\", \"ecological awareness\", \"teaching literature\"]\n  },\n  {\n    \"id\": \"F644\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Understanding the purposes and values of teaching literature\",\n    \"question\": \"Why would a teacher compare Things Fall Apart by Chinua Achebe with early British colonial novels?\",\n    \"answer\": \"To expose students to non-Western viewpoints and post-colonial themes\",\n    \"explanation\": \"Achebe's work reclaims narrative authority, showing literature's power to challenge dominant cultural perspectives. This comparison helps students understand colonialism from multiple viewpoints and recognize how literature shapes historical narratives.\",\n    \"difficulty\": 2,\n    \"tags\": [\"post-colonial literature\", \"cultural perspectives\", \"narrative authority\", \"teaching literature\"]\n  },\n  {\n    \"id\": \"F645\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"World Literature in English, exclusive of North America\",\n    \"question\": \"What is the primary purpose of Emily Brontë's use of multiple narrators and non-linear structure in Wuthering Heights?\",\n    \"answer\": \"To present differing psychological perspectives that complicate moral judgment\",\n    \"explanation\": \"Brontë's framing devices (Lockwood and Nelly) invite readers to weigh conflicting viewpoints, deepening the novel's moral ambiguity. This narrative technique creates layers of interpretation and challenges readers to form their own moral conclusions.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Wuthering Heights\", \"Emily Brontë\", \"narrative structure\", \"multiple narrators\", \"moral ambiguity\"]\n  },\n  {\n    \"id\": \"F646\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"World Literature in English, exclusive of North America\",\n    \"question\": \"How does Elizabeth Gaskell's North and South address industrialization and class conflict?\",\n    \"answer\": \"It integrates social realism with moral sympathy to critique economic inequality\",\n    \"explanation\": \"Gaskell's realist approach humanizes labor issues and bridges moral and social commentary—an early example of industrial fiction. She combines detailed observation of working-class life with empathetic storytelling to awaken social conscience.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Elizabeth Gaskell\", \"North and South\", \"industrialization\", \"social realism\", \"Victorian literature\"]\n  },\n  {\n    \"id\": \"F647\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"World Literature in English, exclusive of North America\",\n    \"question\": \"Why was Charlotte Brontë's Jane Eyre considered groundbreaking among nineteenth-century novels?\",\n    \"answer\": \"It depicted a female protagonist whose moral and emotional autonomy challenge Victorian gender norms\",\n    \"explanation\": \"Jane's insistence on self-respect and conscience makes the novel an early feminist and psychological narrative. She refuses to compromise her values for love or social status, asserting her right to independence and moral agency.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Charlotte Brontë\", \"Jane Eyre\", \"feminism\", \"Victorian gender norms\", \"female autonomy\"]\n  },\n  {\n    \"id\": \"F648\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"World Literature in English, exclusive of North America\",\n    \"question\": \"How does Emily Brontë's depiction of nature in Wuthering Heights differ from typical Romantic literature?\",\n    \"answer\": \"It presents the natural world as indifferent or violent rather than purely inspiring\",\n    \"explanation\": \"Her wild moorland setting mirrors the intensity of human passion and cruelty—nature as emotional landscape, not idyllic refuge. Unlike Romantic idealization of nature as a source of transcendence, Brontë's nature reflects raw human emotion and conflict.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Wuthering Heights\", \"Emily Brontë\", \"nature imagery\", \"Romanticism\", \"Gothic literature\"]\n  },\n  {\n    \"id\": \"F649\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"World Literature in English, exclusive of North America\",\n    \"question\": \"Why does Elizabeth Gaskell combine sentimental narrative techniques with journalistic observation in Mary Barton?\",\n    \"answer\": \"To appeal to middle-class readers' empathy for working-class suffering\",\n    \"explanation\": \"Gaskell uses empathy and realism to awaken social conscience among her readership—hallmarks of early social-problem fiction. This blend makes the industrial struggles accessible and emotionally resonant to readers unfamiliar with factory life.\",\n    \"difficulty\": 2,\n    \"tags\": [\"Elizabeth Gaskell\", \"Mary Barton\", \"social conscience\", \"social-problem fiction\", \"Victorian literature\"]\n  },\n  {\n    \"id\": \"F650\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"English syntax and sentence structure\",\n    \"question\": \"What makes the sentence 'They the park quickly across ran' incorrect?\",\n    \"answer\": \"It violates English syntax by scrambling normal word order (subject–verb–object)\",\n    \"explanation\": \"Standard English syntax follows subject–verb–object order. The correct version would be 'They ran quickly across the park.' Scrambling word order creates ungrammatical sentences that violate English conventions.\",\n    \"difficulty\": 1,\n    \"tags\": [\"syntax\", \"word order\", \"sentence structure\", \"grammar\"]\n  },\n  {\n    \"id\": \"F651\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Parallel structure and sentence coherence\",\n    \"question\": \"What is faulty parallel structure and why is 'She enjoys dancing, to swim, and playing tennis' incorrect?\",\n    \"answer\": \"Parallel structure requires consistent grammatical forms; this mixes gerunds with an infinitive\",\n    \"explanation\": \"Parallel structure means using the same grammatical pattern for items in a series. The correct version would be 'She enjoys dancing, swimming, and playing tennis' (all gerunds) or 'She likes to dance, to swim, and to play tennis' (all infinitives).\",\n    \"difficulty\": 2,\n    \"tags\": [\"parallel structure\", \"grammar\", \"consistency\", \"sentence structure\"]\n  },\n  {\n    \"id\": \"F652\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Sentence fragments and complete sentences\",\n    \"question\": \"What is a sentence fragment and why is 'Because she was late to the meeting' incomplete?\",\n    \"answer\": \"A fragment is a dependent clause without a main clause; this needs an independent clause to be complete\",\n    \"explanation\": \"A sentence fragment lacks a complete thought. 'Because she was late to the meeting' is a dependent clause that needs a main clause, like 'Because she was late to the meeting, she missed the announcement.' Dependent clauses cannot stand alone.\",\n    \"difficulty\": 2,\n    \"tags\": [\"sentence fragments\", \"dependent clauses\", \"complete sentences\", \"grammar\"]\n  },\n  {\n    \"id\": \"F653\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Modifiers and clarity\",\n    \"question\": \"What is a misplaced modifier and what's wrong with 'The teacher handed the papers to the students on the desk'?\",\n    \"answer\": \"'On the desk' incorrectly modifies 'students' instead of 'papers', creating confusion about what's on the desk\",\n    \"explanation\": \"A misplaced modifier is positioned incorrectly, causing ambiguity or illogical meaning. The sentence suggests students are on the desk. The correct version would be 'The teacher handed the papers on the desk to the students' or 'The teacher handed to the students the papers on the desk.'\",\n    \"difficulty\": 2,\n    \"tags\": [\"misplaced modifiers\", \"clarity\", \"grammar\", \"sentence structure\"]\n  },\n  {\n    \"id\": \"F654\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Structural ambiguity and coordination\",\n    \"question\": \"What makes 'She told him she loved her cat and so did he' structurally ambiguous?\",\n    \"answer\": \"The coordination creates ambiguity: did he also tell her, or did he also love her cat?\",\n    \"explanation\": \"Structural ambiguity occurs when sentence structure allows multiple interpretations. 'So did he' could mean 'he also told her' or 'he also loved her cat.' Clear writing avoids such ambiguity through careful coordination and punctuation.\",\n    \"difficulty\": 2,\n    \"tags\": [\"structural ambiguity\", \"coordination\", \"clarity\", \"sentence structure\"]\n  },\n  {\n    \"id\": \"F655\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Morphology and word structure\",\n    \"question\": \"What are bound morphemes and why does 'unbelievable' contain two of them?\",\n    \"answer\": \"'Un-' and '-able' are both bound morphemes that cannot stand alone; they attach to the free base 'believe'\",\n    \"explanation\": \"Bound morphemes are meaningful units that must attach to other morphemes. In 'unbelievable,' 'un-' (negation prefix) and '-able' (adjective-forming suffix) are bound to the free morpheme 'believe.' Neither can function independently as words.\",\n    \"difficulty\": 2,\n    \"tags\": [\"morphology\", \"bound morphemes\", \"word structure\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F656\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Inflectional vs. derivational morphology\",\n    \"question\": \"What is inflectional morphology and why is 'walk → walked' an example?\",\n    \"answer\": \"Inflectional morphology changes grammatical function without changing core meaning; '-ed' marks past tense\",\n    \"explanation\": \"Inflectional morphemes modify grammatical features (tense, number, case) without creating new words or changing word class. 'Walked' is still a verb meaning 'to walk,' just in past tense. This differs from derivational morphology, which creates new words.\",\n    \"difficulty\": 2,\n    \"tags\": [\"inflectional morphology\", \"grammar\", \"tense\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F657\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Syntactic ambiguity\",\n    \"question\": \"Why is 'Visiting relatives can be exhausting' syntactically ambiguous?\",\n    \"answer\": \"'Visiting relatives' can be a noun phrase (the act of visiting) or a participial phrase (relatives who visit)\",\n    \"explanation\": \"Syntactic ambiguity occurs when phrase structure allows multiple interpretations. This sentence could mean: (1) the act of visiting relatives is exhausting, or (2) relatives who are visiting you are exhausting. The phrase structure permits both readings.\",\n    \"difficulty\": 2,\n    \"tags\": [\"syntactic ambiguity\", \"phrase structure\", \"linguistics\", \"grammar\"]\n  },\n  {\n    \"id\": \"F658\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Derivational morphology\",\n    \"question\": \"What is derivational morphology and why is 'happy → unhappy' an example?\",\n    \"answer\": \"Derivational morphology creates new words with changed meanings; 'un-' transforms the meaning of 'happy'\",\n    \"explanation\": \"Derivational morphemes create new words by changing meaning or word class. Adding 'un-' to 'happy' creates a word with opposite meaning. Unlike inflectional morphemes (which only add grammatical information), derivational changes are more fundamental and create distinct lexical items.\",\n    \"difficulty\": 2,\n    \"tags\": [\"derivational morphology\", \"word formation\", \"prefixes\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F659\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Semantic agreement\",\n    \"question\": \"What is semantic agreement and why does 'The thunder laughed across the sky' violate it?\",\n    \"answer\": \"Semantic agreement requires logical relationships between subject and predicate; thunder cannot literally laugh\",\n    \"explanation\": \"Semantic agreement ensures that predicates are logically compatible with their subjects. Thunder (an atmospheric sound) cannot perform the human action of laughing—this is a semantic mismatch. While acceptable as figurative language (personification), it violates literal semantic agreement.\",\n    \"difficulty\": 2,\n    \"tags\": [\"semantic agreement\", \"subject-predicate\", \"personification\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F660\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Phonological concepts\",\n    \"question\": \"What is a phoneme?\",\n    \"answer\": \"Smallest sound unit that changes meaning\",\n    \"explanation\": \"Minimal sound unit that distinguishes words. Example: /k/ in 'cat' vs. /b/ in 'bat'.\",\n    \"difficulty\": 1,\n    \"tags\": [\"phoneme\", \"phonology\", \"sound\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F661\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Phonological concepts\",\n    \"question\": \"What is a grapheme?\",\n    \"answer\": \"Written letter(s) representing a sound\",\n    \"explanation\": \"Written symbol for a phoneme. Example: 'ph' in 'phone' = /f/ sound.\",\n    \"difficulty\": 1,\n    \"tags\": [\"grapheme\", \"phonology\", \"writing system\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F662\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Phonological concepts\",\n    \"question\": \"What is a digraph?\",\n    \"answer\": \"Two letters making one sound\",\n    \"explanation\": \"Letter pair representing single phoneme. Examples: 'sh' (ship), 'ch' (chair), 'th' (think).\",\n    \"difficulty\": 1,\n    \"tags\": [\"digraph\", \"phonology\", \"spelling\", \"literacy\"]\n  },\n  {\n    \"id\": \"F663\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Phonological concepts\",\n    \"question\": \"What is an allophone?\",\n    \"answer\": \"Variant pronunciation of same phoneme\",\n    \"explanation\": \"Different sounds of one phoneme based on context. Example: /p/ in 'spin' vs. 'pin' (aspirated).\",\n    \"difficulty\": 2,\n    \"tags\": [\"allophone\", \"phonology\", \"pronunciation\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F664\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Phonological concepts\",\n    \"question\": \"What is prosody?\",\n    \"answer\": \"Rhythm, stress, and intonation in speech\",\n    \"explanation\": \"How pitch, rhythm, and stress convey meaning. Example: 'You're going?' (rising = question).\",\n    \"difficulty\": 2,\n    \"tags\": [\"prosody\", \"intonation\", \"stress\", \"phonology\"]\n  },\n  {\n    \"id\": \"F665\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Morphological concepts\",\n    \"question\": \"What is a morpheme?\",\n    \"answer\": \"Smallest unit of meaning\",\n    \"explanation\": \"Minimal meaningful unit. Example: 'unkindly' = un- (not) + kind + -ly (manner) = 3 morphemes.\",\n    \"difficulty\": 1,\n    \"tags\": [\"morpheme\", \"morphology\", \"meaning\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F666\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Morphological concepts\",\n    \"question\": \"What is a free morpheme?\",\n    \"answer\": \"Morpheme that stands alone as a word\",\n    \"explanation\": \"Independent unit functioning as complete word. Examples: book, run, blue.\",\n    \"difficulty\": 1,\n    \"tags\": [\"free morpheme\", \"morphology\", \"word formation\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F667\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Morphological concepts\",\n    \"question\": \"What is a bound morpheme?\",\n    \"answer\": \"Morpheme that must attach to another\",\n    \"explanation\": \"Cannot stand alone. Must attach to roots. Examples: -ed, un-, -s.\",\n    \"difficulty\": 1,\n    \"tags\": [\"bound morpheme\", \"morphology\", \"affixes\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F668\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Morphological concepts\",\n    \"question\": \"What is a root or base?\",\n    \"answer\": \"Main meaning carrier of a word\",\n    \"explanation\": \"Core morpheme with primary meaning. Example: 'struct' in construct, structure, destruction.\",\n    \"difficulty\": 1,\n    \"tags\": [\"root\", \"base\", \"morphology\", \"word formation\"]\n  },\n  {\n    \"id\": \"F669\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Morphological concepts\",\n    \"question\": \"What is a prefix?\",\n    \"answer\": \"Morpheme added to word beginning\",\n    \"explanation\": \"Bound morpheme before root. Examples: un- (unhappy), re- (rewrite), pre- (preview).\",\n    \"difficulty\": 1,\n    \"tags\": [\"prefix\", \"morphology\", \"affixes\", \"word formation\"]\n  },\n  {\n    \"id\": \"F670\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Morphological concepts\",\n    \"question\": \"What is a suffix?\",\n    \"answer\": \"Morpheme added to word end\",\n    \"explanation\": \"Bound morpheme after root. Examples: -ness (happiness), -ed (walked), -ly (quickly).\",\n    \"difficulty\": 1,\n    \"tags\": [\"suffix\", \"morphology\", \"affixes\", \"word formation\"]\n  },\n  {\n    \"id\": \"F671\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Morphological concepts\",\n    \"question\": \"What is inflection?\",\n    \"answer\": \"Grammatical change without new word\",\n    \"explanation\": \"Marks tense, number, comparison. Examples: talk→talked, cat→cats, big→bigger.\",\n    \"difficulty\": 2,\n    \"tags\": [\"inflection\", \"morphology\", \"grammar\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F672\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Morphological concepts\",\n    \"question\": \"What is derivation?\",\n    \"answer\": \"Creating new word or word class\",\n    \"explanation\": \"Changes meaning or part of speech. Example: happy (adj) → happiness (noun).\",\n    \"difficulty\": 2,\n    \"tags\": [\"derivation\", \"morphology\", \"word formation\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F673\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Lexical and semantic concepts\",\n    \"question\": \"What is a lexicon?\",\n    \"answer\": \"Total vocabulary of language or speaker\",\n    \"explanation\": \"Complete word inventory. Example: engineer's lexicon includes torque, gear ratio, voltage.\",\n    \"difficulty\": 1,\n    \"tags\": [\"lexicon\", \"vocabulary\", \"semantics\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F674\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Lexical and semantic concepts\",\n    \"question\": \"What is semantics?\",\n    \"answer\": \"Study of meaning in language\",\n    \"explanation\": \"Examines how words convey meaning. Example: 'child' and 'offspring' have similar denotations but different connotations.\",\n    \"difficulty\": 1,\n    \"tags\": [\"semantics\", \"meaning\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F675\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Lexical and semantic concepts\",\n    \"question\": \"What is denotation?\",\n    \"answer\": \"Literal dictionary meaning\",\n    \"explanation\": \"Objective definition without emotion. Example: 'snake' = limbless reptile.\",\n    \"difficulty\": 1,\n    \"tags\": [\"denotation\", \"semantics\", \"meaning\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F676\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Lexical and semantic concepts\",\n    \"question\": \"What is connotation?\",\n    \"answer\": \"Emotional or cultural associations\",\n    \"explanation\": \"Feelings beyond literal meaning. Example: 'snake' can connote danger or deceit.\",\n    \"difficulty\": 1,\n    \"tags\": [\"connotation\", \"semantics\", \"meaning\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F677\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Lexical and semantic concepts\",\n    \"question\": \"What is polysemy?\",\n    \"answer\": \"One word with multiple related meanings\",\n    \"explanation\": \"Single word, several related senses. Example: 'light' (illumination or not heavy).\",\n    \"difficulty\": 2,\n    \"tags\": [\"polysemy\", \"semantics\", \"multiple meanings\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F678\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Lexical and semantic concepts\",\n    \"question\": \"What is a homophone?\",\n    \"answer\": \"Words sounding alike, different meaning\",\n    \"explanation\": \"Same sound, different spelling/meaning. Examples: flour/flower, there/their/they're.\",\n    \"difficulty\": 1,\n    \"tags\": [\"homophone\", \"semantics\", \"spelling\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F679\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Lexical and semantic concepts\",\n    \"question\": \"What is collocation?\",\n    \"answer\": \"Words commonly occurring together\",\n    \"explanation\": \"Habitual word pairs. Example: 'make a decision' (not 'do a decision'), 'heavy rain'.\",\n    \"difficulty\": 2,\n    \"tags\": [\"collocation\", \"semantics\", \"word combinations\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F680\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Syntactic concepts\",\n    \"question\": \"What is syntax?\",\n    \"answer\": \"Rules for word order and sentence structure\",\n    \"explanation\": \"Governs word arrangement. English uses Subject–Verb–Object: 'The cat chased the mouse.'\",\n    \"difficulty\": 1,\n    \"tags\": [\"syntax\", \"sentence structure\", \"grammar\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F681\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Syntactic concepts\",\n    \"question\": \"What is a clause?\",\n    \"answer\": \"Group with subject and verb\",\n    \"explanation\": \"Contains subject and predicate. Can be independent or dependent. Example: 'Because it rained.'\",\n    \"difficulty\": 1,\n    \"tags\": [\"clause\", \"syntax\", \"grammar\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F682\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Syntactic concepts\",\n    \"question\": \"What is a phrase?\",\n    \"answer\": \"Group lacking subject and verb\",\n    \"explanation\": \"Meaningful word group without subject-verb. Examples: 'in the morning,' 'the old house.'\",\n    \"difficulty\": 1,\n    \"tags\": [\"phrase\", \"syntax\", \"grammar\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F683\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Syntactic concepts\",\n    \"question\": \"What is parallelism?\",\n    \"answer\": \"Repeated grammatical structures\",\n    \"explanation\": \"Same form in series. Example: 'She likes hiking, swimming, biking' (all gerunds).\",\n    \"difficulty\": 2,\n    \"tags\": [\"parallelism\", \"syntax\", \"grammar\", \"style\"]\n  },\n  {\n    \"id\": \"F684\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Syntactic concepts\",\n    \"question\": \"What is syntactic ambiguity?\",\n    \"answer\": \"Structure allows multiple interpretations\",\n    \"explanation\": \"Sentence permits two+ meanings. Example: 'Visiting relatives can be exhausting.'\",\n    \"difficulty\": 2,\n    \"tags\": [\"ambiguity\", \"syntax\", \"multiple meanings\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F685\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Pragmatic concepts\",\n    \"question\": \"What is pragmatics?\",\n    \"answer\": \"How context affects meaning\",\n    \"explanation\": \"Context influences interpretation. Example: 'Can you open the window?' = polite request.\",\n    \"difficulty\": 2,\n    \"tags\": [\"pragmatics\", \"context\", \"meaning\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F686\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Pragmatic concepts\",\n    \"question\": \"What is register?\",\n    \"answer\": \"Level of formality or style\",\n    \"explanation\": \"Language variety by context. Examples: 'What's up?' (informal), 'How do you do?' (formal).\",\n    \"difficulty\": 1,\n    \"tags\": [\"register\", \"formality\", \"pragmatics\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F687\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Pragmatic concepts\",\n    \"question\": \"What is code-switching?\",\n    \"answer\": \"Shifting language by audience/context\",\n    \"explanation\": \"Alternating dialects or registers. Example: slang with friends, formal in class.\",\n    \"difficulty\": 2,\n    \"tags\": [\"code-switching\", \"pragmatics\", \"sociolinguistics\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F688\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Pragmatic concepts\",\n    \"question\": \"What is discourse?\",\n    \"answer\": \"Connected language beyond single sentence\",\n    \"explanation\": \"Extended communication: conversations, essays, speeches.\",\n    \"difficulty\": 1,\n    \"tags\": [\"discourse\", \"pragmatics\", \"communication\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F689\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Pragmatic concepts\",\n    \"question\": \"What is a speech act?\",\n    \"answer\": \"Utterance performing communicative function\",\n    \"explanation\": \"Words that do something. Examples: promising ('I promise'), apologizing ('I'm sorry').\",\n    \"difficulty\": 2,\n    \"tags\": [\"speech act\", \"pragmatics\", \"communication\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F690\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Pragmatic concepts\",\n    \"question\": \"What is implicature?\",\n    \"answer\": \"Implied meaning beyond literal words\",\n    \"explanation\": \"What's meant vs. said. Example: 'It's cold' implies 'Close the window.'\",\n    \"difficulty\": 2,\n    \"tags\": [\"implicature\", \"pragmatics\", \"implied meaning\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F691\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Social and historical concepts\",\n    \"question\": \"What is etymology?\",\n    \"answer\": \"Study of word origins and history\",\n    \"explanation\": \"Traces word development. Example: 'television' = Greek tele (far) + Latin visio (seeing).\",\n    \"difficulty\": 1,\n    \"tags\": [\"etymology\", \"word origins\", \"history\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F692\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Social and historical concepts\",\n    \"question\": \"What is a dialect?\",\n    \"answer\": \"Regional or social language variety\",\n    \"explanation\": \"Variety by region/group. Examples: 'y'all' (Southern), 'you guys' (Midwest).\",\n    \"difficulty\": 1,\n    \"tags\": [\"dialect\", \"variation\", \"sociolinguistics\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F693\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Social and historical concepts\",\n    \"question\": \"What is an idiolect?\",\n    \"answer\": \"Individual's personal speech style\",\n    \"explanation\": \"Unique speaker patterns. Example: always saying 'you know?' after statements.\",\n    \"difficulty\": 2,\n    \"tags\": [\"idiolect\", \"individual speech\", \"sociolinguistics\", \"linguistics\"]\n  },\n  {\n    \"id\": \"F694\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Social and historical concepts\",\n    \"question\": \"What is a loanword?\",\n    \"answer\": \"Word borrowed from another language\",\n    \"explanation\": \"Adopted without translation. Examples: ballet (French), piano (Italian), algebra (Arabic).\",\n    \"difficulty\": 1,\n    \"tags\": [\"loanword\", \"borrowing\", \"etymology\", \"linguistics\"]\n  }]\n;\n});","lineCount":2660,"map":[[2660,3]],"functionMap":null},"type":"js/module"}]}