{"dependencies":[],"output":[{"data":{"code":"__d(function(global, require, _importDefaultUnused, _importAllUnused, module, exports, _dependencyMapUnused) {\n  module.exports = [\n  {\n    \"id\": \"Q101\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Clarity and Concision\",\n    \"stem\": \"Which revision improves sentence clarity?\",\n    \"options\": [\n      \"Running fast, the finish line was crossed by Maria.\",\n      \"Maria crossed the finish line quickly.\",\n      \"Maria, crossing the finish line fastly.\",\n      \"The finish line quickly was crossed Maria.\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Dangling modifier.\",\n      \"Active voice and concise phrasing.\",\n      \"Incorrect adverb form.\",\n      \"Word order is ungrammatical.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q102\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Research Evaluation\",\n    \"stem\": \"Which source is most reliable for academic research?\",\n    \"options\": [\n      \"Personal blog\",\n      \"Peer-reviewed journal article\",\n      \"Wikipedia page\",\n      \"Advertisement brochure\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Informal opinion.\",\n      \"Peer review confers credibility.\",\n      \"Editable and variable quality.\",\n      \"Promotional bias.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q103\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Theme Analysis\",\n    \"stem\": \"In 'The Great Gatsby', which theme is most prominent?\",\n    \"options\": [\n      \"The corrupting influence of wealth\",\n      \"The importance of education\",\n      \"The beauty of nature\",\n      \"The power of friendship\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Central to the novel's critique of the American Dream.\",\n      \"Not a major focus of the novel.\",\n      \"Minimal presence in the story.\",\n      \"Secondary to the main themes.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q104\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Rhetorical Devices\",\n    \"stem\": \"Which device is used in 'Ask not what your country can do for you'?\",\n    \"options\": [\n      \"Metaphor\",\n      \"Chiasmus\",\n      \"Hyperbole\",\n      \"Alliteration\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"No direct comparison is made.\",\n      \"Reversal of grammatical structures for rhetorical effect.\",\n      \"No exaggeration present.\",\n      \"Repetition of consonant sounds is minimal.\"\n    ],\n    \"difficulty\": 4,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q105\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Point of View\",\n    \"stem\": \"Which point of view allows the narrator to know all characters' thoughts?\",\n    \"options\": [\n      \"First person\",\n      \"Second person\",\n      \"Third person limited\",\n      \"Third person omniscient\"\n    ],\n    \"correctIndex\": 3,\n    \"rationales\": [\n      \"Limited to narrator's perspective.\",\n      \"Addresses the reader directly.\",\n      \"Restricted to one character's thoughts.\",\n      \"All-knowing narrator can access any character's mind.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q106\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Citation Formats\",\n    \"stem\": \"In MLA format, where does the period go in relation to the citation?\",\n    \"options\": [\n      \"Before the parenthetical citation\",\n      \"Inside the parenthetical citation\",\n      \"After the parenthetical citation\",\n      \"It doesn't matter\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Incorrect MLA format.\",\n      \"Incorrect MLA format.\",\n      \"The period always comes after the citation in MLA.\",\n      \"MLA has specific rules for punctuation.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q107\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Poetry Analysis\",\n    \"stem\": \"What is the rhyme scheme of a Shakespearean sonnet?\",\n    \"options\": [\n      \"ABAB CDCD EFEF GG\",\n      \"ABBA ABBA CDC DCD\",\n      \"AABB CCDD EEFF GG\",\n      \"ABCD ABCD EFGH IJ\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct pattern for Shakespearean/English sonnets.\",\n      \"This is a Petrarchan sonnet pattern.\",\n      \"Not a traditional sonnet form.\",\n      \"Not a recognized sonnet pattern.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q108\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Grammar Usage\",\n    \"stem\": \"Which sentence correctly uses a semicolon?\",\n    \"options\": [\n      \"I love reading; especially novels.\",\n      \"The test is tomorrow; I need to study.\",\n      \"She is smart; because she reads a lot.\",\n      \"He ran quickly; to catch the bus.\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Semicolon shouldn't separate a fragment.\",\n      \"Correctly joins two independent clauses.\",\n      \"'Because' creates a dependent clause.\",\n      \"'To catch' creates an infinitive phrase, not an independent clause.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q109\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Tone and Mood\",\n    \"stem\": \"What is the difference between tone and mood?\",\n    \"options\": [\n      \"Tone is the reader's feeling; mood is the author's attitude\",\n      \"They are the same thing\",\n      \"Tone is the author's attitude; mood is the reader's feeling\",\n      \"Tone is only in poetry; mood is only in prose\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Reversed definitions.\",\n      \"They are distinct literary concepts.\",\n      \"Tone reflects the author's perspective; mood is the emotional atmosphere created for the reader.\",\n      \"Both apply to all literary forms.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q110\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Writing Process\",\n    \"stem\": \"Which revision strategy is most effective for improving clarity?\",\n    \"options\": [\n      \"Reading your work aloud\",\n      \"Checking spelling only\",\n      \"Counting words\",\n      \"Changing font size\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Hearing the text helps identify awkward phrasing and unclear passages.\",\n      \"Spelling is important but doesn't address clarity.\",\n      \"Word count doesn't improve clarity.\",\n      \"Formatting doesn't affect content clarity.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q111\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Poetry Analysis\",\n    \"stem\": \"How many lines are in a Shakespearean sonnet?\",\n    \"options\": [\n      \"12 lines\",\n      \"14 lines\",\n      \"16 lines\",\n      \"18 lines\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Incorrect. 12 lines would be too short for the traditional sonnet structure.\",\n      \"Correct! Shakespearean sonnets always have 14 lines written in iambic pentameter.\",\n      \"Incorrect. 16 lines exceeds the traditional sonnet length.\",\n      \"Incorrect. 18 lines is too long for a sonnet.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q112\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Poetry Analysis\",\n    \"stem\": \"What's the rhyme scheme of a Shakespearean sonnet?\",\n    \"options\": [\n      \"ABBA ABBA CDC DCD\",\n      \"ABAB CDCD EFEF GG\",\n      \"AABB CCDD EEFF GG\",\n      \"ABCD ABCD EFGH IJ\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"This is the rhyme scheme of a Petrarchan (Italian) sonnet, not Shakespearean.\",\n      \"Correct! The three quatrains follow alternating rhyme (ABAB, CDCD, EFEF), ending with a rhyming couplet (GG).\",\n      \"This pattern uses only couplets, which doesn't match the Shakespearean structure.\",\n      \"This pattern has no rhyme scheme at all and isn't a traditional sonnet form.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q113\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Poetry Analysis\",\n    \"stem\": \"Where does the volta (turn in thought) typically occur in a Shakespearean sonnet?\",\n    \"options\": [\n      \"At line 5\",\n      \"At line 9 or in the final couplet (line 13)\",\n      \"At the very beginning (line 1)\",\n      \"At line 8\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Too early. Line 5 is in the middle of the second quatrain, not a typical turning point.\",\n      \"Correct! The volta usually appears at the start of the third quatrain (line 9) or in the final couplet (line 13), shifting the poem's direction or offering resolution.\",\n      \"The poem typically establishes its theme first before turning, so line 1 is too early.\",\n      \"Line 8 is more common in Petrarchan sonnets, not Shakespearean structure.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q114\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Poetry Analysis\",\n    \"stem\": \"Which of the following is a recurring theme in Shakespeare's sonnets?\",\n    \"options\": [\n      \"Space exploration and technology\",\n      \"Love, time, beauty, and mortality\",\n      \"Political revolution\",\n      \"Agricultural practices\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Anachronistic. Shakespeare lived in the late 16th/early 17th century, long before space exploration.\",\n      \"Correct! Shakespeare's sonnets deeply explore universal themes of love, the passage of time, the nature of beauty, death, and existential questions.\",\n      \"While Shakespeare wrote political plays, his sonnets focus more on personal and philosophical themes.\",\n      \"Not a central theme in Shakespeare's sonnets, which focus on human emotion and experience.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q115\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"stem\": \"What's the primary focus of phonemic awareness?\",\n    \"options\": [\n      \"Recognizing sentence rhythm\",\n      \"Recognizing individual sounds in words\",\n      \"Identifying prefixes and suffixes\",\n      \"Memorizing sight words\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Sentence rhythm relates to prosody, not phonemic awareness.\",\n      \"Correct! Phonemic awareness focuses on hearing, identifying, and manipulating individual sounds (phonemes) in spoken words.\",\n      \"Prefixes and suffixes are part of morphology, not phonemic awareness.\",\n      \"Sight word memorization is a separate literacy skill.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q116\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"stem\": \"Which skill bridges decoding and comprehension?\",\n    \"options\": [\n      \"Vocabulary development\",\n      \"Phoneme blending\",\n      \"Sight word recognition\",\n      \"Oral fluency\"\n    ],\n    \"correctIndex\": 3,\n    \"rationales\": [\n      \"While important, vocabulary is more directly related to comprehension than bridging the two.\",\n      \"Phoneme blending is a decoding skill, not a bridge between decoding and comprehension.\",\n      \"Sight words support decoding but don't bridge to comprehension.\",\n      \"Correct! Oral fluency combines accurate decoding with expression and understanding, linking both skills.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q117\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"stem\": \"What stage comes before transitional literacy?\",\n    \"options\": [\n      \"Emergent\",\n      \"Fluent\",\n      \"Early\",\n      \"Proficient\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Emergent is the first stage, coming before early, not transitional.\",\n      \"Fluent comes after transitional.\",\n      \"Correct! The progression is: Emergent → Early → Transitional → Fluent → Proficient.\",\n      \"Proficient is the final stage, after fluent.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q118\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"stem\": \"Why is morphology instruction beneficial?\",\n    \"options\": [\n      \"It improves handwriting\",\n      \"It helps infer meaning from unfamiliar words\",\n      \"It improves sentence rhythm\",\n      \"It builds phonemic awareness\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Morphology doesn't relate to handwriting (a motor skill).\",\n      \"Correct! Understanding roots, prefixes, and suffixes allows students to decode and infer meaning from new words.\",\n      \"Sentence rhythm relates to prosody, not morphology.\",\n      \"Phonemic awareness deals with sounds, not word parts.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q119\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"stem\": \"What's a key strategy for struggling readers?\",\n    \"options\": [\n      \"Reducing text exposure\",\n      \"Assigning silent reading only\",\n      \"Modeling fluent reading\",\n      \"Avoiding feedback\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Reducing exposure limits practice opportunities and slows progress.\",\n      \"Silent reading alone doesn't provide the modeling and support struggling readers need.\",\n      \"Correct! Modeling fluent reading demonstrates proper pacing, expression, and decoding strategies.\",\n      \"Feedback is essential for growth and correction of errors.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q120\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"stem\": \"What's metacognition in literacy?\",\n    \"options\": [\n      \"Memorizing definitions\",\n      \"Monitoring and adjusting one's understanding\",\n      \"Identifying literary genres\",\n      \"Copying model sentences\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Memorization is a surface-level skill, not metacognition.\",\n      \"Correct! Metacognition is thinking about one's own thinking—actively monitoring comprehension and adjusting strategies.\",\n      \"Genre identification is a separate literacy skill.\",\n      \"Copying is a mechanical task, not reflective thinking.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q121\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"stem\": \"Why is background knowledge critical for comprehension?\",\n    \"options\": [\n      \"It reduces decoding time\",\n      \"It links new information to existing schema\",\n      \"It improves phonics speed\",\n      \"It supports handwriting fluency\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Background knowledge relates to meaning-making, not decoding speed.\",\n      \"Correct! Prior knowledge connects new information to existing understanding (schema), providing context for comprehension.\",\n      \"Phonics speed is unrelated to background knowledge.\",\n      \"Handwriting is a separate motor skill.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q122\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"stem\": \"How does syntax shape meaning?\",\n    \"options\": [\n      \"Determines pronunciation\",\n      \"Influences rhythm\",\n      \"Organizes ideas and emphasis\",\n      \"Adds imagery\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Pronunciation is determined by phonology, not syntax.\",\n      \"While syntax can affect rhythm, its primary function is meaning organization.\",\n      \"Correct! Sentence structure organizes ideas, determines emphasis, and affects how information is interpreted.\",\n      \"Imagery comes from word choice (diction), not sentence structure.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q123\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"stem\": \"What's the main purpose of literacy assessment?\",\n    \"options\": [\n      \"Ranking students\",\n      \"Identifying learning needs and progress\",\n      \"Recording attendance\",\n      \"Rewarding effort\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Ranking can demotivate and doesn't guide instruction effectively.\",\n      \"Correct! Assessment diagnoses strengths and needs, guiding targeted instruction and measuring growth.\",\n      \"Attendance tracking is administrative, not instructional assessment.\",\n      \"While recognition matters, assessment's primary purpose is diagnostic and instructional.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q124\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Developmental Literacy\",\n    \"stem\": \"Which element defines fluent reading?\",\n    \"options\": [\n      \"Slow, careful decoding\",\n      \"Smooth, accurate, expressive reading\",\n      \"Memorization of every word\",\n      \"Reading silently only\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Slow, careful reading indicates developing fluency, not fluent reading.\",\n      \"Correct! Fluent reading is smooth, accurate, and expressive with appropriate pacing and prosody.\",\n      \"Fluency involves automatic decoding, not memorization of all words.\",\n      \"Fluency applies to both oral and silent reading.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q125\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Functions in Context\",\n    \"stem\": \"Which best defines language register?\",\n    \"options\": [\n      \"Vocabulary level only\",\n      \"Sentence structure\",\n      \"Level of formality for audience and purpose\",\n      \"Tone of voice\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Register involves more than just vocabulary—it includes style and formality across all language elements.\",\n      \"Sentence structure is one component but doesn't fully define register.\",\n      \"Correct! Language register is the degree of formality adjusted for specific contexts, audiences, and purposes.\",\n      \"Tone is related but distinct from register; register encompasses broader stylistic choices.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q126\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Functions in Context\",\n    \"stem\": \"What does code-switching demonstrate?\",\n    \"options\": [\n      \"Poor grammar use\",\n      \"Flexibility in language based on audience\",\n      \"Avoidance of cultural norms\",\n      \"Memorization of word roots\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Code-switching is a sophisticated linguistic skill, not poor grammar.\",\n      \"Correct! Code-switching shows linguistic flexibility and cultural awareness by adapting language to different situations and audiences.\",\n      \"Code-switching actually demonstrates awareness and respect for cultural norms.\",\n      \"Word roots relate to morphology, not code-switching.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q127\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Functions in Context\",\n    \"stem\": \"What branch of linguistics studies meaning in context?\",\n    \"options\": [\n      \"Phonology\",\n      \"Morphology\",\n      \"Pragmatics\",\n      \"Semantics\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Phonology studies sound systems in language.\",\n      \"Morphology examines word structure and formation.\",\n      \"Correct! Pragmatics analyzes how context, speaker intent, and social factors influence meaning.\",\n      \"Semantics studies meaning but doesn't emphasize context as pragmatics does.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q128\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Functions in Context\",\n    \"stem\": \"Which sentence shows positive connotation?\",\n    \"options\": [\n      \"He's cheap.\",\n      \"He's thrifty.\",\n      \"He's stingy.\",\n      \"He's miserly.\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"'Cheap' has negative connotations of low quality or excessive frugality.\",\n      \"Correct! 'Thrifty' has positive connotations of wise money management.\",\n      \"'Stingy' has negative connotations of unwillingness to spend or share.\",\n      \"'Miserly' has strongly negative connotations of excessive hoarding.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q129\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Functions in Context\",\n    \"stem\": \"Denotation refers to a word's…\",\n    \"options\": [\n      \"Historical origin\",\n      \"Literal meaning\",\n      \"Figurative association\",\n      \"Emotional tone\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Etymology studies historical origins, not denotation.\",\n      \"Correct! Denotation is the dictionary definition or literal meaning of a word.\",\n      \"Figurative associations relate to connotation, not denotation.\",\n      \"Emotional tone is part of connotation, not denotation.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q130\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Effective Communication\",\n    \"stem\": \"Which is NOT a key component of communication?\",\n    \"options\": [\n      \"Sender\",\n      \"Message\",\n      \"Grammar\",\n      \"Feedback\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"The sender initiates communication.\",\n      \"The message is the content being communicated.\",\n      \"Correct! While grammar aids clarity, it's not one of the six essential components of the communication process.\",\n      \"Feedback allows the sender to gauge message reception.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q131\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Effective Communication\",\n    \"stem\": \"Which quality ensures effective communication?\",\n    \"options\": [\n      \"Ambiguity\",\n      \"Clarity\",\n      \"Volume\",\n      \"Length\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Ambiguity obscures meaning and hinders communication.\",\n      \"Correct! Clarity ensures the message is understood as intended.\",\n      \"Volume is a delivery factor but doesn't guarantee effective communication.\",\n      \"Length doesn't ensure effectiveness; conciseness is often preferable.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q132\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Effective Communication\",\n    \"stem\": \"Tone is defined as…\",\n    \"options\": [\n      \"The emotional quality or attitude in language\",\n      \"The complexity of sentence structure\",\n      \"The literal meaning of a word\",\n      \"The rhythm of speech\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Tone reflects the speaker's or writer's attitude toward the subject and audience.\",\n      \"Sentence complexity relates to syntax, not tone.\",\n      \"Literal meaning is denotation, not tone.\",\n      \"Rhythm relates to prosody, not tone (though they can work together).\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q133\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Effective Communication\",\n    \"stem\": \"Active listening means…\",\n    \"options\": [\n      \"Hearing and ignoring irrelevant details\",\n      \"Responding thoughtfully and showing understanding\",\n      \"Taking notes only\",\n      \"Finishing sentences for the speaker\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Active listening requires engagement with all content, not selective ignoring.\",\n      \"Correct! Active listening involves full attention, comprehension, and meaningful response.\",\n      \"Note-taking is one strategy but doesn't encompass active listening.\",\n      \"Interrupting shows poor listening, not active engagement.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q134\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Effective Communication\",\n    \"stem\": \"Nonverbal cues can…\",\n    \"options\": [\n      \"Only distract from meaning\",\n      \"Reinforce or contradict verbal messages\",\n      \"Replace written communication\",\n      \"Eliminate misunderstanding entirely\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Nonverbal cues enhance and clarify, not just distract.\",\n      \"Correct! Nonverbal communication can support, emphasize, or contradict spoken words.\",\n      \"Written communication serves different purposes; nonverbal cues complement but don't replace it.\",\n      \"While helpful, nonverbal cues alone can't eliminate all misunderstanding.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q135\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Elements and Devices\",\n    \"stem\": \"Which is an example of situational irony?\",\n    \"options\": [\n      \"The reader knows the killer's identity before the detective does.\",\n      \"A fire station burns down.\",\n      \"A repeated vowel sound in poetry.\",\n      \"The moral lesson of a story.\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"This is dramatic irony, where the audience knows more than the characters.\",\n      \"Correct! Situational irony occurs when the outcome contradicts expectations—a fire station should prevent fires, not burn.\",\n      \"This describes assonance, a sound device, not irony.\",\n      \"This describes theme or moral, not irony.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q136\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Elements and Devices\",\n    \"stem\": \"Symbolism adds meaning by…\",\n    \"options\": [\n      \"Simplifying description\",\n      \"Representing abstract ideas through concrete objects\",\n      \"Listing adjectives\",\n      \"Creating suspense\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Symbolism adds complexity, not simplification.\",\n      \"Correct! Symbols use tangible objects to represent abstract concepts, adding layers of meaning.\",\n      \"Listing adjectives is descriptive technique, not symbolism.\",\n      \"While symbols can contribute to atmosphere, their primary function is representing deeper meaning.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q137\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Elements and Devices\",\n    \"stem\": \"A third-person limited narrator…\",\n    \"options\": [\n      \"Knows all characters' thoughts\",\n      \"Only knows one character's perspective\",\n      \"Uses 'you' to address the reader\",\n      \"Is part of the story's action\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Knowing all characters' thoughts describes third-person omniscient.\",\n      \"Correct! Third-person limited provides insight into one character's mind while maintaining narrative distance.\",\n      \"Using 'you' describes second-person point of view.\",\n      \"Being part of the action describes first-person narration.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q138\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Elements and Devices\",\n    \"stem\": \"Conflict in a story is…\",\n    \"options\": [\n      \"The climax\",\n      \"The struggle between opposing forces\",\n      \"The exposition\",\n      \"The resolution\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"The climax is the turning point, not the conflict itself.\",\n      \"Correct! Conflict is the central struggle driving the plot, whether internal or external.\",\n      \"Exposition provides background information.\",\n      \"Resolution shows how the conflict is settled.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q139\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Elements and Devices\",\n    \"stem\": \"Theme is best described as…\",\n    \"options\": [\n      \"The moral lesson or universal truth of the story\",\n      \"The plot's main event\",\n      \"The story's timeline\",\n      \"The setting's location\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Theme is the underlying message or insight about life that the work explores.\",\n      \"The main event is part of plot, not theme.\",\n      \"Timeline relates to plot structure.\",\n      \"Location is an element of setting, not theme.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q140\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Writing Techniques\",\n    \"stem\": \"Diction refers to…\",\n    \"options\": [\n      \"Sentence structure\",\n      \"Word choice\",\n      \"Figurative meaning\",\n      \"Dialogue pacing\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Sentence structure is syntax, not diction.\",\n      \"Correct! Diction is the writer's selection and use of specific words to create meaning and tone.\",\n      \"Figurative meaning involves literary devices like metaphor.\",\n      \"Dialogue pacing relates to narrative structure.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q141\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Writing Techniques\",\n    \"stem\": \"Which sentence best shows imagery?\",\n    \"options\": [\n      \"He walked slowly.\",\n      \"The sunlight spilled like honey across the table.\",\n      \"She moved quickly.\",\n      \"It was late.\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"This is simple description without sensory detail.\",\n      \"Correct! This creates vivid sensory experience through visual and metaphorical language.\",\n      \"This states action without engaging the senses.\",\n      \"This provides information without sensory detail.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q142\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Writing Techniques\",\n    \"stem\": \"An author's voice reflects…\",\n    \"options\": [\n      \"The plot's complexity\",\n      \"The writer's individual style and tone\",\n      \"The story's setting\",\n      \"The genre of the work\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Plot complexity is a structural choice, not voice.\",\n      \"Correct! Voice is the distinctive personality and perspective that comes through the author's stylistic choices.\",\n      \"Setting is a story element, not voice.\",\n      \"Genre is a category; voice is individual to the writer.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q143\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Writing Techniques\",\n    \"stem\": \"Syntax primarily affects…\",\n    \"options\": [\n      \"Sentence rhythm and emphasis\",\n      \"Theme development\",\n      \"Characterization\",\n      \"Symbolism\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Syntax—the arrangement of words and phrases—shapes how sentences flow and what gets emphasized.\",\n      \"Theme emerges from content and meaning, not sentence structure.\",\n      \"Characterization involves personality development, not syntax.\",\n      \"Symbolism uses objects for meaning, unrelated to syntax.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q144\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Writing Techniques\",\n    \"stem\": \"Tone in writing reveals…\",\n    \"options\": [\n      \"The author's attitude\",\n      \"The story's location\",\n      \"The text's theme\",\n      \"The rhythm of language\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Tone conveys the author's attitude toward the subject and audience through stylistic choices.\",\n      \"Location is setting, not tone.\",\n      \"Theme is the underlying message; tone is how it's expressed.\",\n      \"Rhythm relates to syntax and sound patterns.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q145\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Which best defines theme?\",\n    \"options\": [\n      \"Setting of the story\",\n      \"Sequence of events\",\n      \"Central message or universal idea\",\n      \"Character's motivation\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Setting provides the time and place, not the theme.\",\n      \"Sequence of events describes plot, not theme.\",\n      \"Correct! Theme is the underlying message or universal truth explored in the work.\",\n      \"Motivation drives character actions but isn't the theme.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q146\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Characterization is developed through…\",\n    \"options\": [\n      \"Dialogue, actions, and description\",\n      \"Setting only\",\n      \"Sentence structure\",\n      \"Theme repetition\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Authors reveal character through what characters say, do, think, and how they're described.\",\n      \"Setting provides context but doesn't develop character.\",\n      \"Sentence structure affects style, not characterization.\",\n      \"Theme repetition reinforces meaning, not character development.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q147\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Which is a recurring symbol or image that reinforces meaning?\",\n    \"options\": [\n      \"Motif\",\n      \"Plot\",\n      \"Tone\",\n      \"Foreshadowing\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! A motif is a repeated element that develops and reinforces the theme.\",\n      \"Plot is the sequence of events, not a recurring symbol.\",\n      \"Tone is the author's attitude, not a recurring element.\",\n      \"Foreshadowing hints at future events but isn't necessarily recurring.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q148\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Tone reveals the author's…\",\n    \"options\": [\n      \"Mood\",\n      \"Attitude\",\n      \"Characterization\",\n      \"Diction\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Mood is the emotional atmosphere for readers, not the author's attitude.\",\n      \"Correct! Tone expresses the author's attitude toward the subject and audience.\",\n      \"Characterization develops characters, not tone.\",\n      \"Diction (word choice) creates tone but isn't what tone reveals.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q149\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Mood affects the…\",\n    \"options\": [\n      \"Reader's emotions\",\n      \"Author's perspective\",\n      \"Character's motivation\",\n      \"Sentence rhythm\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Mood creates the emotional atmosphere that influences how readers feel.\",\n      \"Author's perspective relates to tone, not mood.\",\n      \"Character motivation drives plot, not mood.\",\n      \"Rhythm is a stylistic element, distinct from mood.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q150\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Imagery appeals to…\",\n    \"options\": [\n      \"Grammar rules\",\n      \"The five senses\",\n      \"Symbolism\",\n      \"Syntax\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Grammar provides structure, not sensory experience.\",\n      \"Correct! Imagery uses descriptive language that engages sight, sound, touch, taste, and smell.\",\n      \"Symbolism uses objects for meaning; imagery creates sensory experience.\",\n      \"Syntax is sentence structure, not sensory description.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q151\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"An allegory contains…\",\n    \"options\": [\n      \"Only figurative language\",\n      \"Both literal and symbolic meanings\",\n      \"One simple theme\",\n      \"Historical facts only\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Allegory uses multiple literary devices, not just figurative language.\",\n      \"Correct! Allegory works on two levels: the surface story and its deeper symbolic meaning.\",\n      \"Allegories often explore complex, multi-layered themes.\",\n      \"While some allegories reference history, they're primarily symbolic narratives.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q152\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Foreshadowing helps to…\",\n    \"options\": [\n      \"Create suspense and anticipation\",\n      \"Summarize past events\",\n      \"Reveal the moral\",\n      \"Confuse readers intentionally\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Foreshadowing plants clues that build anticipation for future events.\",\n      \"Summarizing past events is exposition or flashback, not foreshadowing.\",\n      \"Revealing morals is the function of theme or resolution.\",\n      \"Good foreshadowing enhances understanding, not confusion.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q153\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Conflict in literature functions to…\",\n    \"options\": [\n      \"Stall character development\",\n      \"Create action and reveal growth\",\n      \"Describe setting\",\n      \"Provide exposition\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Conflict drives development, not stalls it.\",\n      \"Correct! Conflict generates plot tension and forces characters to change and grow.\",\n      \"Setting description is separate from conflict's function.\",\n      \"Exposition provides background; conflict creates tension.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q154\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Diction influences…\",\n    \"options\": [\n      \"The story's rhyme\",\n      \"Tone and meaning\",\n      \"Theme repetition\",\n      \"Sentence count\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Rhyme relates to sound patterns in poetry, not diction's primary function.\",\n      \"Correct! Word choice (diction) shapes both the tone and the precise meaning of the text.\",\n      \"Motif creates repetition, not diction itself.\",\n      \"Sentence count is unrelated to word choice.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q155\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Which is an example of verbal irony?\",\n    \"options\": [\n      \"The opposite of what's said is meant\",\n      \"A surprise ending\",\n      \"Repetition of vowel sounds\",\n      \"A symbol representing an idea\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Verbal irony occurs when someone says the opposite of what they actually mean (like sarcasm).\",\n      \"A surprise ending may involve situational irony, not verbal.\",\n      \"Repetition of vowel sounds is assonance, a sound device.\",\n      \"This describes symbolism, not irony.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q156\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Symbolism helps readers…\",\n    \"options\": [\n      \"Understand literal events only\",\n      \"Find deeper meaning in concrete details\",\n      \"Track dialogue\",\n      \"Identify tone shifts\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Symbolism adds layers beyond literal meaning.\",\n      \"Correct! Symbols use concrete objects to represent abstract ideas and deeper themes.\",\n      \"Dialogue tracking is a separate reading skill.\",\n      \"Tone shifts are identified through diction and style changes.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q157\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"Plot is best defined as…\",\n    \"options\": [\n      \"The message of the story\",\n      \"The sequence of related events\",\n      \"The setting's location\",\n      \"The author's word choice\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"The message is theme, not plot.\",\n      \"Correct! Plot is the connected series of events that make up the narrative.\",\n      \"Location is an element of setting.\",\n      \"Word choice is diction.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q158\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Literary Analysis\",\n    \"stem\": \"The climax of a story is…\",\n    \"options\": [\n      \"The turning point or moment of greatest tension\",\n      \"The introduction\",\n      \"The falling action\",\n      \"The resolution\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! The climax is the story's peak moment where the main conflict reaches its highest intensity.\",\n      \"The introduction is the exposition, beginning the story.\",\n      \"Falling action follows the climax, leading to resolution.\",\n      \"Resolution concludes the story after the climax.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q159\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"stem\": \"Which is an example of formative assessment?\",\n    \"options\": [\n      \"Final exam\",\n      \"Weekly quiz\",\n      \"Report card grade\",\n      \"Standardized test\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Final exams are summative, measuring achievement at the end.\",\n      \"Correct! Weekly quizzes provide ongoing feedback to guide instruction during the learning process.\",\n      \"Report cards are summative evaluations.\",\n      \"Standardized tests are summative measures of overall achievement.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q160\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"stem\": \"Scaffolding helps students by…\",\n    \"options\": [\n      \"Increasing independent learning through gradual support removal\",\n      \"Assigning more homework\",\n      \"Memorizing vocabulary lists\",\n      \"Focusing on spelling drills only\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Scaffolding provides temporary support that's gradually withdrawn as students gain competence.\",\n      \"More homework doesn't necessarily provide structured support.\",\n      \"Memorization is one strategy, not scaffolding.\",\n      \"Spelling drills are specific practice, not the scaffolding concept.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q161\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"stem\": \"A rubric ensures…\",\n    \"options\": [\n      \"Subjective grading\",\n      \"Consistent and transparent evaluation\",\n      \"Faster essay grading only\",\n      \"Less teacher involvement\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Rubrics reduce subjectivity by providing clear criteria.\",\n      \"Correct! Rubrics define expectations and standards, ensuring fair and consistent assessment.\",\n      \"While rubrics may speed grading, their main purpose is consistency and clarity.\",\n      \"Rubrics require thoughtful teacher design and application.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q162\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"stem\": \"Fluency in reading includes…\",\n    \"options\": [\n      \"Memorizing text\",\n      \"Reading with accuracy, speed, and expression\",\n      \"Quiet reading only\",\n      \"Summarizing content\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Fluency involves decoding, not memorization.\",\n      \"Correct! Fluent readers demonstrate accuracy, appropriate rate, and prosody (expression).\",\n      \"Fluency applies to both oral and silent reading.\",\n      \"Summarizing demonstrates comprehension, not fluency.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q163\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"stem\": \"Which stage comes first in the writing process?\",\n    \"options\": [\n      \"Revising\",\n      \"Editing\",\n      \"Prewriting\",\n      \"Publishing\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Revising comes after drafting.\",\n      \"Editing comes near the end of the process.\",\n      \"Correct! Prewriting includes brainstorming, planning, and organizing ideas before drafting.\",\n      \"Publishing is the final stage.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q164\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"stem\": \"Metacognition involves…\",\n    \"options\": [\n      \"Word memorization\",\n      \"Monitoring one's own understanding and strategy use\",\n      \"Copying notes\",\n      \"Listening silently\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Memorization is a learning strategy, not metacognition.\",\n      \"Correct! Metacognition is awareness and regulation of one's own thinking processes.\",\n      \"Copying is a mechanical task without reflective thinking.\",\n      \"Passive listening doesn't involve metacognitive awareness.\"\n    ],\n    \"difficulty\": 3,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q165\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"stem\": \"The goal of peer review is to…\",\n    \"options\": [\n      \"Grade peers\",\n      \"Provide constructive feedback to improve writing\",\n      \"Eliminate grammar errors only\",\n      \"Replace teacher feedback\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Peers provide feedback, not grades.\",\n      \"Correct! Peer review helps writers improve through constructive, specific feedback from classmates.\",\n      \"While grammar matters, peer review addresses all aspects of writing.\",\n      \"Peer review complements, not replaces, teacher feedback.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q166\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"stem\": \"Differentiated instruction means…\",\n    \"options\": [\n      \"Teaching everyone the same way\",\n      \"Tailoring lessons to individual learning needs\",\n      \"Assigning extra credit\",\n      \"Reducing standards\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Differentiation involves varying instruction, not uniformity.\",\n      \"Correct! Differentiated instruction adjusts teaching to meet diverse student needs, interests, and readiness levels.\",\n      \"Extra credit is one strategy but doesn't define differentiation.\",\n      \"Differentiation maintains high standards while varying approaches.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q167\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"stem\": \"Summative assessments are used to…\",\n    \"options\": [\n      \"Adjust ongoing teaching\",\n      \"Provide mid-unit feedback\",\n      \"Evaluate overall achievement at the end of instruction\",\n      \"Record attendance\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Adjusting ongoing teaching is the purpose of formative assessment.\",\n      \"Mid-unit feedback is formative, not summative.\",\n      \"Correct! Summative assessments measure learning outcomes after instruction concludes.\",\n      \"Attendance tracking is administrative, not assessment.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  },\n  {\n    \"id\": \"Q168\",\n    \"subarea\": \"Skills & Processes\",\n    \"objective\": \"Teaching and Assessment\",\n    \"stem\": \"Reading conferences help teachers…\",\n    \"options\": [\n      \"Punish late readers\",\n      \"Discuss comprehension and growth individually\",\n      \"Avoid grading\",\n      \"Assign more work\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Conferences support learning, not punishment.\",\n      \"Correct! Reading conferences provide individualized assessment and goal-setting opportunities.\",\n      \"Conferences are a form of authentic assessment, not avoidance.\",\n      \"While teachers may assign work, the purpose is individualized support.\"\n    ],\n    \"difficulty\": 2,\n    \"assessment\": true\n  }\n  ,\n  {\n    \"id\": \"Q301\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Which device repeats initial consonant sounds?\",\n    \"options\": [\n      \"Assonance\",\n      \"Alliteration\",\n      \"Consonance\",\n      \"Parallelism\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Assonance repeats vowel sounds, not initial consonants.\",\n      \"Correct! Alliteration is the repetition of initial consonant sounds in neighboring words.\",\n      \"Consonance repeats consonant sounds at the end or middle of words.\",\n      \"Parallelism refers to similar grammatical structures, not sound repetition.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q302\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"The phrase 'The rain in Spain falls mainly on the plain' illustrates:\",\n    \"options\": [\n      \"Anaphora\",\n      \"Assonance\",\n      \"Metaphor\",\n      \"Juxtaposition\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Anaphora repeats words at the beginning of clauses, not vowel sounds.\",\n      \"Correct! Assonance is the repetition of vowel sounds ('ai' sound) within words.\",\n      \"This is not a metaphor; there's no comparison being made.\",\n      \"Juxtaposition places contrasting elements side by side, which isn't present here.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q303\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Repetition of consonant sounds at the ends of words is called:\",\n    \"options\": [\n      \"Chiasmus\",\n      \"Consonance\",\n      \"Alliteration\",\n      \"Antithesis\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Chiasmus is inverted parallelism, not sound repetition.\",\n      \"Correct! Consonance repeats consonant sounds at the end or middle of words.\",\n      \"Alliteration repeats initial consonant sounds, not ending sounds.\",\n      \"Antithesis contrasts ideas, not sound patterns.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q304\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Which rhetorical device repeats words at the beginning of successive clauses?\",\n    \"options\": [\n      \"Epistrophe\",\n      \"Chiasmus\",\n      \"Anaphora\",\n      \"Antithesis\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Epistrophe repeats words at the end of clauses, not the beginning.\",\n      \"Chiasmus reverses grammatical structures, not simply repeats.\",\n      \"Correct! Anaphora repeats words at the beginning of successive clauses.\",\n      \"Antithesis contrasts ideas rather than repeating words.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q305\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Repetition at the end of successive clauses is called:\",\n    \"options\": [\n      \"Anaphora\",\n      \"Epistrophe\",\n      \"Chiasmus\",\n      \"Parallelism\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Anaphora repeats at the beginning, not the end.\",\n      \"Correct! Epistrophe repeats words at the end of successive clauses.\",\n      \"Chiasmus reverses structures rather than repeating at the end.\",\n      \"Parallelism uses similar structures but doesn't specifically repeat at the end.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q306\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Which example demonstrates parallel structure?\",\n    \"options\": [\n      \"She likes reading, writing, and jogging.\",\n      \"She likes reading and to jog.\",\n      \"She likes to read and jogging.\",\n      \"She likes reading then jog.\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! All three items use the same grammatical form (gerunds).\",\n      \"Mixes gerund (reading) with infinitive (to jog) - not parallel.\",\n      \"Mixes infinitive (to read) with gerund (jogging) - not parallel.\",\n      \"Inconsistent verb forms - not parallel structure.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q307\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"'It was the best of times, it was the worst of times' illustrates:\",\n    \"options\": [\n      \"Chiasmus\",\n      \"Antithesis\",\n      \"Juxtaposition\",\n      \"Litotes\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Chiasmus involves structural reversal, not present here.\",\n      \"Correct! Antithesis places contrasting ideas (best/worst) in parallel structures.\",\n      \"While contrasting, this specifically uses parallel structure, making it antithesis.\",\n      \"Litotes affirms through negation, which isn't shown here.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q308\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"'Never let a Fool Kiss You or a Kiss Fool You' is an example of:\",\n    \"options\": [\n      \"Chiasmus\",\n      \"Antithesis\",\n      \"Parallelism\",\n      \"Synecdoche\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Chiasmus reverses the word order (Fool Kiss / Kiss Fool).\",\n      \"Antithesis contrasts ideas but doesn't reverse structures.\",\n      \"While parallel, the key feature is the reversal, making it chiasmus.\",\n      \"Synecdoche uses parts for wholes, not relevant here.\"\n    ],\n    \"difficulty\": 3\n  },\n  {\n    \"id\": \"Q309\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Which compares two unlike things directly?\",\n    \"options\": [\n      \"Simile\",\n      \"Metaphor\",\n      \"Analogy\",\n      \"Euphemism\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Similes use 'like' or 'as' for comparison, not direct.\",\n      \"Correct! Metaphors make direct comparisons without 'like' or 'as'.\",\n      \"Analogies explain relationships, not direct comparisons.\",\n      \"Euphemisms substitute mild terms, not comparisons.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q310\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"'Her eyes sparkled like diamonds' is a:\",\n    \"options\": [\n      \"Simile\",\n      \"Metaphor\",\n      \"Hyperbole\",\n      \"Euphemism\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! This uses 'like' to compare, making it a simile.\",\n      \"Metaphors don't use 'like' or 'as'.\",\n      \"While vivid, it's not an exaggeration.\",\n      \"Euphemisms soften harsh terms, not relevant here.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q311\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"'The wind whispered through the trees' uses:\",\n    \"options\": [\n      \"Irony\",\n      \"Hyperbole\",\n      \"Personification\",\n      \"Symbolism\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"No ironic contrast between expectation and reality.\",\n      \"This isn't an exaggeration.\",\n      \"Correct! Wind is given the human quality of whispering.\",\n      \"While potentially symbolic, the primary device is personification.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q312\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Which device exaggerates for emphasis?\",\n    \"options\": [\n      \"Hyperbole\",\n      \"Understatement\",\n      \"Litotes\",\n      \"Paradox\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Hyperbole deliberately exaggerates for effect.\",\n      \"Understatement minimizes, opposite of exaggeration.\",\n      \"Litotes affirms through negation, not exaggeration.\",\n      \"Paradox presents contradictions, not exaggeration.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q313\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Calling a disastrous event 'a small setback' is:\",\n    \"options\": [\n      \"Paradox\",\n      \"Understatement\",\n      \"Euphemism\",\n      \"Metonymy\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Paradox involves contradictory truths, not minimization.\",\n      \"Correct! Understatement deliberately minimizes significance.\",\n      \"While mild, understatement is more specific than euphemism here.\",\n      \"Metonymy substitutes related terms, not relevant.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q314\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"'Jumbo shrimp' is an example of:\",\n    \"options\": [\n      \"Oxymoron\",\n      \"Paradox\",\n      \"Irony\",\n      \"Synecdoche\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Oxymoron combines contradictory terms (jumbo = large, shrimp = small).\",\n      \"Paradox reveals truth through contradiction, not just word pairing.\",\n      \"While ironic, the specific device is oxymoron.\",\n      \"Synecdoche uses parts for wholes, not relevant.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q315\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"'The more you learn, the less you know' expresses:\",\n    \"options\": [\n      \"Paradox\",\n      \"Irony\",\n      \"Hyperbole\",\n      \"Chiasmus\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! This paradox seems contradictory but reveals truth about knowledge.\",\n      \"While containing irony, the primary device is paradox.\",\n      \"Not an exaggeration, but a philosophical truth.\",\n      \"Chiasmus reverses structure, not present here.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q316\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"'Let's all give him a hand' uses a part for a whole:\",\n    \"options\": [\n      \"Metonymy\",\n      \"Synecdoche\",\n      \"Euphemism\",\n      \"Personification\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Metonymy substitutes associated terms, not parts for wholes.\",\n      \"Correct! Synecdoche uses 'hand' (part) to represent applause (whole).\",\n      \"Euphemisms soften harsh terms, not relevant here.\",\n      \"Personification gives human qualities to non-humans.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q317\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"'The White House issued a statement' replaces an institution for people. This is:\",\n    \"options\": [\n      \"Synecdoche\",\n      \"Metonymy\",\n      \"Irony\",\n      \"Juxtaposition\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Synecdoche uses parts for wholes, not associations.\",\n      \"Correct! Metonymy substitutes 'White House' (place) for the President/administration.\",\n      \"No ironic contrast present.\",\n      \"Juxtaposition places contrasting elements together.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q318\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"'That's not bad at all' is an example of:\",\n    \"options\": [\n      \"Litotes\",\n      \"Euphemism\",\n      \"Understatement\",\n      \"Paradox\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Litotes affirms by denying the opposite ('not bad' = good).\",\n      \"Euphemisms soften harsh terms, not the same as negation.\",\n      \"While understated, the specific device using negation is litotes.\",\n      \"Paradox involves contradictions, not simple negation.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q319\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"A rhetorical question is used to:\",\n    \"options\": [\n      \"Solicit a response\",\n      \"Confuse the audience\",\n      \"Emphasize a point\",\n      \"Transition to a new topic\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Rhetorical questions don't expect answers.\",\n      \"They clarify rather than confuse.\",\n      \"Correct! Rhetorical questions emphasize points without expecting answers.\",\n      \"While they can transition, emphasis is the primary purpose.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q320\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"'O Death, where is thy sting?' demonstrates:\",\n    \"options\": [\n      \"Apostrophe\",\n      \"Metonymy\",\n      \"Antithesis\",\n      \"Symbolism\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Apostrophe directly addresses Death as if it were present.\",\n      \"Metonymy substitutes related terms, not direct address.\",\n      \"Antithesis contrasts ideas, not present here.\",\n      \"While Death may be symbolic, the device is apostrophe.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q321\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Placing 'love and hate' side by side for emphasis is:\",\n    \"options\": [\n      \"Juxtaposition\",\n      \"Parallelism\",\n      \"Chiasmus\",\n      \"Euphemism\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Juxtaposition places contrasting elements together for emphasis.\",\n      \"Parallelism uses similar structures, but the emphasis here is on contrast.\",\n      \"Chiasmus reverses structure, not simply contrasting.\",\n      \"Euphemisms soften harsh terms, not relevant.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q322\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"The contrast between what's expected and what occurs defines:\",\n    \"options\": [\n      \"Irony\",\n      \"Paradox\",\n      \"Hyperbole\",\n      \"Symbolism\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Irony is the contrast between expectation and reality.\",\n      \"Paradox reveals truth through seeming contradiction.\",\n      \"Hyperbole exaggerates, not about expectations.\",\n      \"Symbolism represents abstract ideas, not expectations.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q323\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"When an author repeats similar grammatical forms, they're using:\",\n    \"options\": [\n      \"Parallelism\",\n      \"Anaphora\",\n      \"Chiasmus\",\n      \"Antithesis\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Parallelism uses similar grammatical structures.\",\n      \"Anaphora specifically repeats words at the beginning, not just structure.\",\n      \"Chiasmus reverses structure rather than repeating it.\",\n      \"Antithesis contrasts ideas, not just structure.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q324\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Which device intentionally softens harsh realities?\",\n    \"options\": [\n      \"Euphemism\",\n      \"Irony\",\n      \"Paradox\",\n      \"Understatement\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Euphemisms replace harsh terms with milder alternatives.\",\n      \"Irony contrasts expectations, doesn't soften.\",\n      \"Paradox presents contradictions, doesn't soften.\",\n      \"Understatement minimizes but doesn't specifically soften harsh terms.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q325\",\n    \"subarea\": \"Genre & Craft\",\n    \"objective\": \"Rhetorical Devices and Craft Techniques\",\n    \"stem\": \"Diction contributes most directly to a text's:\",\n    \"options\": [\n      \"Setting\",\n      \"Tone\",\n      \"Theme\",\n      \"Conflict\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Setting involves time and place, not word choice.\",\n      \"Correct! Diction (word choice) directly creates and shapes tone.\",\n      \"Theme is the central idea, influenced by many elements.\",\n      \"Conflict is the struggle, not directly determined by diction.\"\n    ],\n    \"difficulty\": 1\n  }\n  ,\n  {\n    \"id\": \"Q301\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Krashen's theory stating learners need input slightly above their level is called:\",\n    \"options\": [\n      \"Input Hypothesis\",\n      \"Output Hypothesis\",\n      \"Monitor Model\",\n      \"Transfer Theory\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! The Input Hypothesis (i+1) states learners acquire language when exposed to comprehensible input just beyond their current level.\",\n      \"Output Hypothesis emphasizes language production, not input.\",\n      \"Monitor Model is Krashen's broader framework, not specifically about input levels.\",\n      \"Transfer Theory addresses L1 influence, not input complexity.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q302\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"The emotional factor that can block language learning is known as:\",\n    \"options\": [\n      \"Critical Period\",\n      \"Affective Filter\",\n      \"Natural Order\",\n      \"Code-Switching\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Critical Period refers to optimal age for language acquisition.\",\n      \"Correct! The Affective Filter represents emotional barriers (anxiety, low motivation) that prevent input from being acquired.\",\n      \"Natural Order describes the sequence of grammar acquisition.\",\n      \"Code-Switching is alternating between languages, not an emotional barrier.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q303\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Which strategy best supports students developing academic language (CALP)?\",\n    \"options\": [\n      \"Playground talk\",\n      \"Scaffolded discussion using academic vocabulary\",\n      \"Total Physical Response\",\n      \"Peer imitation\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Playground talk develops BICS, not CALP.\",\n      \"Correct! Scaffolded academic discussions with explicit vocabulary instruction build CALP.\",\n      \"TPR is effective for comprehension but doesn't target academic language specifically.\",\n      \"Peer imitation may support social language but doesn't ensure academic language development.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q304\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"A teacher gives clear examples of how to form past tense before student practice. This is:\",\n    \"options\": [\n      \"Modeling\",\n      \"Drilling\",\n      \"Code-switching\",\n      \"Translation\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Modeling demonstrates correct language use before students attempt it independently.\",\n      \"Drilling involves repetitive practice, not initial demonstration.\",\n      \"Code-switching is language alternation, not instructional demonstration.\",\n      \"Translation converts meaning between languages, not demonstrating form.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q305\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Pairing language commands with movement is part of:\",\n    \"options\": [\n      \"Silent Way\",\n      \"Direct Method\",\n      \"Total Physical Response\",\n      \"Communicative Approach\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Silent Way minimizes teacher talk, doesn't emphasize movement.\",\n      \"Direct Method uses target language only, but doesn't focus on physical response.\",\n      \"Correct! TPR uses physical actions to reinforce language meaning and comprehension.\",\n      \"Communicative Approach emphasizes interaction, not specifically movement.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q306\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Waiting several seconds before calling on ELL students improves:\",\n    \"options\": [\n      \"Grammar\",\n      \"Processing time\",\n      \"Pronunciation\",\n      \"Fluency\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Wait time doesn't directly teach grammar.\",\n      \"Correct! Wait time gives ELLs processing time to think, translate internally, and formulate responses.\",\n      \"Pronunciation requires different interventions.\",\n      \"While helpful, the primary benefit is processing time, not immediate fluency.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q307\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Basic Interpersonal Communication Skills (BICS) differ from CALP because they:\",\n    \"options\": [\n      \"Require academic vocabulary\",\n      \"Develop more slowly\",\n      \"Are used in social settings\",\n      \"Depend on grammar rules\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"BICS uses everyday vocabulary, not academic vocabulary.\",\n      \"BICS develops faster (1-2 years) than CALP (5-7 years).\",\n      \"Correct! BICS is conversational, context-embedded language used in social situations.\",\n      \"Both require grammar, but BICS is less formal and academic.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q308\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"When a Spanish-speaking student writes 'espectator' for 'spectator,' this reflects:\",\n    \"options\": [\n      \"Language transfer\",\n      \"Code-switching\",\n      \"Fossilization\",\n      \"Overgeneralization\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Language transfer occurs when L1 patterns influence L2 production (Spanish 'espectador' → 'espectator').\",\n      \"Code-switching is intentional alternation between languages, not an error.\",\n      \"Fossilization is persistent incorrect forms despite instruction.\",\n      \"Overgeneralization applies learned rules too broadly, not L1 influence.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q309\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Teachers can support second language acquisition most effectively by:\",\n    \"options\": [\n      \"Focusing only on grammar\",\n      \"Providing comprehensible input and context\",\n      \"Avoiding visuals\",\n      \"Limiting peer interaction\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Grammar focus alone doesn't ensure communicative competence.\",\n      \"Correct! Comprehensible input with rich context supports natural acquisition.\",\n      \"Visuals are essential supports for ELLs.\",\n      \"Peer interaction builds communicative competence.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q310\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Encouraging peer collaboration and discussion builds:\",\n    \"options\": [\n      \"Morphology\",\n      \"Communicative competence\",\n      \"Syntax\",\n      \"Phonemic awareness\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Morphology is word structure, not built primarily through discussion.\",\n      \"Correct! Collaboration develops the ability to use language appropriately in social contexts.\",\n      \"Syntax benefits, but communicative competence is the broader outcome.\",\n      \"Phonemic awareness involves sound manipulation, not discussion.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q311\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"An affix attached to the beginning of a word is called a:\",\n    \"options\": [\n      \"Suffix\",\n      \"Prefix\",\n      \"Root\",\n      \"Stem\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Suffixes attach at the end.\",\n      \"Correct! Prefixes attach at the beginning (un-, re-, pre-).\",\n      \"Roots are the base meaning units.\",\n      \"Stems are bases to which affixes attach.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q312\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Which term means an affix added to the end of a root?\",\n    \"options\": [\n      \"Prefix\",\n      \"Suffix\",\n      \"Inflection\",\n      \"Stem\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Prefixes attach at the beginning.\",\n      \"Correct! Suffixes attach at the end (-ness, -tion, -ly).\",\n      \"Inflection is a type of suffix, but suffix is the general term.\",\n      \"Stems are not affixes.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q313\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Which suffix changes a verb to a noun?\",\n    \"options\": [\n      \"-ize\",\n      \"-tion\",\n      \"-ful\",\n      \"-ous\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"-ize creates verbs from nouns/adjectives.\",\n      \"Correct! -tion creates nouns from verbs (act → action).\",\n      \"-ful creates adjectives from nouns.\",\n      \"-ous creates adjectives from nouns.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q314\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"The suffix '-ize' typically forms:\",\n    \"options\": [\n      \"Nouns\",\n      \"Verbs\",\n      \"Adjectives\",\n      \"Adverbs\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Nouns are formed by -tion, -ness, -ment.\",\n      \"Correct! -ize forms verbs (modern → modernize).\",\n      \"Adjectives use -ful, -ous, -able.\",\n      \"Adverbs use -ly.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q315\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"The suffix '-ous' turns a noun into an:\",\n    \"options\": [\n      \"Adjective\",\n      \"Verb\",\n      \"Adverb\",\n      \"Pronoun\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! -ous creates adjectives (danger → dangerous).\",\n      \"-ize, -en, -ify create verbs.\",\n      \"-ly typically creates adverbs.\",\n      \"Pronouns are not formed with suffixes.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q316\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Which classroom activity best supports morphological awareness?\",\n    \"options\": [\n      \"Memorizing spelling lists\",\n      \"Sorting words by affixes\",\n      \"Copying sentences\",\n      \"Reciting rhymes\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Memorization doesn't build awareness of word structure.\",\n      \"Correct! Sorting by affixes helps students analyze and understand word parts.\",\n      \"Copying doesn't emphasize morphological analysis.\",\n      \"Rhymes support phonological awareness, not morphological.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q317\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Which morpheme type changes word meaning but not grammatical role?\",\n    \"options\": [\n      \"Inflectional\",\n      \"Derivational\",\n      \"Compound\",\n      \"Bound root\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Inflectional morphemes indicate grammar (tense, number) without changing meaning.\",\n      \"Correct! Derivational morphemes create new words and meanings (happy → happiness).\",\n      \"Compounds combine two words, not morphemes.\",\n      \"Bound roots don't change meaning, they carry core meaning.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q318\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Adding '-ed' to indicate past tense is an example of a:\",\n    \"options\": [\n      \"Derivational morpheme\",\n      \"Inflectional morpheme\",\n      \"Prefix\",\n      \"Suffix root\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Derivational morphemes change word class or meaning.\",\n      \"Correct! Inflectional morphemes mark grammar (tense, number, comparison) without changing word class.\",\n      \"Prefixes attach at the beginning.\",\n      \"This is an inflectional suffix, not a root.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q319\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Students comparing English and Spanish word endings practice:\",\n    \"options\": [\n      \"Syntax\",\n      \"Metalinguistic awareness\",\n      \"Fluency\",\n      \"Phonology\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Syntax is sentence structure, not word analysis.\",\n      \"Correct! Metalinguistic awareness is consciously thinking about language structures.\",\n      \"Fluency is speed and accuracy, not language analysis.\",\n      \"Phonology is sound systems, not morphology.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q320\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"A classroom focused on conversation, gestures, and visual aids demonstrates:\",\n    \"options\": [\n      \"Grammar-Translation\",\n      \"Communicative approach\",\n      \"Audio-lingual method\",\n      \"Direct method\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Grammar-Translation emphasizes written translation and explicit grammar.\",\n      \"Correct! The Communicative approach emphasizes meaningful interaction and context.\",\n      \"Audio-lingual method focuses on drills and repetition.\",\n      \"Direct method uses target language only, without emphasizing visuals/gestures as much.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q321\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Teachers lower the affective filter by:\",\n    \"options\": [\n      \"Increasing test frequency\",\n      \"Creating a supportive environment\",\n      \"Correcting every error publicly\",\n      \"Reducing peer interaction\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Frequent testing can raise anxiety.\",\n      \"Correct! A supportive, low-anxiety environment lowers the affective filter and promotes acquisition.\",\n      \"Public correction raises anxiety.\",\n      \"Peer interaction supports language development.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q322\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Providing sentence frames such as 'I think ___ because ___' helps students:\",\n    \"options\": [\n      \"Build syntax and academic discourse\",\n      \"Practice phonics\",\n      \"Drill pronunciation\",\n      \"Avoid code-switching\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Sentence frames scaffold academic language structure and reasoning.\",\n      \"Phonics involves sound-letter relationships, not sentence structure.\",\n      \"Pronunciation is separate from sentence structure.\",\n      \"Sentence frames support language use, not eliminate code-switching.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q323\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"When teachers explicitly discuss word roots and affixes, they develop:\",\n    \"options\": [\n      \"Morphological awareness\",\n      \"Phonemic fluency\",\n      \"Syntactic transfer\",\n      \"Listening comprehension\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Discussing roots and affixes builds morphological awareness—understanding word structure.\",\n      \"Phonemic fluency involves sound manipulation, not word parts.\",\n      \"Syntactic transfer refers to sentence structure influence from L1.\",\n      \"Listening comprehension requires different strategies.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q324\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"Suffixes that form nouns often end in:\",\n    \"options\": [\n      \"-able, -ous\",\n      \"-ize, -ify\",\n      \"-ness, -tion\",\n      \"-ed, -ing\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"-able and -ous form adjectives.\",\n      \"-ize and -ify form verbs.\",\n      \"Correct! -ness and -tion are common noun-forming suffixes.\",\n      \"-ed and -ing are inflectional suffixes.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q325\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Language Development, Second Language Acquisition, and Word Formation\",\n    \"stem\": \"The best way to help ELLs develop academic vocabulary is to:\",\n    \"options\": [\n      \"Give bilingual dictionaries\",\n      \"Use context-rich content lessons\",\n      \"Simplify all reading\",\n      \"Limit talk time\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Dictionaries are helpful but don't build deep understanding.\",\n      \"Correct! Context-rich lessons provide meaningful exposure and use of academic vocabulary.\",\n      \"Simplifying prevents exposure to academic language.\",\n      \"Talk time is essential for language development.\"\n    ],\n    \"difficulty\": 2\n  }\n  ,\n  {\n    \"id\": \"Q326\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"Which era of English followed the Norman Conquest and saw major French influence?\",\n    \"options\": [\n      \"Old English\",\n      \"Middle English\",\n      \"Modern English\",\n      \"Contemporary English\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Old English (450-1100) predates the Norman Conquest.\",\n      \"Correct! Middle English (1100-1500) developed after the Norman Conquest brought French vocabulary into English.\",\n      \"Modern English came later, from 1500 onward.\",\n      \"Contemporary English is not a standard periodization term.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q327\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"Which event greatly affected vowel pronunciation between 1400–1600?\",\n    \"options\": [\n      \"The Great Schism\",\n      \"Industrial Revolution\",\n      \"Great Vowel Shift\",\n      \"Norman Conquest\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"The Great Schism was a religious division, not a linguistic change.\",\n      \"The Industrial Revolution occurred later (1760-1840) and affected society, not pronunciation.\",\n      \"Correct! The Great Vowel Shift changed how long vowels were pronounced, creating spelling-pronunciation mismatches.\",\n      \"The Norman Conquest (1066) affected vocabulary but not this specific vowel change.\"\n    ],\n    \"difficulty\": 3\n  },\n  {\n    \"id\": \"Q328\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"The Renaissance and Shakespeare contributed to the rise of:\",\n    \"options\": [\n      \"Old English\",\n      \"Early Modern English\",\n      \"Middle English\",\n      \"Contemporary English\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Old English ended around 1100 CE.\",\n      \"Correct! Early Modern English (1500-1800) includes the Renaissance, Shakespeare, and early standardization.\",\n      \"Middle English ended around 1500 CE.\",\n      \"Contemporary English came later.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q329\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"A word adopted directly from another language, such as 'ballet', is called a:\",\n    \"options\": [\n      \"Calque\",\n      \"Loanword\",\n      \"Creole\",\n      \"Derivation\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Calques translate structure, not adopt words directly.\",\n      \"Correct! A loanword is borrowed unchanged from another language (ballet, piano, café).\",\n      \"Creole is a type of language, not a borrowed word.\",\n      \"Derivation creates new words from existing roots, not borrowing.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q330\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"A word-for-word translation of a foreign phrase is known as a:\",\n    \"options\": [\n      \"Pidgin\",\n      \"Calque\",\n      \"Borrowing\",\n      \"Neologism\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Pidgin is a simplified contact language, not a translation method.\",\n      \"Correct! A calque translates the structure literally (skyscraper = gratte-ciel).\",\n      \"Borrowing is general; calque is specifically literal translation.\",\n      \"Neologism is a newly coined word.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q331\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"The study of word origins and their historical changes is called:\",\n    \"options\": [\n      \"Etymology\",\n      \"Morphology\",\n      \"Phonology\",\n      \"Syntax\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Etymology studies word origins and semantic evolution.\",\n      \"Morphology studies word structure.\",\n      \"Phonology studies sound systems.\",\n      \"Syntax studies sentence structure.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q332\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"A simplified communication system between speakers of different languages is called a:\",\n    \"options\": [\n      \"Pidgin\",\n      \"Creole\",\n      \"Dialect\",\n      \"Sociolect\"\n    ],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Pidgins are simplified contact languages with no native speakers.\",\n      \"Creoles evolve from pidgins when they gain native speakers.\",\n      \"Dialects are varieties of a single language.\",\n      \"Sociolects are social varieties.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q333\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"A stable, fully developed language that evolved from a pidgin is known as a:\",\n    \"options\": [\n      \"Dialect\",\n      \"Creole\",\n      \"Idiolect\",\n      \"Sociolect\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Dialects are regional/social varieties, not evolved pidgins.\",\n      \"Correct! Creoles develop when pidgins gain native speakers and expand grammatically.\",\n      \"Idiolects are individual speech patterns.\",\n      \"Sociolects are social group varieties.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q334\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"Which of the following best defines 'dialect'?\",\n    \"options\": [\n      \"A social language register\",\n      \"A simplified communication form\",\n      \"A regional or social language variety\",\n      \"A new language created from two others\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Register refers to formality level, not dialect.\",\n      \"This describes pidgin, not dialect.\",\n      \"Correct! Dialects are systematic regional or social varieties of a language.\",\n      \"This describes a creole or mixed language.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q335\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"An individual's unique way of speaking is referred to as their:\",\n    \"options\": [\n      \"Sociolect\",\n      \"Dialect\",\n      \"Idiolect\",\n      \"Register\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Sociolect is group-based, not individual.\",\n      \"Dialect is regional/social, not individual.\",\n      \"Correct! Idiolect is an individual's unique linguistic fingerprint.\",\n      \"Register is formality level, not individual style.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q336\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"Language associated with specific social groups or classes is called a:\",\n    \"options\": [\n      \"Pidgin\",\n      \"Sociolect\",\n      \"Dialect\",\n      \"Register\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Pidgin is a contact language, not a social variety.\",\n      \"Correct! Sociolect reflects social class, education, or group membership.\",\n      \"Dialect is regional, not specifically social.\",\n      \"Register is formality level.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q337\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"Which statement best defines slang?\",\n    \"options\": [\n      \"A fixed formal register\",\n      \"A type of professional jargon\",\n      \"Informal language used for identity or novelty\",\n      \"Words borrowed from Latin\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Slang is informal, not formal.\",\n      \"Jargon is specialized; slang is broader and more informal.\",\n      \"Correct! Slang is informal, group-specific, and evolves rapidly.\",\n      \"Latin borrowings are not necessarily slang.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q338\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"The phrase 'cool' meaning 'good' or 'stylish' is an example of:\",\n    \"options\": [\n      \"A regionalism\",\n      \"A neologism\",\n      \"Slang\",\n      \"Borrowing\"\n    ],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Not limited to one region.\",\n      \"It's not newly coined, but repurposed.\",\n      \"Correct! 'Cool' for 'good' is informal slang that emerged mid-20th century.\",\n      \"It's not borrowed from another language.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q339\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"The word 'rodeo' entered English from:\",\n    \"options\": [\n      \"German\",\n      \"Spanish\",\n      \"French\",\n      \"Italian\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"German did not contribute 'rodeo.'\",\n      \"Correct! 'Rodeo' comes from Spanish, reflecting cultural exchange in the American West.\",\n      \"Not from French.\",\n      \"Not from Italian.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q340\",\n    \"subarea\": \"Meaning & Communication\",\n    \"objective\": \"Development of English Language, Borrowings, and Regional Variation\",\n    \"stem\": \"Variation between 'pop' and 'soda' across U.S. regions demonstrates:\",\n    \"options\": [\n      \"Morphology\",\n      \"Lexical variation\",\n      \"Phonemic drift\",\n      \"Idiolect\"\n    ],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Morphology is word structure, not regional word choice.\",\n      \"Correct! Lexical variation means different words for the same thing in different regions.\",\n      \"Phonemic drift is sound change over time.\",\n      \"Idiolect is individual, not regional.\"\n    ],\n    \"difficulty\": 2\n  }\n  ,\n  {\n    \"id\": \"Q201\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Which theory emphasizes imitation and reinforcement in language learning?\",\n    \"options\": [\"Behaviorist\", \"Nativist\", \"Interactionist\", \"Cognitive\"],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Behaviorist theory (Skinner) views language as learned through imitation, practice, and reinforcement.\",\n      \"Nativist theory emphasizes innate biological capacity, not imitation.\",\n      \"Interactionist theory focuses on social interaction, not just imitation.\",\n      \"Cognitive theory links language to mental development, not conditioning.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q202\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"A child says 'I goed to the park.' This shows:\",\n    \"options\": [\"Telegraphic speech\", \"Overgeneralization\", \"Interlanguage\", \"Code-switching\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Telegraphic speech omits function words, not applies rules incorrectly.\",\n      \"Correct! Overgeneralization applies the regular past tense rule (-ed) to irregular verbs, showing rule learning.\",\n      \"Interlanguage is specific to L2 learners, not L1 development.\",\n      \"Code-switching alternates between languages, not relevant here.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q203\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Which theory claims humans are born with a Language Acquisition Device?\",\n    \"options\": [\"Interactionist\", \"Behaviorist\", \"Nativist\", \"Sociocultural\"],\n    \"correctIndex\": 2,\n    \"rationales\": [\n      \"Interactionist emphasizes social interaction, not innate devices.\",\n      \"Behaviorist focuses on learned behavior, not biological endowment.\",\n      \"Correct! Nativist theory (Chomsky) proposes an innate LAD that enables language acquisition.\",\n      \"Sociocultural emphasizes cultural context, not biological structures.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q204\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Language learning occurring through social interaction reflects:\",\n    \"options\": [\"Interactionist Theory\", \"Behaviorist Theory\", \"Cognitive Theory\", \"Innate Hypothesis\"],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Interactionist theory emphasizes that language develops through meaningful social interaction.\",\n      \"Behaviorist focuses on imitation/reinforcement, not social meaning-making.\",\n      \"Cognitive theory links language to mental development, not specifically social interaction.\",\n      \"Innate Hypothesis (nativist) emphasizes biological capacity, not interaction.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q205\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"The belief that early childhood is the most effective period for language learning supports the:\",\n    \"options\": [\"Critical Period Hypothesis\", \"Monitor Model\", \"Input Hypothesis\", \"Communicative Approach\"],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! The Critical Period Hypothesis states language acquisition is easiest during childhood before brain plasticity declines.\",\n      \"Monitor Model addresses conscious language learning, not age factors.\",\n      \"Input Hypothesis focuses on comprehensible input, not developmental timing.\",\n      \"Communicative Approach is a teaching method, not a developmental theory.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q206\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"An English learner using Spanish grammar patterns in English speech demonstrates:\",\n    \"options\": [\"Positive transfer\", \"Negative transfer\", \"Fossilization\", \"Code-mixing\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Positive transfer helps learning through similarities, not creates errors.\",\n      \"Correct! Negative transfer (interference) occurs when L1 patterns cause errors in L2.\",\n      \"Fossilization is persistent errors despite instruction, not initial transfer.\",\n      \"Code-mixing blends languages intentionally, not creates grammar errors.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q207\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"When similarities between two languages aid learning, this is:\",\n    \"options\": [\"Positive transfer\", \"Negative transfer\", \"Interlanguage\", \"Code-switching\"],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Positive transfer occurs when L1-L2 similarities facilitate learning (e.g., cognates).\",\n      \"Negative transfer causes difficulties, not aids learning.\",\n      \"Interlanguage is the learner's evolving system, not the transfer itself.\",\n      \"Code-switching alternates languages, not transfer of patterns.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q208\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"The transitional system combining elements of L1 and L2 is called:\",\n    \"options\": [\"Code-switching\", \"Interlanguage\", \"Pidgin\", \"Register\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Code-switching alternates between complete languages.\",\n      \"Correct! Interlanguage is the learner's evolving linguistic system between L1 and L2.\",\n      \"Pidgin is a contact language between groups, not individual learner language.\",\n      \"Register is formality level, not a developmental system.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q209\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Which approach emphasizes all four language domains in lessons?\",\n    \"options\": [\"Integrative Language Teaching\", \"Grammar-Translation\", \"Audio-Lingual\", \"Direct Method\"],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Integrative Language Teaching combines listening, speaking, reading, and writing in meaningful contexts.\",\n      \"Grammar-Translation focuses on written translation, not all skills.\",\n      \"Audio-Lingual emphasizes drilling and repetition, not integration.\",\n      \"Direct Method uses target language only but doesn't necessarily integrate all skills.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q210\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Students discussing solutions collaboratively to construct meaning exhibit:\",\n    \"options\": [\"Collaborative Dialogue\", \"Direct Instruction\", \"Behavioral Conditioning\", \"Drill and Practice\"],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Collaborative dialogue involves students negotiating meaning through peer interaction.\",\n      \"Direct instruction is teacher-led, not student-centered discussion.\",\n      \"Behavioral conditioning involves reinforcement, not collaborative meaning-making.\",\n      \"Drill and practice is repetitive, not collaborative or meaning-focused.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q211\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Which best describes the link between language arts and other subjects?\",\n    \"options\": [\"They are unrelated\", \"Language arts reinforce cognitive skills across subjects\", \"Math and science develop separately\", \"Reading skills hinder science vocabulary\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Language and content are deeply interconnected.\",\n      \"Correct! Language arts skills (reading, writing, discussion) support learning across all disciplines.\",\n      \"All subjects require and develop language skills.\",\n      \"Reading skills support, not hinder, content vocabulary.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q212\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Teachers promoting 'language across the curriculum' encourage:\",\n    \"options\": [\"Grammar worksheets\", \"Writing and discussion in all content areas\", \"Oral reading only in English\", \"Reducing subject vocabulary\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Grammar worksheets are isolated skill practice, not curriculum integration.\",\n      \"Correct! Language across the curriculum integrates reading, writing, and speaking into all subjects.\",\n      \"Not limited to oral reading or English class.\",\n      \"Should expand, not reduce, vocabulary across subjects.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q213\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Vygotsky's concept describing the range where learning occurs with support is:\",\n    \"options\": [\"Critical Period\", \"Zone of Proximal Development\", \"Behavioral Conditioning\", \"Interlanguage Stage\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Critical Period refers to optimal age for language acquisition.\",\n      \"Correct! ZPD is the gap between independent and supported performance where learning happens.\",\n      \"Behavioral conditioning is Skinner's concept, not Vygotsky's.\",\n      \"Interlanguage is Selinker's concept for L2 learners.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q214\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"When students apply reading comprehension strategies in history class, they demonstrate:\",\n    \"options\": [\"Interlanguage\", \"Disciplinary literacy\", \"Negative transfer\", \"Code-switching\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Interlanguage relates to L2 learning, not content literacy.\",\n      \"Correct! Disciplinary literacy applies reading/writing strategies specific to content areas.\",\n      \"Negative transfer causes errors, not strategy application.\",\n      \"Code-switching alternates languages, not applies strategies.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q215\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Which supports language acquisition through peer modeling and feedback?\",\n    \"options\": [\"Silent reading\", \"Collaborative dialogue\", \"Dictation\", \"Grammar translation\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Silent reading lacks peer interaction.\",\n      \"Correct! Collaborative dialogue promotes language through peer interaction, modeling, and feedback.\",\n      \"Dictation is teacher-directed, not peer-based.\",\n      \"Grammar translation focuses on written work, not peer communication.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q216\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"A teacher emphasizing content vocabulary like 'hypothesis' and 'variable' supports:\",\n    \"options\": [\"Academic language\", \"Informal language\", \"Dialect variation\", \"Interlanguage\"],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Academic language includes subject-specific vocabulary and formal discourse structures.\",\n      \"These are formal academic terms, not informal language.\",\n      \"Dialect variation is regional/social, not academic vocabulary.\",\n      \"Interlanguage is L2 learner language, not academic vocabulary instruction.\"\n    ],\n    \"difficulty\": 1\n  },\n  {\n    \"id\": \"Q217\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Students comparing English idioms with ones in their native language practice:\",\n    \"options\": [\"Syntax transfer\", \"Cross-linguistic connections\", \"Phonemic decoding\", \"Rote learning\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Syntax transfer relates to sentence structure, not vocabulary comparison.\",\n      \"Correct! Cross-linguistic connections leverage knowledge across languages to deepen understanding.\",\n      \"Phonemic decoding is sound-letter relationships, not idiom comparison.\",\n      \"Rote learning is memorization without understanding.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q218\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Which instructional practice best develops metacognitive reading skills?\",\n    \"options\": [\"Silent reading logs\", \"Think-aloud modeling\", \"Dictation practice\", \"Listening tests\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Silent reading logs track reading but don't model metacognition.\",\n      \"Correct! Think-aloud modeling explicitly demonstrates comprehension monitoring and strategy use.\",\n      \"Dictation doesn't develop metacognitive awareness.\",\n      \"Listening tests assess, not develop, metacognition.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q219\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"A student writes 'She no like apples.' This shows:\",\n    \"options\": [\"Code-switching\", \"Negative transfer\", \"Fossilization\", \"Overgeneralization\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Code-switching alternates complete languages, not creates errors.\",\n      \"Correct! Negative transfer from Spanish (no auxiliary verb needed) causes this English error.\",\n      \"Fossilization is persistent errors despite instruction, not initial transfer.\",\n      \"Overgeneralization applies learned rules too broadly, not L1 interference.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q220\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Integrating reading, writing, speaking, and listening into science lessons supports:\",\n    \"options\": [\"Language across the curriculum\", \"Grammar immersion\", \"Phonemic awareness\", \"Spelling transfer\"],\n    \"correctIndex\": 0,\n    \"rationales\": [\n      \"Correct! Language across the curriculum integrates literacy skills into all subject areas.\",\n      \"Grammar immersion isn't a recognized approach.\",\n      \"Phonemic awareness is specific to sound-letter relationships.\",\n      \"Spelling transfer relates to word patterns, not cross-curricular integration.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q221\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"Which describes students using both Spanish and English within a conversation?\",\n    \"options\": [\"Interlanguage\", \"Code-mixing\", \"Negative transfer\", \"Pidgin\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Interlanguage is a learner's evolving system, not mixing languages in speech.\",\n      \"Correct! Code-mixing blends elements from two languages within discourse.\",\n      \"Negative transfer causes errors, not intentional mixing.\",\n      \"Pidgin is a simplified contact language, not bilingual mixing.\"\n    ],\n    \"difficulty\": 2\n  },\n  {\n    \"id\": \"Q222\",\n    \"subarea\": \"Literature & Understanding\",\n    \"objective\": \"Language Acquisition, Transfer, and Cross-Curricular Language Development\",\n    \"stem\": \"The teacher gradually removing supports as students gain independence is:\",\n    \"options\": [\"Direct instruction\", \"Scaffolding\", \"Translation\", \"Immersion\"],\n    \"correctIndex\": 1,\n    \"rationales\": [\n      \"Direct instruction is explicit teaching, not gradual release.\",\n      \"Correct! Scaffolding provides temporary support that's gradually removed as competence grows.\",\n      \"Translation converts between languages, not provides instructional support.\",\n      \"Immersion surrounds learners with